diff --git a/src/gpu/d3d12/SDL_gpu_d3d12.c b/src/gpu/d3d12/SDL_gpu_d3d12.c
index 21050f39f..878218e50 100644
--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
+++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
@@ -5031,6 +5031,32 @@ static void D3D12_INTERNAL_BindGraphicsResources(
         D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
     }
 
+    /* MU: make sure both heaps hold every descriptor this bind can write. WriteGPUDescriptors only
+     * checks for a heap that is already full, so a table of 2 or more written at the last free slot
+     * ran past the heap's end (access violation in the driver), and a heap swapped in mid-bind left
+     * the tables set before it pointing into heaps that are no longer bound. New heaps here unbind
+     * every table, so all of them are written again. */
+    {
+        const Uint32 viewCount =
+            graphicsPipeline->header.num_vertex_samplers + graphicsPipeline->header.num_vertex_storage_textures +
+            graphicsPipeline->header.num_vertex_storage_buffers + graphicsPipeline->header.num_fragment_samplers +
+            graphicsPipeline->header.num_fragment_storage_textures + graphicsPipeline->header.num_fragment_storage_buffers;
+        const Uint32 samplerCount =
+            graphicsPipeline->header.num_vertex_samplers + graphicsPipeline->header.num_fragment_samplers;
+        const D3D12DescriptorHeap *viewHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV];
+        const D3D12DescriptorHeap *samplerHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER];
+        if (viewHeap->currentDescriptorIndex + viewCount > viewHeap->maxDescriptors ||
+            samplerHeap->currentDescriptorIndex + samplerCount > samplerHeap->maxDescriptors) {
+            D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
+            commandBuffer->needVertexSamplerBind = true;
+            commandBuffer->needVertexStorageTextureBind = true;
+            commandBuffer->needVertexStorageBufferBind = true;
+            commandBuffer->needFragmentSamplerBind = true;
+            commandBuffer->needFragmentStorageTextureBind = true;
+            commandBuffer->needFragmentStorageBufferBind = true;
+        }
+    }
+
     D3D12_CPU_DESCRIPTOR_HANDLE cpuHandles[MAX_TEXTURE_SAMPLERS_PER_STAGE];
     D3D12_GPU_DESCRIPTOR_HANDLE gpuDescriptorHandle;
     D3D12_VERTEX_BUFFER_VIEW vertexBufferViews[MAX_VERTEX_BUFFERS];
