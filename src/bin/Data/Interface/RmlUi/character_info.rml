<rml>
<head>
	<title>Character Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="character_info.rcss"/>
</head>
<body>
	<!-- The workspace slot places #panel and sets its scale and --root-scale
	     (CObject::GetPlacedDocument()); the panel lays out in reference px.

	     Text leaves render at the native text renderer's size: text_px is the physical size the
	     native client draws at for the active transform (it grows more slowly than the panel), and
	     .counter-scaled cancels #panel's scale so the glyphs are rasterised at that size instead of
	     being enlarged. Positions and box
	     widths stay in reference px; each leaf's transform-origin (character_info.rcss) keeps it
	     anchored to the edge or centre its text is aligned to. -->
	<div id="panel" data-model="character_info" data-class-adv-view="advanced_view" data-class-no-pet="!pet_enabled">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<!-- The name stands in the plate of the window's top, centred on it (character_info.rcss); a name wider
		     than the plate shrinks to it (.native-fit-small). -->
		<div class="counter-scaled" id="name" data-class-pk-0="pk_level == 0" data-class-pk-1="pk_level == 1" data-class-pk-2="pk_level == 2" data-class-pk-3="pk_level == 3" data-class-pk-4="pk_level == 4" data-class-pk-5="pk_level == 5" data-class-pk-6="pk_level >= 6" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{name_text}}</span></div>
		<!-- Class name and server name take turns in one place (CharacterInfoWindow.cpp, SubjectLineOpacity()):
		     two stacked spans, opacity-driven, never both shown at once. They centre in a box as wide as
		     #panel: counter-scaled, it must be --root-scale times wider and shifted back by half the growth
		     (character_info.rcss), or a long server name wraps instead of staying centred on one line. -->
		<span class="counter-scaled" id="classname" data-style-opacity="classname_opacity" data-style-font-size="text_px + 'px'">{{classname_text}}</span>
		<span class="counter-scaled" id="servername" data-style-opacity="servername_opacity" data-style-font-size="text_px + 'px'">{{servername_text}}</span>

		<!-- Summary backdrop: the original's 8-piece frame (RenderFrame()) -- translucent fill, 4
		     corner sprites, 1px-wide edge sprites stretched across each edge, and the separator
		     under the level line, in the original's paint order. A bordered/backgrounded leaf with child elements can render an
		     incomplete box in this RmlUi build, so every piece is its own childless sibling. -->
		<div class="summary-fill"></div>
		<div class="summary-corner corner-tl"></div>
		<div class="summary-corner corner-tr"></div>
		<div class="summary-corner corner-bl"></div>
		<div class="summary-corner corner-br"></div>
		<div class="summary-edge edge-top"></div>
		<div class="summary-edge edge-bottom"></div>
		<div class="summary-edge edge-separator"></div>
		<div class="summary-edge edge-left"></div>
		<div class="summary-edge edge-right"></div>
		<!-- Each row is a box as wide as the summary box's inside; the text in it shrinks to the box
		     when wider (.native-fit, RmlNativeTextFit.h), below the native minimum if it must
		     (.native-fit-small), so no row overlaps another or leaves the frame at any UI scale. The
		     level line and the points to spend share one row and shrink together: the level on the
		     left, the points on the right (MU Moldova's "| Resets: N" made it too long for the
		     original's fixed points column). -->
		<div class="level-row counter-scaled" data-style-font-size="text_px + 'px'"><div class="native-fit native-fit-small level-row-fit"><span class="level-text">{{level_text}}</span><span class="levelup-point-text" data-class-hidden="!can_level_up">{{levelup_point_text}}</span></div></div>
		<div class="summary-row exp-text counter-scaled" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{exp_text}}</span></div>
		<div class="summary-row point-probability-text counter-scaled" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{point_probability_text}}</span></div>
		<div class="summary-row point-text counter-scaled" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{point_text}}</span></div>

		<!-- STR row -->
		<div class="attr-textbox attr-textbox-str"></div>
		<span class="attr-label attr-label-str counter-scaled" data-class-attr-potion="str_value_source == 'potion'" data-class-attr-boosted="str_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{str_label}}</span>
		<span class="attr-value attr-value-str counter-scaled" data-class-attr-potion="str_value_source == 'potion'" data-class-attr-boosted="str_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{str_value_text}}</span>
		<div class="attr-lines attr-lines-str counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : str_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_str" class="stat-btn stat-btn-str" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(0)" data-event-mouseup="chainfo_stat_menu(0)"></div>

		<!-- AGI row -->
		<div class="attr-textbox attr-textbox-agi"></div>
		<span class="attr-label attr-label-agi counter-scaled" data-class-attr-potion="agi_value_source == 'potion'" data-class-attr-boosted="agi_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{agi_label}}</span>
		<span class="attr-value attr-value-agi counter-scaled" data-class-attr-potion="agi_value_source == 'potion'" data-class-attr-boosted="agi_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{agi_value_text}}</span>
		<div class="attr-lines attr-lines-agi counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : agi_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_agi" class="stat-btn stat-btn-agi" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(1)" data-event-mouseup="chainfo_stat_menu(1)"></div>

		<!-- VIT row -->
		<div class="attr-textbox attr-textbox-vit"></div>
		<span class="attr-label attr-label-vit counter-scaled" data-class-attr-potion="vit_value_source == 'potion'" data-class-attr-boosted="vit_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{vit_label}}</span>
		<span class="attr-value attr-value-vit counter-scaled" data-class-attr-potion="vit_value_source == 'potion'" data-class-attr-boosted="vit_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{vit_value_text}}</span>
		<div class="attr-lines attr-lines-vit counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : vit_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_vit" class="stat-btn stat-btn-vit" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(2)" data-event-mouseup="chainfo_stat_menu(2)"></div>

		<!-- ENE row -->
		<div class="attr-textbox attr-textbox-ene"></div>
		<span class="attr-label attr-label-ene counter-scaled" data-class-attr-potion="ene_value_source == 'potion'" data-class-attr-boosted="ene_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{ene_label}}</span>
		<span class="attr-value attr-value-ene counter-scaled" data-class-attr-potion="ene_value_source == 'potion'" data-class-attr-boosted="ene_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{ene_value_text}}</span>
		<div class="attr-lines attr-lines-ene counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : ene_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_ene" class="stat-btn stat-btn-ene" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(3)" data-event-mouseup="chainfo_stat_menu(3)"></div>

		<!-- CMD row -- Dark Lord only. -->
		<div class="attr-textbox attr-textbox-cmd" data-class-hidden="!show_charisma"></div>
		<span class="attr-label attr-label-cmd counter-scaled" data-class-hidden="!show_charisma" data-class-attr-potion="cmd_value_source == 'potion'" data-class-attr-boosted="cmd_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{cmd_label}}</span>
		<span class="attr-value attr-value-cmd counter-scaled" data-class-hidden="!show_charisma" data-class-attr-potion="cmd_value_source == 'potion'" data-class-attr-boosted="cmd_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{cmd_value_text}}</span>
		<div id="btn_stat_cmd" class="stat-btn stat-btn-cmd" data-class-hidden="!can_level_up || !show_charisma"
		     data-event-click="chainfo_increase_stat(4)" data-event-mouseup="chainfo_stat_menu(4)"></div>

		<!-- Advanced stats tab (MU Moldova): the fourth button shows it in place of the attribute rows (the
		     theme hides those while #panel has .adv-view). Two boxes in the summary box's own 8-piece frame; the lines come from
		     the server's /advstats (GameLogic/Character/AdvancedStats.h). -->
		<div class="adv adv-fill adv-fill-1"></div>
		<div class="adv summary-corner adv-corner-tl-1"></div>
		<div class="adv summary-corner adv-corner-tr-1"></div>
		<div class="adv summary-corner adv-corner-bl-1"></div>
		<div class="adv summary-corner adv-corner-br-1"></div>
		<div class="adv summary-edge adv-edge-top-1"></div>
		<div class="adv summary-edge adv-edge-bottom-1"></div>
		<div class="adv summary-edge adv-edge-separator-1"></div>
		<div class="adv summary-edge adv-edge-left-1"></div>
		<div class="adv summary-edge adv-edge-right-1"></div>
		<div class="adv adv-title adv-title-1 counter-scaled" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{advanced_attack_title}}</span></div>
		<div class="adv adv-lines adv-lines-1 counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : advanced_attack_lines" data-class-boosted="line.source == 'boosted'">{{line.text}}</span>
		</div>
		<div class="adv adv-fill adv-fill-2"></div>
		<div class="adv summary-corner adv-corner-tl-2"></div>
		<div class="adv summary-corner adv-corner-tr-2"></div>
		<div class="adv summary-corner adv-corner-bl-2"></div>
		<div class="adv summary-corner adv-corner-br-2"></div>
		<div class="adv summary-edge adv-edge-top-2"></div>
		<div class="adv summary-edge adv-edge-bottom-2"></div>
		<div class="adv summary-edge adv-edge-separator-2"></div>
		<div class="adv summary-edge adv-edge-left-2"></div>
		<div class="adv summary-edge adv-edge-right-2"></div>
		<div class="adv adv-title adv-title-2 counter-scaled" data-style-font-size="text_px + 'px'"><span class="native-fit native-fit-small">{{advanced_defense_title}}</span></div>
		<div class="adv adv-lines adv-lines-2 counter-scaled" data-style-font-size="text_px + 'px'">
			<span class="native-fit native-fit-small" data-for="line : advanced_defense_lines" data-class-boosted="line.source == 'boosted'">{{line.text}}</span>
		</div>

		<!-- Bottom action row: shared close button plus Quest/Pet/Master-Level/advanced stats/titles shortcuts. -->
		<div id="btn_exit" class="info-btn info-btn-exit" data-event-click="window_close" data-attr-data-hint="exit_tooltip">
			<span class="btn-exit-label">×</span>
		</div>
		<div id="btn_quest" class="info-btn info-btn-quest" data-event-click="chainfo_click_quest" data-attr-data-hint="quest_tooltip"></div>
		<div id="btn_pet" class="info-btn info-btn-pet" data-event-click="chainfo_click_pet" data-attr-data-hint="pet_tooltip"></div>
		<div id="btn_masterlevel" class="info-btn info-btn-masterlevel" data-class-locked="!master_level_enabled"
		     data-event-click="chainfo_click_masterlevel" data-attr-data-hint="masterlevel_tooltip"></div>
		<div id="btn_advstats" class="info-btn info-btn-advstats" data-event-click="chainfo_click_advstats"
		     data-attr-data-hint="advstats_tooltip"></div>
		<div id="btn_titles" class="info-btn info-btn-titles" data-event-click="chainfo_click_titles"
		     data-attr-data-hint="titles_tooltip"></div>
		<div id="frame_corner_close" data-event-click="window_close"></div>
	</div>
</body>
</rml>
