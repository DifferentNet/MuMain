<rml>
	<!-- bound-geometry: panel and well heights follow the user resize, in dp -->
	<!-- rml-contract-optional-callback: chat_lines_tap: only the legacy theme (the phone view) has the finger tap on a chat line that whispers to its sender -->
<head>
	<title>Chat Log</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="chat_log.rcss"/>
</head>
<body class="native-text" data-model="chat_log">
	<!-- Bottom-left HUD panel, anchored above the chat input box. Sized in dp like its already-
	     ported HUD siblings (buff_strip, mu_helper_bar), not via a root-transform scale: this tier
	     has no live-3D content to paint behind, so nothing forces the px + transform:scale pattern
	     the inventory family needs.

	     #lines carries base.rcss's .scroll-pane, so RmlUi owns the scroll position, the wheel and
	     the scrollbar drag. C++ keeps the message vectors and only pins the view to the bottom on
	     a new message (CChatLogWindow::SyncRmlModel). -->
	<div id="panel" data-class-framed="show_frame" data-style-height="panel_height + 'dp'">
		<!-- Drag to resize in 3-line steps; only exists with the frame shown, matching native. -->
		<div id="chat_backdrop" data-style-opacity="back_alpha"></div>
		<div id="resize_handle" data-class-hidden="!show_frame"
		     data-event-drag="chat_resize_drag"></div>

		<div id="lines" class="scroll-pane" data-style-height="client_height + 'dp'">
			<!-- One data-class per class, no data-attr-class: a class attribute set from data would
			     drop the data-class ones, and one composed string re-ran for every line whenever
			     the pointed line moved. `kind` is the
			     lowercase message-type slug C++ pushes (chat/whisper/party/...), and `has-id`
			     marks a line whose sender can be right-clicked to target a whisper.

			     No event binding and no :hover: these lines are pointer-events:none so world
			     clicks pass through the chat window the way they did natively, which also means
			     they never receive mouse events at all. C++ resolves both the pointed line and
			     the right-click itself (CChatLogWindow::UpdatePointedLine).

			     MU Moldova: `faded` is a line a closed chat has let go after 30 s (UI/Chat/ChatFade.h);
			     it stays in the list so indices still match, but takes no space. `lead` is the first
			     line on screen, which carries the bottom-up stacking margin.

			     MU Moldova, items in the chat (UI/Chat/ItemLinks.h): a line that shows items leaves `text`
			     empty and comes as `segs`, plain pieces and each item's [name] (.chat-link--<rarity>; its
			     `link` attribute is what CChatLogWindow::LinkAt() finds it by). Nothing between the parts:
			     a space there would show. -->
			<div data-for="line : lines"
			     class="chat-line"
			     data-class-chat-line--chat="line.kind == 'chat'"
			     data-class-chat-line--whisper="line.kind == 'whisper'"
			     data-class-chat-line--system="line.kind == 'system'"
			     data-class-chat-line--error="line.kind == 'error'"
			     data-class-chat-line--party="line.kind == 'party'"
			     data-class-chat-line--guild="line.kind == 'guild'"
			     data-class-chat-line--union="line.kind == 'union'"
			     data-class-chat-line--gens="line.kind == 'gens'"
			     data-class-chat-line--gm="line.kind == 'gm'"
			     data-class-chat-line--has-id="line.has_id"
			     data-class-chat-line--pointed="it_index == pointed_index"
			     data-class-chat-line--faded="line.faded"
			     data-class-chat-line--lead="line.lead">{{line.text}}<span data-for="seg : line.segs"
				       data-class-chat-link="seg.link >= 0"
				       data-class-chat-link--normal="seg.rarity == 'normal'"
				       data-class-chat-link--high="seg.rarity == 'high'"
				       data-class-chat-link--excellent="seg.rarity == 'excellent'"
				       data-class-chat-link--socket="seg.rarity == 'socket'"
				       data-class-chat-link--ancient="seg.rarity == 'ancient'"
				       data-attr-link="seg.link">{{seg.text}}</span></div>
			<!-- MU Skynet: two rows that are never drawn and take no room, as wide as a row's text may be (the
			     framed scrollbar's width kept free, chat_log.rcss). A message is measured in their font when it
			     comes and split into as many rows as it needs (CChatLogWindow::SplitIntoRows()); the GM one is
			     bold. After the lines, so a line's place among the children stays its index in the model. -->
			<div id="line_probe" class="chat-line chat-line--chat chat-line-probe"></div>
			<div id="line_probe_gm" class="chat-line chat-line--gm chat-line-probe"></div>
		</div>
	</div>
</body>
</rml>
