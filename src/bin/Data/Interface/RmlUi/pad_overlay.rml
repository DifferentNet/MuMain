<rml>
<head>
	<title>Pad Overlay</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="gamepad_glyphs.rcss"/>
	<link type="text/rcss" href="pad_overlay.rcss"/>
</head>
<body class="pad" data-model="pad_overlay">
	<!-- What the gamepad shows over the world and its windows (UI/HUD/PadOverlay.cpp): the frame
	     on the cell or button the pad is on (UI/HUD/PadFrame), the hero hub's tabs with what the
	     pad's buttons do in a window (UI/HUD/PadHub), and over the drop d-pad down would pick up, a
	     prompt to do it. Only the pad works it: nothing here takes the pointer. -->
	<!-- bound-geometry: the frame is the box of the target the pad is on, the prompt sits under a drop's projected point. -->
	<div id="po_frame" data-if="frame_shown" data-style-left="frame_left" data-style-top="frame_top"
	     data-style-width="frame_width" data-style-height="frame_height"></div>
	<div id="po_prompt" data-if="prompt_shown" data-style-left="prompt_left" data-style-top="prompt_top">
		<div id="po_prompt_inner">
			<div class="pad-glyph pad-dpad pad-dpad-down"><div class="pad-dpad-v"></div><div class="pad-dpad-h"></div><div class="pad-dpad-lit"></div></div>
			<div class="po-label">{{pickup_label}}</div>
		</div>
	</div>
	<div id="po_top" data-if="hub_open || legend_shown" data-style-right="top_right">
		<div id="po_tabs" data-if="hub_open">
			<div class="pad-glyph pad-bumper">LB</div>
			<div class="po-tab" data-for="tab : tabs" data-class-active="tab.active">{{tab.label}}</div>
			<div class="pad-glyph pad-bumper">RB</div>
		</div>
		<div id="po_legend" data-if="legend_shown">
			<div class="pad-glyph pad-face pad-a" data-if="legend_a">A</div><div class="po-label" data-if="legend_a">{{take_label}}</div>
			<div class="pad-glyph pad-face pad-x" data-if="legend_item">X</div><div class="po-label" data-if="legend_item">{{equip_label}}</div>
			<div class="pad-glyph pad-face pad-y" data-if="legend_y">Y</div><div class="po-label" data-if="legend_y">{{card_label}}</div>
			<div class="pad-glyph pad-face pad-b">B</div><div class="po-label">{{close_label}}</div>
			<div class="pad-glyph pad-round pad-menu"><div class="pad-menu-line pad-menu-line-1"></div><div class="pad-menu-line pad-menu-line-2"></div><div class="pad-menu-line pad-menu-line-3"></div></div><div class="po-label">{{windows_label}}</div>
		</div>
	</div>
</body>
</rml>
