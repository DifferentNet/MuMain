/* Legacy theme for the character-creation dialog (CCharMakeWin) -- only idle/checked button
   frames are reproduced. Stat/description panels were flat CSprite fills originally, so they're
   plain background-color here too. */

@spritesheet charmake-input-sheet
{
	src: "../../../cha_id.tga";
	charmake-input-image: 0px 0px 346px 38px;
}
@spritesheet charmake-job-sheet
{
	src: "../../../cha_bt.tga";
	charmake-job-unchecked: 0px 0px 108px 26px;
	charmake-job-checked:   0px 78px 108px 26px;
}
@spritesheet charmake-ok-sheet
{
	src: "../../../message_ok_b_all.tga";
	charmake-ok-idle: 0px 0px 54px 30px;
}
@spritesheet charmake-cancel-sheet
{
	src: "../../../loding_cancel_b_all.tga";
	charmake-cancel-idle: 0px 0px 54px 30px;
}

/* Static RCSS instead of C++-pushed for width/height and most children (except #panel's own
   left/top, and job buttons which are per-instance data). Deliberately px, not dp -- this panel's
   screen position also drives the live 3D character-preview viewport, a separate scale
   mechanism. Every length is the original's px times --layout-pixel (1 on the desktop, the page's
   pixel density in the browser), so the panel keeps its size and gets sharper on a high-density
   screen; the preview renders at #preview's own size, so it follows. */
#panel {
	position: absolute;
	width: calc(454px * var(--layout-pixel, 1));
	height: calc(406px * var(--layout-pixel, 1));
	font-family: "token(font-body)";
	font-size: calc(12px * var(--layout-pixel, 1));
	color: token(text-primary);
}

/* The original's dimming sprite: black at half opacity over the whole scene. */
#backdrop { background-color: rgba(0, 0, 0, 128); }

/* The 3D preview's viewport, under every other child of the panel. */
#preview { position: absolute; left: 0px; top: 0px; width: calc(410px * var(--layout-pixel, 1)); height: calc(335px * var(--layout-pixel, 1)); }
#preview.awaiting-frame { visibility: hidden; }

#stat_panel  { left: calc(346px * var(--layout-pixel, 1)); top: calc(24px * var(--layout-pixel, 1));  }
#desc_panel  { left: 0px;   top: calc(355px * var(--layout-pixel, 1)); }
#input_frame { left: 0px;   top: calc(317px * var(--layout-pixel, 1)); }
#btn_ok      { left: calc(346px * var(--layout-pixel, 1)); top: calc(325px * var(--layout-pixel, 1)); }
#btn_cancel  { left: calc(400px * var(--layout-pixel, 1)); top: calc(325px * var(--layout-pixel, 1)); }

.job-btn {
	position: absolute;
	width: calc(108px * var(--layout-pixel, 1));
	height: calc(26px * var(--layout-pixel, 1));
	text-align: center;
	vertical-align: middle;
	line-height: calc(26px * var(--layout-pixel, 1));
	cursor: pointer;
	pointer-events: auto;
	decorator: image(charmake-job-unchecked);
	color: token(text-dim);
}
/* Every job button sits in one column; the tops are the original's own, in CLASS_* order:
   wizard/knight/elf/summoner run at a 26px pitch, then a gap, then rage-fighter/dark/dark-lord. */
.job-btn { left: calc(346px * var(--layout-pixel, 1)); }
.job-btn[job="wizard"]       { top: calc(131px * var(--layout-pixel, 1)); }
.job-btn[job="knight"]       { top: calc(157px * var(--layout-pixel, 1)); }
.job-btn[job="elf"]          { top: calc(183px * var(--layout-pixel, 1)); }
.job-btn[job="summoner"]     { top: calc(209px * var(--layout-pixel, 1)); }
.job-btn[job="rage-fighter"] { top: calc(246px * var(--layout-pixel, 1)); }
.job-btn[job="dark"]         { top: calc(272px * var(--layout-pixel, 1)); }
.job-btn[job="dark-lord"]    { top: calc(298px * var(--layout-pixel, 1)); }
.job-btn.checked {
	decorator: image(charmake-job-checked);
	color: token(text-primary);
}
.job-btn.disabled {
	pointer-events: none;
	color: token(text-disabled);
	cursor: default;
}

.stat-panel, .desc-panel {
	position: absolute;
}
.stat-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: calc(108px * var(--layout-pixel, 1));
	height: calc(80px * var(--layout-pixel, 1));
	background-color: token(surface-overlay);
}
.stat-bg.tall {
	height: calc(96px * var(--layout-pixel, 1));
}
.desc-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: calc(454px * var(--layout-pixel, 1));
	height: calc(51px * var(--layout-pixel, 1));
	background-color: token(surface-overlay);
}

.stat-row {
	position: absolute;
	left: calc(22px * var(--layout-pixel, 1));
}
.stat-label {
	color: token(text-primary);
}
.stat-value {
	position: absolute;
	left: calc(54px * var(--layout-pixel, 1));
	color: #ffb400;
}

/* modern-only class-name title above the two description lines -- legacy's description panel
   never had one. */
.desc-title {
	display: none;
}
.desc-line {
	position: absolute;
	left: calc(10px * var(--layout-pixel, 1));
	white-space: nowrap;
}
/* Exact original inline top:...px values for these two lines, moved to per-line classes so modern
   can add .desc-title above without shifting legacy's own offsets. */
.desc-line-1 { top: calc(12px * var(--layout-pixel, 1)); }
.desc-line-2 { top: calc(31px * var(--layout-pixel, 1)); }

.input-frame {
	position: absolute;
	width: calc(346px * var(--layout-pixel, 1));
	height: calc(38px * var(--layout-pixel, 1));
	decorator: image(charmake-input-image);
	pointer-events: none;
}

/* Real legacy screen has no separate label element -- cha_id.tga's own baked art already shows
   one as part of the single wide sprite above. */
.input-label {
	display: none;
}

/* modern-only decorative backdrops/kickers (char_make.rml's own comment) -- real legacy sprite art
   already gives every element its own visual identity, no artificial backing panel needed. */
.side-panel, .panel-kicker {
	display: none;
}

/* Name field: placement/size only -- appearance comes from base.rcss's shared .text-field, with the
   fill/border dropped here because cha_id.tga's own baked art (#input_frame above) already provides
   them. Box matches where the native CUITextInputBox sat: the old kInputTextOffsetX=78/
   kInputTextOffsetY=21 (relative to kInputSpriteOffsetY=317) origin at its Init()'d 200x20 size.
   Text colour matches the old Configure({textR 255, textG 230, textB 210}). */
.char-make-name-field {
	position: absolute;
	left: calc(78px * var(--layout-pixel, 1));
	top: calc(338px * var(--layout-pixel, 1));
	width: calc(200px * var(--layout-pixel, 1));
	height: calc(20px * var(--layout-pixel, 1));
	padding: 0;
	color: token(text-narrative);
	background-color: transparent;
	border-width: 0;
}

.btn {
	position: absolute;
	width: calc(54px * var(--layout-pixel, 1));
	height: calc(30px * var(--layout-pixel, 1));
	text-align: center;
	vertical-align: middle;
	line-height: calc(30px * var(--layout-pixel, 1));
	cursor: pointer;
	pointer-events: auto;
	/* Real sprite art already renders OK/Cancel text -- hide the bound label text behind it
	   (color:transparent); line-height/text-align/vertical-align set explicitly rather than
	   relying on inheritance from base.rcss's .btn. */
	color: transparent;
}
.btn-ok {
	decorator: image(charmake-ok-idle);
}
.btn-cancel {
	decorator: image(charmake-cancel-idle);
}

/* The stat rows' own places, so a theme can move them -- they were style attributes, which are
   inline properties no theme can override. */
.stat-row-0 { top: calc(10px * var(--layout-pixel, 1)); }
.stat-row-1 { top: calc(27px * var(--layout-pixel, 1)); }
.stat-row-2 { top: calc(44px * var(--layout-pixel, 1)); }
.stat-row-3 { top: calc(61px * var(--layout-pixel, 1)); }
.stat-row-4 { top: calc(78px * var(--layout-pixel, 1)); }
