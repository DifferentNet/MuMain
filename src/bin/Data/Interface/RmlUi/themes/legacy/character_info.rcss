/* Legacy theme for CCharacterInfoWindow -- a plain CManager-tier window (no C3DRenderMng, no
   live-3D icon, no CUITextInputBox), so unlike the inventory family it needed no background-
   context split: 100% of its chrome/text/buttons move straight to #panel's own foreground
   document. #panel's frame (fill/top/left/right/bottom sprites, exit button) is
   shared with my_quest_info/pet_info/party_info via docked_panel_frame.rcss (linked below) -- only
   window-specific content lives here now. Coordinates below are plain reference px, not dp, same
   convention as my_quest_info.rcss.

   The summary box reproduces RenderFrame()'s 8-piece frame: the original tiles a 1px-wide (or
   1px-tall) edge sprite once per pixel along each edge; every tile is identical, so stretching the
   same sprite across the edge is pixel-equivalent. It keeps its own local corner/fill classes
   rather than docked_panel_frame.rcss's shared .gbox-* ones -- only the corner sprites themselves
   (docked-corner-tl/tr/bl/br) come from the partial.

   Text leaves are sized at the native text renderer's physical size and counter-scaled out of
   #panel's transform from the RML (see character_info.rml's header comment), so no rule here sets
   a text font-size; transform-origin anchors each leaf to its text alignment.

   Attribute extra-line blocks (str/agi/vit/ene) use normal block flow (each line a
   display:block span, line-height 13px) instead of individually positioned lines: the original
   (RenderAttribute()) stacks a variable number of lines per block depending on class/buff state
   at a constant +13px step, which block flow reproduces for free without hand-computing each
   line's own top offset in C++. */
@spritesheet chainfo-textbox-sheet { src: "../../../newui_cha_textbox02.tga"; chainfo-textbox: 0px 0px 170px 21px; }
@spritesheet chainfo-stat-btn-sheet { src: "../../../newui_chainfo_btn_level.tga"; chainfo-stat-btn: 0px 0px 16px 15px; }
@spritesheet chainfo-btn-quest-sheet { src: "../../../newui_chainfo_btn_quest.tga"; chainfo-btn-quest: 0px 0px 36px 29px; }
@spritesheet chainfo-btn-pet-sheet { src: "../../../newui_chainfo_btn_pet.tga"; chainfo-btn-pet: 0px 0px 36px 29px; }
@spritesheet chainfo-btn-masterlevel-sheet { src: "../../../newui_chainfo_btn_master.tga"; chainfo-btn-masterlevel: 0px 0px 36px 29px; }

/* The window's top is newui_item_back04 with a name plate in the frame's manner where the original had a flat
   black box behind the name (tools/chainfo_name_plate.py, MU Skynet 2026-10-29). The other windows on back04 keep
   it as it was. */
@spritesheet chainfo-top-sheet { src: "../../../newui_chainfo_top.tga"; chainfo-top: 0px 0px 190px 64px; }
.frame-top { decorator: image(chainfo-top); }

/* Right-hand pieces and the action row are pinned to #panel's edges (the original's places in a
   190x429 panel), so they follow a wider or filled panel; the content stays at the top. */

#name, #classname, #servername {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	transform-origin: center top;
	font-weight: bold;
	pointer-events: none;
}
#classname, #servername { top: 27px; color: token(text-primary); }

@spritesheet chainfo-table-top-sheet    { src: "../../../newui_item_table03(Up).tga"; chainfo-table-top:    0px 0px 1px 14px; }
@spritesheet chainfo-table-bottom-sheet { src: "../../../newui_item_table03(Dw).tga"; chainfo-table-bottom: 0px 0px 1px 14px; }
@spritesheet chainfo-table-left-sheet   { src: "../../../newui_item_table03(L).tga";  chainfo-table-left:   0px 0px 14px 1px; }
@spritesheet chainfo-table-right-sheet  { src: "../../../newui_item_table03(R).tga";  chainfo-table-right:  0px 0px 14px 1px; }

.summary-fill {
	position: absolute;
	left: 12px;
	right: 18px;
	top: 48px;
	height: 66px;
	background-color: rgba(0, 0, 0, 77);
	pointer-events: none;
}
.summary-corner { position: absolute; width: 14px; height: 14px; pointer-events: none; }
.corner-tl { left: 12px;  top: 48px; decorator: image(docked-corner-tl); }
.corner-tr { right: 13px; top: 48px; decorator: image(docked-corner-tr); }
.corner-bl { left: 12px;  top: 105px; decorator: image(docked-corner-bl); }
.corner-br { right: 13px; top: 105px; decorator: image(docked-corner-br); }

/* Edge spans are RenderFrame()'s loop bounds: x 26..163 for top/bottom, 14..173 for the separator
   under the level line, y 62..105 for left/right. */
.summary-edge { position: absolute; pointer-events: none; }
.edge-top       { left: 26px;  right: 27px; top: 48px;  height: 14px; decorator: image(chainfo-table-top); }
.edge-bottom    { left: 26px;  right: 27px; top: 105px; height: 14px; decorator: image(chainfo-table-bottom); }
.edge-separator { left: 14px;  right: 17px; top: 60px;  height: 14px; decorator: image(chainfo-table-bottom); }
.edge-left      { left: 12px;  top: 62px;  width: 14px;  height: 43px; decorator: image(chainfo-table-left); }
.edge-right     { right: 13px; top: 62px;  width: 14px;  height: 43px; decorator: image(chainfo-table-right); }

/* Each row is a box from 18 to 170, the summary box's inside; its text shrinks to it when wider
   (character_info.rml). The level row lays the level out on the left and the points to spend on
   the right; when even the smallest size is too wide, the level is cut at the points instead of
   running under them. */
.level-row, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	left: 18px;
	transform-origin: left top;
	white-space: nowrap;
	pointer-events: none;
}
.level-row { top: 58px; font-weight: bold; }
.level-row .level-row-fit { display: flex; flex-direction: row; justify-content: space-between; }
.level-text { flex: 0 1 auto; overflow: hidden; color: #e6e600; }
.levelup-point-text { flex: 0 0 auto; color: #ff8a00; }
.exp-text { top: 75px; color: token(text-primary); }
.point-probability-text { top: 88px; color: #4cc5fe; }
.point-text { top: 101px; color: #4cc5fe; }

/* Attribute rows: textbox background (170x21) + centered label/value halves + a variable-length
   block of extra derived-stat lines below. HEIGHT_STRENGTH/DEXTERITY/VITALITY/ENERGY/CHARISMA
   (CharacterInfoWindow.h) are 120/175/240/295/350. */
.attr-textbox {
	position: absolute;
	left: 11px;
	right: 9px;
	height: 21px;
	decorator: image(chainfo-textbox);
	pointer-events: none;
}
.attr-textbox-str { top: 120px; }
.attr-textbox-agi { top: 175px; }
.attr-textbox-vit { top: 240px; }
.attr-textbox-ene { top: 295px; }
.attr-textbox-cmd { top: 350px; }

/* Label and value share the value's color, as RenderAttribute() set one color for both. */
.attr-label, .attr-value {
	display: block;
	position: absolute;
	text-align: center;
	transform-origin: center top;
	font-weight: bold;
	pointer-events: none;
}
.attr-label { left: 12px; width: 74px; color: rgb(230, 230, 0); }
.attr-value { left: 86px; right: 18px; color: rgb(230, 230, 0); }
.attr-label-str, .attr-value-str { top: 126px; }
.attr-label-agi, .attr-value-agi { top: 181px; }
.attr-label-vit, .attr-value-vit { top: 246px; }
.attr-label-ene, .attr-value-ene { top: 301px; }
.attr-label-cmd, .attr-value-cmd { top: 356px; }

/* Extra derived-stat lines: normal block flow, one span per line with a fixed 13 reference px row
   height (bound in the RML, since the block is counter-scaled) -- reproduces RenderAttribute()'s
   iY += 13 stacking without per-line C++ offsets (see header comment). A row height rather than a
   line-height keeps each glyph at the top of its row, where the original drew it; line-height
   would split the extra space above and below the text. Left/top per block match the original's
   own RenderText() call sites. */
.attr-lines { position: absolute; transform-origin: left top; pointer-events: none; }
.attr-lines span { display: block; white-space: nowrap; }
.attr-lines-str { left: 20px; top: 145px; }
.attr-lines-agi { left: 20px; top: 199px; }
.attr-lines-vit { left: 20px; top: 264px; }
.attr-lines-ene { left: 18px; top: 319px; }

.stat-btn {
	position: absolute;
	right: 14px;
	width: 16px;
	height: 15px;
	decorator: image(chainfo-stat-btn);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:hover { filter: brightness(1.25); }
.stat-btn-str { top: 122px; }
.stat-btn-agi { top: 177px; }
.stat-btn-vit { top: 242px; }
.stat-btn-ene { top: 297px; }
.stat-btn-cmd { top: 352px; }

/* Exit is fully shared now (docked_panel_frame.rcss's #btn_exit) -- only Quest/Pet/MasterLevel
   (this window's own extra shortcuts, not part of the shared frame) stay local. */
.info-btn {
	position: absolute;
	bottom: 8px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.info-btn:hover { filter: brightness(1.25); }
.info-btn.locked { filter: brightness(0.6); }
.info-btn-quest { left: 50px; decorator: image(chainfo-btn-quest); }
.info-btn-pet { left: 87px; decorator: image(chainfo-btn-pet); }
.info-btn-masterlevel { left: 124px; decorator: image(chainfo-btn-masterlevel); }

/* Exit's sprite already has its own "X" baked in -- the shared label span is redundant here,
   same convention as my_quest_info.rcss. */
.btn-exit-label { display: none; }

/* data-class-hidden on display:block leaves: base.rcss's .hidden has the same specificity as the
   leaf rules above and loses to them, so it is repeated here with the leaf class. */
.levelup-point-text.hidden, .attr-label.hidden, .attr-value.hidden { display: none; }

/* Outlaw level, from the model's pk_level -- the original's UI::Chat::SetPlayerColor() palette,
   which used to arrive as a colour string C++ built. #name's own colour is the fallback. */
#name.pk-0 { color: rgb(150, 255, 240); }
#name.pk-1 { color: rgb(100, 120, 255); }
#name.pk-2 { color: rgb(140, 180, 255); }
#name.pk-3 { color: rgb(200, 220, 255); }
#name.pk-4 { color: rgb(255, 150, 60); }
#name.pk-5 { color: rgb(255, 80, 30); }
#name.pk-6 { color: rgb(255, 0, 0); }

/* Where an attribute's total comes from, from the model's *_value_source. The original coloured
   the value for each of the three; the base colour lives on .attr-value/.attr-label above. */
.attr-value.attr-boosted, .attr-label.attr-boosted { color: rgb(100, 150, 255); }
.attr-value.attr-potion,  .attr-label.attr-potion  { color: rgb(255, 120, 0); }

/* A derived row's own state: RenderAttribute() gave an item or set the same pale blue the primary
   stats use, and a consumable buff its own colour. */
.attr-lines span { color: #ffffff; }
.attr-lines span.boosted { color: rgb(100, 150, 255); }
.attr-lines span.buffed { color: rgb(255, 0, 240); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
/* The name stands in the plate of the window's top (newui_chainfo_top: x 55-133, y 12-26) between the inner tips
   of its end studs, from 59 to 129 of 190 (in % so it follows the plate when a theme fills a wider panel), its
   middle on the plate's middle at any panel scale (translateY(-50%), as .sharp-middle in base.rcss); a longer name
   shrinks to that box (character_info.rml), so even ten W's fit at 800x600. */
#name {
	left: 31.0526%;
	top: 19px;
	width: calc(36.8421% * var(--root-scale));
	transform-origin: left center;
	transform: translateY(-50%) scale(calc(1 / var(--root-scale, 1)));
}
#classname { width: calc(100% * var(--root-scale)); margin-left: calc(50% - 50% * var(--root-scale)); }
#servername { width: calc(100% * var(--root-scale)); margin-left: calc(50% - 50% * var(--root-scale)); }
.level-row { width: calc(152px * var(--root-scale)); }
.exp-text, .point-probability-text, .point-text { width: calc(152px * var(--root-scale)); }
.levelup-point-text { margin-left: calc(6px * var(--root-scale)); }
/* The extra lines and the advanced stats end at 170 too, inside the frame's right edge, and shrink
   to it (character_info.rml). */
.attr-lines.attr-lines-str { width: calc(150px * var(--root-scale)); }
.attr-lines.attr-lines-agi { width: calc(150px * var(--root-scale)); }
.attr-lines.attr-lines-vit { width: calc(150px * var(--root-scale)); }
.attr-lines.attr-lines-ene { width: calc(152px * var(--root-scale)); }
.attr-lines.attr-lines-str span { height: calc(13px * var(--root-scale)); }
.attr-lines.attr-lines-agi span { height: calc(13px * var(--root-scale)); }
.attr-lines.attr-lines-vit span { height: calc(13px * var(--root-scale)); }
.attr-lines.attr-lines-ene span { height: calc(13px * var(--root-scale)); }

/* MU Moldova has no master levels (season3.sql sets MaximumMasterLevel to 0), so the
   master skill tree button is gone; CCharacterInfoWindow::RmlClickMasterLevel and the A key
   no longer open the window either. */
#btn_masterlevel { display: none; }

/* ---- Advanced stats tab (MU Moldova) ----
   The fourth button sits where the master level button was. Its sprite, a golden bar chart in the stone square
   of the quest and pet buttons, comes from scripts/chainfo-stats-button.py (main repo). While #panel has
   .adv-view (the model's advanced_view), two boxes take the place of the attribute rows, each in the summary
   box's 8-piece frame with a yellow title over the separator like the level line: box 1 at 120 (8 lines, 136
   high), box 2 at 260 (7 lines, 123 high: six stats and Combat Power). */
@spritesheet chainfo-btn-advstats-sheet { src: "../../../newui_chainfo_btn_stats.tga"; chainfo-btn-advstats: 0px 0px 36px 29px; }
.info-btn-advstats { left: 124px; decorator: image(chainfo-btn-advstats); }

/* ---- Titles button (MU Moldova) ----
   The fifth button opens the titles window (CTitlesWindow) beside this one. Its sprite, a golden plate with a gem
   in the same stone square, comes from tools/chainfo_titles_button.py. Five 36-wide buttons don't fit the row, so
   all five (the shared exit too) are 31 wide, a pixel apart: 13, 45, 77, 109, 141. */
@spritesheet chainfo-btn-titles-sheet { src: "../../../newui_chainfo_btn_titles.tga"; chainfo-btn-titles: 0px 0px 36px 29px; }
.info-btn-titles { decorator: image(chainfo-btn-titles); }
#panel #btn_exit, #panel .info-btn { width: 31px; }
#panel .info-btn-quest { left: 45px; }
#panel .info-btn-pet { left: 77px; }
#panel .info-btn-advstats { left: 109px; }
#panel .info-btn-titles { left: 141px; }

.adv { display: none; }
#panel.adv-view .adv { display: block; }
#panel.adv-view .attr-textbox, #panel.adv-view .attr-label, #panel.adv-view .attr-value,
#panel.adv-view .attr-lines, #panel.adv-view .stat-btn { display: none; }

.adv-fill { position: absolute; left: 12px; right: 18px; background-color: rgba(0, 0, 0, 77); pointer-events: none; }
.adv-fill-1 { top: 120px; height: 136px; }
.adv-fill-2 { top: 260px; height: 123px; }
.adv-corner-tl-1 { left: 12px;  top: 120px; decorator: image(docked-corner-tl); }
.adv-corner-tr-1 { right: 13px; top: 120px; decorator: image(docked-corner-tr); }
.adv-corner-bl-1 { left: 12px;  top: 242px; decorator: image(docked-corner-bl); }
.adv-corner-br-1 { right: 13px; top: 242px; decorator: image(docked-corner-br); }
.adv-corner-tl-2 { left: 12px;  top: 260px; decorator: image(docked-corner-tl); }
.adv-corner-tr-2 { right: 13px; top: 260px; decorator: image(docked-corner-tr); }
.adv-corner-bl-2 { left: 12px;  top: 369px; decorator: image(docked-corner-bl); }
.adv-corner-br-2 { right: 13px; top: 369px; decorator: image(docked-corner-br); }
.adv-edge-top-1       { left: 26px; right: 27px; top: 120px; height: 14px; decorator: image(chainfo-table-top); }
.adv-edge-bottom-1    { left: 26px; right: 27px; top: 242px; height: 14px; decorator: image(chainfo-table-bottom); }
.adv-edge-separator-1 { left: 14px; right: 17px; top: 132px; height: 14px; decorator: image(chainfo-table-bottom); }
.adv-edge-left-1      { left: 12px;  top: 134px; width: 14px; height: 108px; decorator: image(chainfo-table-left); }
.adv-edge-right-1     { right: 13px; top: 134px; width: 14px; height: 108px; decorator: image(chainfo-table-right); }
.adv-edge-top-2       { left: 26px; right: 27px; top: 260px; height: 14px; decorator: image(chainfo-table-top); }
.adv-edge-bottom-2    { left: 26px; right: 27px; top: 369px; height: 14px; decorator: image(chainfo-table-bottom); }
.adv-edge-separator-2 { left: 14px; right: 17px; top: 272px; height: 14px; decorator: image(chainfo-table-bottom); }
.adv-edge-left-2      { left: 12px;  top: 274px; width: 14px; height: 95px; decorator: image(chainfo-table-left); }
.adv-edge-right-2     { right: 13px; top: 274px; width: 14px; height: 95px; decorator: image(chainfo-table-right); }

.adv-title { position: absolute; left: 18px; width: calc(152px * var(--root-scale)); transform-origin: left top; white-space: nowrap; color: #e6e600; font-weight: bold; pointer-events: none; }
.adv-title-1 { top: 130px; }
.adv-title-2 { top: 270px; }
.adv-lines { position: absolute; left: 18px; width: calc(152px * var(--root-scale)); transform-origin: left top; pointer-events: none; }
.adv-lines-1 { top: 147px; }
.adv-lines-2 { top: 287px; }
.adv-lines span { display: block; white-space: nowrap; color: #ffffff; height: calc(13px * var(--root-scale)); }
.adv-lines span.boosted { color: rgb(100, 150, 255); }

/* MU Moldova: the phone view (UI::Mobile::IsPhoneView()): the text keeps the native text size while the
   panel shrinks to the phone's height, so the 190-wide window cut its lines off. It is 290 wide here; the
   pieces pinned to the edges follow, the frame's and the text boxes' ornaments keep their size and their
   plain middles stretch (the battle pass's tiles, battle_pass.rcss). The level-up points move to the right
   end of the level line, and the "+" and the bottom buttons grow to finger size. */
@spritesheet chainfo-phone-textbox-sheet { src: "../../../newui_cha_textbox02.tga"; chainfo-phone-textbox: 0px 0px 170px 21px; chainfo-phone-textbox-inner: 10px 4px 150px 13px; }
@media (theme: mobile) {
	#panel { width: 290px; }
	.frame-top { decorator: tiled-horizontal(docked-phone-top-b-l, docked-phone-top-b-c, docked-phone-top-b-r); }
	.frame-bottom { decorator: tiled-horizontal(docked-phone-bottom-l, docked-phone-bottom-c, docked-phone-bottom-r); }
	.levelup-point-text { left: auto; right: 22px; transform-origin: right top; }
	.attr-textbox { decorator: ninepatch(chainfo-phone-textbox, chainfo-phone-textbox-inner); }
	.attr-label { width: 110px; }
	.attr-value { left: 122px; right: 44px; }
	.stat-btn {
		right: 14px;
		width: 24px;
		height: 21px;
		margin: -6px;
		padding: 6px;
		decorator: image(chainfo-stat-btn) content-box;
	}
	.stat-btn-str { top: 120px; }
	.stat-btn-agi { top: 175px; }
	.stat-btn-vit { top: 240px; }
	.stat-btn-ene { top: 295px; }
	.stat-btn-cmd { top: 350px; }
	#panel #btn_exit, #panel .info-btn { width: 44px; height: 34px; bottom: 6px; }
	#panel #btn_exit { left: 23px; decorator: image(docked-exit-btn) content-box; }
	#panel .info-btn-quest { left: 73px; }
	#panel .info-btn-pet { left: 123px; }
	#panel .info-btn-advstats { left: 173px; }
	#panel .info-btn-titles { left: 223px; }
}
