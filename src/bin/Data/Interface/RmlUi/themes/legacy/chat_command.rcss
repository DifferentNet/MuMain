/* Legacy theme for CChatCommandWindow, reproducing its RenderBaseWindow()/pages/buttons: the
   docked_panel_frame.rcss frame (linked first; newui_item_back01 top) stretched to the full dock
   height (432); the texts left-aligned in their boxes in their own colours (bound), the title bold
   and centred; each parameter value in a black box at alpha 160; the value field transparent, its text
   (255, 255, 230) at alpha 210; the 64 x 29 left and right buttons (newui_btn_empty_small up /
   over / down) at y 358 with a white label; the exit button. Reference px inside #panel. */

@spritesheet cc-btn-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	cc-btn-up: 0px 0px 64px 29px;
	cc-btn-over: 0px 29px 64px 29px;
	cc-btn-down: 0px 58px 64px 29px;
}

.frame-top { decorator: image(docked-bg-top-b); }
#panel { height: 432px; pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; pointer-events: none; }
.cc-btn {
	display: block;
	position: absolute;
	top: 358px;
	width: 64px;
	height: 29px;
	decorator: image(cc-btn-up);
	pointer-events: auto;
}
.cc-btn:hover { decorator: image(cc-btn-over); }
.cc-btn:active { decorator: image(cc-btn-down); }
#btn_left { left: 22px; }
#btn_right { left: 104px; }
.cc-label { left: 0; text-align: center; color: #ffffff; }

/* The exit art (docked_panel_frame.rcss) draws its own X. */
.cc-exit-glyph { display: none; }

/* The original's grid: the rows start at CONTENT_TOP, one ROW_HEIGHT apart; on the parameter page a
   blank row comes before the parameters (35 apart: name, value box, gap) and before the actions. */
.cc-page, .cc-rows { display: block; position: absolute; left: 22px; top: 36px; width: 146px; }
.cc-title, .cc-line, .cc-cell, .cc-row-line, .cc-param-label, .cc-param-value, .cc-remove-mark {
	position: absolute;
}
.cc-title { left: 0; top: 12px; text-align: center; font-weight: bold; }
#cc_empty { left: 22px; top: 36px; }

.cc-row, .cc-line-box { display: block; position: relative; height: 15px; }
.cc-row { pointer-events: auto; }
.cc-row-line, .cc-cell { left: 0; top: 0; }

.cc-parameters, .cc-actions { display: block; padding-top: 15px; }
.cc-parameter { display: block; position: relative; height: 35px; }
.cc-param-label { left: 0; top: 0; }
.cc-value-box { position: absolute; left: 0; top: 15px; width: 146px; height: 16px; pointer-events: auto; }
.cc-param-value { left: 2px; top: 16px; }
.cc-value-field { position: absolute; left: 2px; top: 16px; }

/* A template's label takes the row less the remove cell, which sits at its right edge. */
.cc-template-hit { position: absolute; left: 0; top: 0; width: 131px; height: 15px; pointer-events: auto; }
.cc-template-label { left: 0; }
.cc-template-remove { position: absolute; left: 131px; top: 0; width: 15px; height: 15px; pointer-events: auto; }
.cc-remove-mark { left: 0; text-align: center; }

/* The original's own TextColor table (ChatCommandWindow.cpp). */
.cc-title { color: rgb(255, 220, 120); }
.cc-line, .cc-cell, .cc-param-label { color: rgb(220, 220, 220); }
.cc-row.favourite .cc-cell { color: rgb(255, 220, 120); }
.cc-row-line { color: rgb(200, 220, 255); }
.cc-param-label.missing { color: rgb(255, 150, 150); }
.cc-param-value { color: rgb(220, 220, 220); }
.cc-param-value.placeholder { color: rgb(200, 220, 255); }
.cc-action .cc-cell { color: rgb(150, 210, 255); }
.cc-remove-mark { color: rgb(255, 150, 150); }
.cc-value-box { background-color: rgba(0, 0, 0, 160); }
/* CUITextInputBox::SetTextColor(255, 255, 230, 210) -- used to arrive as a model colour. */
.cc-value-field {
	color: rgba(255, 255, 230, 210);
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	pointer-events: auto;
}

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#cc_title { width: calc(100% * var(--root-scale)); }
#cc_empty { width: calc(146px * var(--root-scale)); }
.cc-cell { width: calc(146px * var(--root-scale)); }
.cc-row-line { width: calc(146px * var(--root-scale)); }
.cc-param-label { width: calc(146px * var(--root-scale)); }
.cc-param-value { width: calc(142px * var(--root-scale)); }
.cc-value-field { width: calc(142px * var(--root-scale)); height: calc(14px * var(--root-scale)); line-height: calc(14px * var(--root-scale)); }
.cc-cell.cc-template-label { width: calc(131px * var(--root-scale)); }
.cc-remove-mark { width: calc(15px * var(--root-scale)); }
.cc-label { width: calc(64px * var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile"): a side panel down the screen's right edge, 300 units
   wide, so a command's name and its parameters fit on one line while the game and the chat stay in view
   on the left. The command and template lists hold every row (CChatCommandWindow::VisibleRows()) and
   scroll by finger, rows a finger can hit, a slim bar showing where the list is; the parameter boxes, the
   left and right buttons and a template's remove cell are finger-sized. The frame's ends keep their art
   while its plain middle repeats (docked_panel_frame.rcss), and the parchment repeats. The buttons' labels
   take their line height from the model (29 units), so they sit lower in the taller button. */
@spritesheet cc-phone-btn-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	cc-phone-btn-up: 0px 0px 64px 29px; cc-phone-btn-up-inner: 10px 7px 44px 15px;
	cc-phone-btn-over: 0px 29px 64px 29px; cc-phone-btn-over-inner: 10px 36px 44px 15px;
	cc-phone-btn-down: 0px 58px 64px 29px; cc-phone-btn-down-inner: 10px 65px 44px 15px;
}
@media (theme: mobile) {
	#panel { width: 300px; decorator: image(docked-bg-fill repeat left top); }
	.frame-top { decorator: tiled-horizontal(docked-phone-top-b-l, docked-phone-top-b-c, docked-phone-top-b-r); }
	.frame-bottom { decorator: tiled-horizontal(docked-phone-bottom-l, docked-phone-bottom-c, docked-phone-bottom-r); }

	/* --- The lists: rows 34 units tall from under the title to the buttons --- */
	.cc-page, .cc-rows { left: 22px; top: 40px; width: 256px; }
	.cc-rows { height: 300px; }
	.cc-rows .cc-row {
		height: 34px;
		border-bottom-width: 1px;
		border-bottom-color: rgba(255, 255, 255, 28);
	}
	.cc-rows .cc-cell { left: 6px; }
	.cc-rows .cc-cell, .cc-rows .cc-remove-mark { line-height: calc(34px * var(--root-scale)); }
	.cc-rows scrollbarvertical { width: 4px; }
	.cc-rows scrollbarvertical slidertrack { decorator: none; background-color: rgba(255, 255, 255, 20); }
	.cc-rows scrollbarvertical sliderbar { decorator: none; height: auto; min-height: 24px; background-color: rgba(255, 220, 120, 150); }
	.cc-rows scrollbarvertical sliderarrowdec, .cc-rows scrollbarvertical sliderarrowinc { height: 0; }

	/* --- A command's page: its description, then each parameter's name over a box a finger hits --- */
	.cc-line-box { height: 17px; }
	.cc-parameter { height: 54px; }
	.cc-value-box { top: 17px; width: 256px; height: 30px; }
	.cc-param-value, .cc-value-field { left: 6px; top: 17px; }
	.cc-param-value { line-height: calc(30px * var(--root-scale)); }
	.cc-value-field { height: calc(30px * var(--root-scale)); line-height: calc(30px * var(--root-scale)); }
	.cc-actions .cc-row { height: 34px; }
	.cc-actions .cc-cell { line-height: calc(34px * var(--root-scale)); }

	/* --- A template row: its label, then the remove cell clear of the bar --- */
	.cc-template-hit { width: 214px; height: 34px; }
	.cc-template-remove { left: auto; right: 4px; width: 36px; height: 34px; }

	/* --- The left and right buttons --- */
	.cc-btn { top: 346px; width: 124px; height: 36px; decorator: ninepatch(cc-phone-btn-up, cc-phone-btn-up-inner); }
	.cc-btn:hover { decorator: ninepatch(cc-phone-btn-over, cc-phone-btn-over-inner); }
	.cc-btn:active { decorator: ninepatch(cc-phone-btn-down, cc-phone-btn-down-inner); }
	#btn_left { left: 22px; }
	#btn_right { left: 154px; }
	.cc-label { top: 4px; }

	/* --- Lengths inside counter-scaled layers --- */
	#cc_empty { top: 40px; width: calc(256px * var(--root-scale)); }
	.cc-cell, .cc-row-line, .cc-param-label { width: calc(256px * var(--root-scale)); }
	.cc-rows .cc-cell { width: calc(244px * var(--root-scale)); }
	.cc-param-value, .cc-value-field { width: calc(244px * var(--root-scale)); }
	.cc-cell.cc-template-label { width: calc(208px * var(--root-scale)); }
	.cc-remove-mark { width: calc(36px * var(--root-scale)); }
	.cc-label { width: calc(124px * var(--root-scale)); }
}
