<rml>
	<!-- bound-geometry: panel and well heights follow the user resize, in dp -->
<head>
	<title>Chat Log</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="chat_log.rcss"/>
</head>
<!-- Legacy override of chat_log.rml: each line is drawn like the original's RenderMessages() --
     the native text size and a background exactly as tall as the measured text, one row every
     15 units (CChatLogWindow::SyncNativeLineGeometry(), physical px). The window, its well and
     the row pitch stay in dp beside the chat input box. -->
<body data-model="chat_log">
	<div id="panel" data-class-framed="show_frame" data-style-height="panel_height + 'dp'">
		<div id="chat_backdrop" data-style-opacity="back_alpha"></div>
		<div id="resize_handle" data-class-hidden="!show_frame"
		     data-event-drag="chat_resize_drag"></div>

		<div id="lines" class="scroll-pane" data-style-height="client_height + 'dp'" data-event-click="chat_lines_tap"
		     data-style---line-px="line_px + 'px'" data-style---row-px="row_px + 'px'">
			<div data-for="line : lines"
			     class="chat-line"
			     data-class-chat-line--chat="line.kind == 'chat'"
			     data-class-chat-line--whisper="line.kind == 'whisper'"
			     data-class-chat-line--system="line.kind == 'system'"
			     data-class-chat-line--error="line.kind == 'error'"
			     data-class-chat-line--party="line.kind == 'party'"
			     data-class-chat-line--guild="line.kind == 'guild'"
			     data-class-chat-line--union="line.kind == 'union'"
			     data-class-chat-line--gens="line.kind == 'gens'"
			     data-class-chat-line--gm="line.kind == 'gm'"
			     data-class-chat-line--has-id="line.has_id"
			     data-class-chat-line--pointed="it_index == pointed_index"
			     data-class-chat-line--faded="line.faded"
			     data-class-chat-line--lead="line.lead"
			     data-style-font-size="text_px + 'px'">{{line.text}}<span data-for="seg : line.segs"
				       data-class-chat-link="seg.link >= 0"
				       data-class-chat-link--normal="seg.rarity == 'normal'"
				       data-class-chat-link--high="seg.rarity == 'high'"
				       data-class-chat-link--excellent="seg.rarity == 'excellent'"
				       data-class-chat-link--socket="seg.rarity == 'socket'"
				       data-class-chat-link--ancient="seg.rarity == 'ancient'"
				       data-attr-link="seg.link">{{seg.text}}</span></div>
		</div>
	</div>
</body>
</rml>
