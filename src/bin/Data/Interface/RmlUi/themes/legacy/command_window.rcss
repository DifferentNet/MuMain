/* Legacy theme for CCommandWindow, reproducing the original's RenderBaseWindow(), its twelve
   CButtons, the title, the exit button and the target box at the pointer. The frame is
   docked_panel_frame.rcss's (linked first) at this window's own height: DockLogicalBottom (432)
   rather than 429, with the 320-texel side pieces stretched over 323 units and the bottom piece
   at 432 - 45, as RenderBaseWindow() drew them. Coordinates are reference px inside #panel. */

@spritesheet cmd-btn-sheet
{
	src: "../../../newui_btn_empty.tga";
	cmd-btn-up: 0px 0px 108px 29px;
	cmd-btn-over: 0px 29px 108px 29px;
	cmd-btn-down: 0px 58px 108px 29px;
}
@spritesheet cmd-target-sheet { src: "../../../newui_cursorid_wnd.jpg"; cmd-target: 0px 0px 128px 32px; }

.frame-top { decorator: image(docked-bg-top-b); }
#panel { height: 432px; pointer-events: auto; }
.frame-left, .frame-right { height: 323px; }
.frame-bottom { top: 387px; }

/* RenderText(x + 60, y + 12, title, 72, 0, RT3_SORT_CENTER), bold white. */
#title {
	display: block;
	position: absolute;
	left: 60px;
	top: 12px;
	text-align: center;
	white-space: nowrap;
	color: #ffffff;
	font-weight: bold;
	pointer-events: none;
}

/* InitButtons(): 108x29, centred on the 190-wide panel (x 41), from y 33, 30 apart. */
#buttons { position: absolute; left: 41px; top: 33px; width: 108px; }
.cmd-btn {
	display: block;
	position: relative;
	width: 108px;
	height: 29px;
	margin-bottom: 1px;
	decorator: image(cmd-btn-up);
	pointer-events: auto;
}
.cmd-btn:hover { decorator: image(cmd-btn-over); }
.cmd-btn:active, .cmd-btn.selected { decorator: image(cmd-btn-down); }

/* CButton::Render(): the label centred in the button box, white; the armed command's in bold. */
.cmd-label {
	display: block;
	position: absolute;
	left: 0;
	text-align: center;
	white-space: nowrap;
	color: #ffffff;
	pointer-events: none;
}
.cmd-btn.selected .cmd-label { font-weight: bold; }

/* The target box: newui_cursorid_wnd (128x32) at the pointer + 5; the name in the big font,
   centred on the box 7 units below its top, white, or red (255, 0, 0) out of reach. */
#target {
	position: absolute;
	width: 128px;
	height: 32px;
	decorator: image(cmd-target);
	pointer-events: none;
}
#target_name {
	display: block;
	position: absolute;
	left: 0;
	top: 7px;
	text-align: center;
	white-space: nowrap;
	color: #ffffff;
	pointer-events: none;
}
#target.out-of-range #target_name { color: #ff0000; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(72px * var(--root-scale)); }
.cmd-label { width: calc(108px * var(--root-scale)); }
#target_name { width: calc(128px * var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile"): the window is 300 units wide and the twelve buttons
   stand in two columns of six, each 126 x 42 for a finger and 8 apart, from under the title to above the
   exit; their art is drawn from newui_btn_empty's stretch-safe middle, so it is not stretched out of shape.
   The frame's ends keep their art while its plain middle repeats (docked_panel_frame.rcss), and the
   parchment repeats. */
@spritesheet cmd-phone-btn-sheet
{
	src: "../../../newui_btn_empty.tga";
	cmd-phone-btn-up: 0px 0px 108px 29px; cmd-phone-btn-up-inner: 10px 7px 88px 15px;
	cmd-phone-btn-over: 0px 29px 108px 29px; cmd-phone-btn-over-inner: 10px 36px 88px 15px;
	cmd-phone-btn-down: 0px 58px 108px 29px; cmd-phone-btn-down-inner: 10px 65px 88px 15px;
}
@media (theme: mobile) {
	#panel { width: 300px; decorator: image(docked-bg-fill repeat left top); }
	.frame-top { decorator: tiled-horizontal(docked-phone-top-b-l, docked-phone-top-b-c, docked-phone-top-b-r); }
	.frame-bottom { decorator: tiled-horizontal(docked-phone-bottom-l, docked-phone-bottom-c, docked-phone-bottom-r); }
	#title { left: 0; width: calc(300px * var(--root-scale)); }

	#buttons { left: 20px; top: 44px; width: 262px; }
	.cmd-btn {
		float: left;
		width: 126px;
		height: 42px;
		margin: 0 0 8px 0;
		decorator: ninepatch(cmd-phone-btn-up, cmd-phone-btn-up-inner);
	}
	.cmd-btn:nth-child(even) { margin-left: 8px; }
	.cmd-btn:hover { decorator: ninepatch(cmd-phone-btn-over, cmd-phone-btn-over-inner); }
	.cmd-btn:active, .cmd-btn.selected { decorator: ninepatch(cmd-phone-btn-down, cmd-phone-btn-down-inner); }
	.cmd-label { width: calc(126px * var(--root-scale)); }
}
