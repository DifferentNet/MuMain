/* Legacy theme for CDuelWatchWindow, reproducing its RenderFrame()/Render(): the
   docked_panel_frame.rcss frame (linked first; newui_item_back01 top), "Doorkeeper Titus" bold
   (220, 220, 220) centred on 160 units from x 15 at y 13, the prompt bold at y 50 centred on 190
   (left aligned when it overflows, like the original), three newui_myquest_Line separators
   (188 x 21) at y 130 + 90 k, and per colosseum (90 units apart from y 50): the heading bold
   (255, 255, 128) at + 20, "VS" red (255, 50, 50) centred at + 35 with the players centred in
   70-unit boxes at x 20 and 100, or "No duel on." white, and the 53 x 23 Watch button at
   (68, 100): newui_btn_empty_very_small up / over / down, tinted (100, 100, 100) with a grey
   label while locked. Coordinates are reference px inside #panel. */

@spritesheet dw-btn-sheet
{
	src: "../../../newui_btn_empty_very_small.tga";
	dw-btn-up: 0px 0px 53px 23px;
	dw-btn-over: 0px 23px 53px 23px;
	dw-btn-down: 0px 46px 53px 23px;
}
@spritesheet dw-line-sheet { src: "../../../newui_myquest_Line.tga"; dw-line: 0px 0px 188px 21px; }

.frame-top { decorator: image(docked-bg-top-b); }
#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; }

#title { left: 15px; top: 13px; font-weight: bold; color: #dcdcdc; }
#subtitle { left: 0; top: 50px; font-weight: bold; color: #dcdcdc; }

.line { position: absolute; left: 1px; width: 188px; height: 21px; decorator: image(dw-line); }

.room { display: block; position: absolute; left: 0; width: 190px; height: 90px; }
.room-heading { left: 0; top: 70px; font-weight: bold; color: #ffff80; }
.room-vs { left: 0; top: 85px; color: #ff3232; }
.room-player { top: 85px; color: #ffffff; }
.room-player-1 { left: 20px; }
.room-player-2 { left: 100px; }
.room-empty { left: 0; top: 85px; color: #ffffff; }

.watch-btn {
	display: block;
	position: absolute;
	left: 68px;
	top: 100px;
	width: 53px;
	height: 23px;
	decorator: image(dw-btn-up);
	image-color: #646464;
	pointer-events: auto;
}
.watch-btn.enabled { image-color: #ffffff; }
.watch-btn.enabled:hover { decorator: image(dw-btn-over); }
.watch-btn.enabled:active { decorator: image(dw-btn-down); }
.watch-label { left: 0; color: #646464; }
.watch-btn.enabled .watch-label { color: #ffffff; }

/* The three separators and the four colosseum blocks, 90 units apart as the original drew them. */
.lines, .rooms { position: static; }
.lines .line:nth-child(1) { top: 130px; }
.lines .line:nth-child(2) { top: 220px; }
.lines .line:nth-child(3) { top: 310px; }
.room:nth-child(1) { top: 0; }
.room:nth-child(2) { top: 90px; }
.room:nth-child(3) { top: 180px; }
.room:nth-child(4) { top: 270px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
#subtitle { width: calc(190px * var(--root-scale)); }
.room-heading { width: calc(190px * var(--root-scale)); }
.room-vs { width: calc(190px * var(--root-scale)); }
.room-player.room-player-1 { width: calc(70px * var(--root-scale)); }
.room-player.room-player-2 { width: calc(70px * var(--root-scale)); }
.room-empty { width: calc(190px * var(--root-scale)); }
.watch-label { width: calc(53px * var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile"): the window is 300 units wide, so the prompt and the
   names the phone's readable text makes longer keep to it: each colosseum's lines are centred on the
   wider window, its two players in 120-unit boxes either side of "VS", and the separators move 55 units
   right to stay centred. Watch is 90 x 36 for a finger, drawn from newui_btn_empty_small's stretch-safe
   middle so its art is not stretched out of shape; a locked one keeps its tint. The frame's ends keep
   their art while its plain middle repeats (docked_panel_frame.rcss), and the parchment repeats. */
@spritesheet dw-phone-btn-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	dw-phone-btn-up: 0px 0px 64px 29px; dw-phone-btn-up-inner: 10px 7px 44px 15px;
	dw-phone-btn-over: 0px 29px 64px 29px; dw-phone-btn-over-inner: 10px 36px 44px 15px;
	dw-phone-btn-down: 0px 58px 64px 29px; dw-phone-btn-down-inner: 10px 65px 44px 15px;
}
@media (theme: mobile) {
	#panel { width: 300px; decorator: image(docked-bg-fill repeat left top); }
	.frame-top { decorator: tiled-horizontal(docked-phone-top-b-l, docked-phone-top-b-c, docked-phone-top-b-r); }
	.frame-bottom { decorator: tiled-horizontal(docked-phone-bottom-l, docked-phone-bottom-c, docked-phone-bottom-r); }
	#title { left: 0; width: calc(300px * var(--root-scale)); }
	#subtitle { width: calc(300px * var(--root-scale)); }
	.line { left: 56px; }

	.room { width: 300px; }
	.room-heading, .room-vs, .room-empty { width: calc(300px * var(--root-scale)); }
	.room-player.room-player-1 { left: 20px; width: calc(120px * var(--root-scale)); }
	.room-player.room-player-2 { left: 160px; width: calc(120px * var(--root-scale)); }

	.watch-btn { left: 105px; top: 97px; width: 90px; height: 36px; decorator: ninepatch(dw-phone-btn-up, dw-phone-btn-up-inner); }
	.watch-btn.enabled:hover { decorator: ninepatch(dw-phone-btn-over, dw-phone-btn-over-inner); }
	.watch-btn.enabled:active { decorator: ninepatch(dw-phone-btn-down, dw-phone-btn-down-inner); }
	.watch-label { width: calc(90px * var(--root-scale)); }
}
