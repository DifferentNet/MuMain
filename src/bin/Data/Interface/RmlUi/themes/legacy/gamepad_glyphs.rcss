/* The Xbox pad's button glyphs, drawn from boxes (no images). The legacy and the modern theme carry
   the same file: the colours are the pad's own. touch_controls.rml puts one on each control the pad
   presses and shows them only while a pad is in use (its body has the class "pad"); where each sits
   on its control is touch_controls.rcss's.

   .pad-face.pad-a / -b / -x / -y   a dark disc with the letter in the button's colour
   .pad-bumper (LB, RB)             a flat key rounded on top
   .pad-trigger (LT, RT)            a tall key rounded on top
   .pad-round.pad-view              a disc with two overlapping windows (View)
   .pad-round.pad-menu              a disc with three lines (Menu)
   .pad-dpad.pad-dpad-up / -down / -left / -right
                                    the d-pad's cross with the pressed arm lit */

.pad-glyph {
	display: none;
	position: absolute;
	box-sizing: border-box;
	background-color: rgba(22, 22, 24, 235);
	color: #f2f2f2;
	font-family: "token(font-body)";
	font-weight: bold;
	font-effect: none;
	text-align: center;
	pointer-events: none;
}
body.pad .pad-glyph {
	display: block;
}
.pad-glyph * {
	pointer-events: none;
}

.pad-face {
	width: 20dp;
	height: 20dp;
	border: 2dp #f2f2f2;
	border-radius: 10dp;
	font-size: 12dp;
	line-height: 16dp;
}
.pad-a { border-color: #6cc24a; color: #6cc24a; }
.pad-b { border-color: #e0443e; color: #e0443e; }
.pad-x { border-color: #3b8eea; color: #3b8eea; }
.pad-y { border-color: #f2c230; color: #f2c230; }

.pad-bumper {
	width: 26dp;
	height: 15dp;
	border: 1dp rgba(242, 242, 242, 210);
	border-radius: 7dp 7dp 3dp 3dp;
	font-size: 9dp;
	line-height: 13dp;
}
.pad-trigger {
	width: 20dp;
	height: 22dp;
	border: 1dp rgba(242, 242, 242, 210);
	border-radius: 10dp 10dp 4dp 4dp;
	font-size: 9dp;
	line-height: 22dp;
}

.pad-round {
	width: 20dp;
	height: 20dp;
	border: 1dp rgba(242, 242, 242, 210);
	border-radius: 10dp;
}
.pad-view-back, .pad-view-front {
	position: absolute;
	box-sizing: border-box;
	width: 8dp;
	height: 6dp;
	border: 1dp #f2f2f2;
	border-radius: 1dp;
}
.pad-view-back { left: 3dp; top: 4dp; }
.pad-view-front { left: 7dp; top: 8dp; background-color: rgba(22, 22, 24, 255); }
.pad-menu-line {
	position: absolute;
	left: 5dp;
	width: 8dp;
	height: 2dp;
	background-color: #f2f2f2;
}
.pad-menu-line-1 { top: 5dp; }
.pad-menu-line-2 { top: 8dp; }
.pad-menu-line-3 { top: 11dp; }

.pad-dpad {
	width: 20dp;
	height: 20dp;
	border: 1dp rgba(242, 242, 242, 120);
	border-radius: 10dp;
}
.pad-dpad-v, .pad-dpad-h, .pad-dpad-lit {
	position: absolute;
	border-radius: 1dp;
	background-color: rgba(140, 140, 146, 255);
}
.pad-dpad-v { left: 6dp; top: 2dp; width: 6dp; height: 14dp; }
.pad-dpad-h { left: 2dp; top: 6dp; width: 14dp; height: 6dp; }
.pad-dpad-lit { background-color: #f2f2f2; }
.pad-dpad-up .pad-dpad-lit { left: 6dp; top: 2dp; width: 6dp; height: 5dp; }
.pad-dpad-down .pad-dpad-lit { left: 6dp; top: 11dp; width: 6dp; height: 5dp; }
.pad-dpad-left .pad-dpad-lit { left: 2dp; top: 6dp; width: 5dp; height: 6dp; }
.pad-dpad-right .pad-dpad-lit { left: 11dp; top: 6dp; width: 5dp; height: 6dp; }
