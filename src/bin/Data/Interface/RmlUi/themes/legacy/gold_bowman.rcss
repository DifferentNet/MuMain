/* Legacy theme for the Golden Archer's windows (CGoldBowmanWindow, CGoldBowmanLena), over
   event_item_entry.rcss (linked first): texts keep their spaces (the Rena counts are
   "    X    n") and start from their box's left edge where the original used RT3_SORT_LEFT;
   Register is the 108 x 29 newui_btn_empty with a white normal label and the exit button
   newui_exit_00 (36 x 29); the original registered both without an over image
   (ChangeButtonImgState(.., false)), so hovering keeps the up row and pressing shows the second
   row. The number field is the original's CUITextInputBox: white text over a faint black back,
   inside the newui_guildmakeeditbox back of the background document. */

@spritesheet gb-btn-wide-sheet
{
	src: "../../../newui_btn_empty.tga";
	gb-btn-wide-up: 0px 0px 108px 29px;
	gb-btn-wide-down: 0px 29px 108px 29px;
}
@spritesheet gb-exit-sheet
{
	src: "../../../newui_exit_00.tga";
	gb-exit-up: 0px 0px 36px 29px;
	gb-exit-down: 0px 29px 36px 29px;
}

.entry-text .sharp-text { white-space: pre; }


#serial_field {
	text-align: left;
	left: 50px;
	top: 260px;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: rgba(0, 0, 0, 25);
	color: rgba(255, 255, 230, 230);
	pointer-events: auto;
}

/* The docked frame and the lucky number field's back. */
@spritesheet gb-serial-back-sheet { src: "../../../newui_guildmakeeditbox.tga"; gb-serial-back: 0px 0px 108px 23px; }

.frame-top { decorator: image(docked-bg-top-a); }
#serial_back { position: absolute; left: 45px; top: 255px; width: 108px; height: 23px; decorator: image(gb-serial-back); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#serial_field { width: calc(200px * var(--root-scale)); height: calc(14px * var(--root-scale)); line-height: calc(14px * var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile"), over event_item_entry.rcss's 300-unit window: the
   newui_item_back04 top with its ends kept and its plain middle repeated, and the number field a finger's
   height (32 units), its back drawn from the edit box's stretch-safe middle and the field over the whole of
   it. Places on the 190-unit window, as the rows; event_item_entry.rcss moves them right. */
@spritesheet gb-phone-top-a-sheet { src: "../../../newui_item_back04.tga"; gb-phone-top-a-l: 0px 0px 60px 64px; gb-phone-top-a-c: 90px 0px 10px 64px; gb-phone-top-a-r: 130px 0px 60px 64px; }
@spritesheet gb-phone-serial-back-sheet { src: "../../../newui_guildmakeeditbox.tga"; gb-phone-serial-back: 0px 0px 108px 23px; gb-phone-serial-back-inner: 5px 5px 98px 13px; }
@media (theme: mobile) {
	.frame-top { decorator: tiled-horizontal(gb-phone-top-a-l, gb-phone-top-a-c, gb-phone-top-a-r); }
	#serial_back { left: 25px; top: 245px; width: 140px; height: 32px; decorator: ninepatch(gb-phone-serial-back, gb-phone-serial-back-inner); }
	#serial_field {
		left: 31px;
		top: 245px;
		width: calc(128px * var(--root-scale));
		height: calc(32px * var(--root-scale));
		line-height: calc(32px * var(--root-scale));
	}
}
