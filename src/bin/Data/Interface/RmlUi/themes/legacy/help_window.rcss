/* Legacy theme for CHelpWindow -- RenderTipTextList() with its background, as the original drew
   the help pages: black at 80% opacity inside a 1-unit opaque black frame, one unit of padding
   each side and none above or below, white rows and a blue bold heading (TEXT_COLOR_BLUE,
   128/179/255), centred in the text box (RT3_SORT_CENTER). Reference px on the .stage. */

#panel { pointer-events: none; }

/* RenderTipTextList(1, 1, ...): the frame's top-left at (-1, 0), the text box inside it as wide as
   the widest line plus 2, centring the lines. The layer reaches the screen's right edge, so the box
   is never wider than the screen. */
#help_layer {
	position: absolute;
	left: -1px;
	top: 0px;
	width: calc(641px * var(--root-scale));
}
#help_panel {
	display: inline-block;
	padding: 0px calc(2px * var(--root-scale));
	border-width: calc(1px * var(--root-scale));
	border-color: #000000;
	background-color: rgba(0, 0, 0, 204);
}

/* RenderTipTextList()'s rows: one line height, the next row 1.1 of them below; a half spacer
   takes half of that advance. A row too wide for the screen wraps and grows by whole lines.
   Physical px, in the counter-scaled box. */
.help-line {
	display: block;
	min-height: calc(var(--line-height, 0px) * var(--root-scale));
	margin-bottom: calc(var(--line-height, 0px) * 0.1 * var(--root-scale));
}
.help-line.heading {
	min-height: calc(var(--bold-line-height, 0px) * var(--root-scale));
	margin-bottom: calc(var(--bold-line-height, 0px) * 0.1 * var(--root-scale));
}
.help-line.half-spacer {
	height: calc(var(--line-height, 0px) * 0.55 * var(--root-scale));
	min-height: 0px;
	margin-bottom: 0px;
}
.help-text {
	display: block;
	white-space: normal;
	line-height: calc(var(--line-height, 0px) * var(--root-scale));
	text-align: center;
	color: #ffffff;
	font-family: "token(font-body)";
}
/* MU Skynet's last row, what turns the page ("F1 : next page", "LB, RB: ...", "Tap here: ..."): the
   original's yellow. It takes the pointer (the other rows let it through to the world), so a click or
   a tap on it turns the page. */
.help-line.hint {
	pointer-events: auto;
	cursor: pointer;
}
.help-line.hint .help-text {
	color: #ffe680;
}
.help-line.hint:hover .help-text {
	color: #fff4c0;
}
.help-line.heading .help-text {
	line-height: calc(var(--bold-line-height, 0px) * var(--root-scale));
	color: #80b3ff;
	font-weight: bold;
}

/* MU Moldova: the phone view (UI::Mobile::IsPhoneView()): below the touch controls' top bar, whose Back
   closes it, and clear of both edges' rounded corners; the hint row a finger's height. */
@media (theme: mobile) {
	#help_layer { left: 8px; top: 44px; width: calc(624px * var(--root-scale)); }
	.help-line.hint {
		padding: calc(var(--line-height, 0px) * 0.5 * var(--root-scale)) 0px;
	}
}
