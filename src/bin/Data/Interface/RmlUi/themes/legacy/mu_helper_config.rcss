/* Legacy layout for CMuHelperConfigWindow. Every rectangle is native's own m_Pos + K -- the
   RenderBack() boxes from Render(), and each control's registration in InitButtons/InitCheckBox/
   InitImage/InitText/InitTextboxInput. The pieces' look comes from mu_helper_common.rcss. Controls
   a class doesn't have are hidden in the RML from UI::MuHelper::ResolveClassFeatures(), never here. */

.mhc-tab { position: absolute; left: 0; top: 0; }
.mh-check { position: absolute; width: 15px; height: 15px; }

/* --- Hunting ----------------------------------------------------------------------------------- */
#box_h_range    { left: 12px; top: 73px;  width: 68px;  height: 50px; }
#box_h_recovery { left: 75px; top: 73px;  width: 102px; height: 50px; }
#box_h_movement { left: 12px; top: 120px; width: 165px; height: 39px; }
#box_h_skills   { left: 12px; top: 156px; width: 165px; height: 135px; }
#box_h_buffs    { left: 12px; top: 288px; width: 165px; height: 69px; }

#h_range_label  { left: 18px; top: 78px; }
#h_range_rule   { left: 18px; top: 83px; }
#h_range_digit  { left: 29px; top: 92px; }
#btn_hunt_add   { left: 56px; top: 78px; }
#btn_hunt_minus { left: 56px; top: 97px; }

#cb_potion       { left: 79px; top: 80px; }
#cb_auto_heal    { left: 79px; top: 97px; }
#cb_drain_life   { left: 79px; top: 97px; }
/* The summoner's potion Setting sits five units higher than everyone else's. */
#btn_potion_setting, #btn_potion_setting_label { left: 132px; top: 84px; }
#btn_potion_setting.summoner, #btn_potion_setting_label.summoner { top: 79px; }

#cb_long_distance { left: 18px;  top: 122px; }
#cb_orig_position { left: 18px;  top: 137px; }
#distance_label   { left: 110px; top: 141px; }
#distance_plate   { left: 140px; top: 137px; }
#distance_time    { left: 142px; top: 140px; }
#distance_unit    { left: 162px; top: 141px; }

#basic_skill_label { left: 18px; top: 160px; }
#activation1_label { left: 59px; top: 160px; }
#slot_0 { left: 17px; top: 171px; }
#slot_1 { left: 61px; top: 171px; }

#cb_skill2_delay     { left: 94px;  top: 174px; }
#skill2_plate        { left: 140px; top: 174px; }
#skill2_delay        { left: 142px; top: 177px; }
#skill2_unit         { left: 162px; top: 178px; }
#cb_skill2_condition { left: 94px;  top: 191px; }
#btn_skill2_setting, #btn_skill2_setting_label { left: 132px; top: 191px; }

#activation2_label   { left: 59px;  top: 212px; }
#slot_2              { left: 61px;  top: 222px; }
#cb_skill3_delay     { left: 94px;  top: 226px; }
#skill3_plate        { left: 140px; top: 226px; }
#skill3_delay        { left: 142px; top: 229px; }
#skill3_unit         { left: 162px; top: 230px; }
#cb_skill3_condition { left: 94px;  top: 243px; }
#btn_skill3_setting, #btn_skill3_setting_label { left: 132px; top: 243px; }

#cb_combo    { left: 18px; top: 226px; }
#cb_fallback { left: 18px; top: 266px; }

/* Dark Lord's raven and the other classes' party support share this corner -- no class has both. */
#cb_use_pet        { left: 18px; top: 218px; }
#rb_raven_cease    { left: 94px; top: 235px; }
#rb_raven_auto     { left: 30px; top: 235px; }
#rb_raven_together { left: 30px; top: 250px; }
#cb_party          { left: 18px; top: 218px; }
#btn_party_setting, #btn_party_setting_label { left: 17px; top: 234px; }

#cb_buff_duration { left: 18px; top: 291px; }
#slot_3 { left: 21px; top: 308px; }
#slot_4 { left: 55px; top: 308px; }
#slot_5 { left: 89px; top: 308px; }

/* --- Item pick-up ------------------------------------------------------------------------------ */
#box_o_range  { left: 12px; top: 73px;  width: 68px;  height: 50px; }
#box_o_repair { left: 75px; top: 73px;  width: 102px; height: 50px; }
#box_o_mode   { left: 12px; top: 120px; width: 165px; height: 30px; }
#box_o_items  { left: 12px; top: 147px; width: 165px; height: 195px; }
#box_o_list   { left: 16px; top: 235px; width: 158px; height: 75px; }

#o_range_label  { left: 18px; top: 78px; }
#o_range_rule   { left: 18px; top: 83px; }
#o_range_digit  { left: 29px; top: 92px; }
#btn_pick_add   { left: 56px; top: 78px; }
#btn_pick_minus { left: 56px; top: 97px; }

#cb_repair         { left: 79px; top: 80px; }
#cb_pick_all       { left: 17px; top: 125px; }
#cb_pick_selected  { left: 17px; top: 152px; }
#cb_pick_jewel     { left: 22px; top: 170px; }
#cb_pick_ancient   { left: 85px; top: 170px; }
#cb_pick_zen       { left: 22px; top: 185px; }
#cb_pick_excellent { left: 85px; top: 185px; }
#cb_pick_extra     { left: 22px; top: 200px; }

#item_plate { left: 34px; top: 216px; }
#item_name  { left: 36px; top: 219px; }
#btn_add_item, #btn_add_item_label { left: 132px; top: 208px; }

#extra_list { position: absolute; left: 20px; top: 238px; }
#btn_delete_item, #btn_delete_item_label { left: 132px; top: 309px; }

/* --- Other ------------------------------------------------------------------------------------- */
#box_x_accept { left: 12px; top: 73px;  width: 165px; height: 50px; }
#box_x_defend { left: 12px; top: 120px; width: 165px; height: 222px; }
#cb_auto_friend { left: 18px; top: 80px; }
#cb_auto_guild  { left: 18px; top: 97px; }
#cb_auto_defend { left: 18px; top: 125px; }

/* --- Extension note (second and third tabs) ----------------------------------------------------- */
#box_extension  { left: 12px; top: 340px; width: 165px; height: 46px; }
#extension_used { left: 20px; top: 347px; }
#extension_none { left: 20px; top: 365px; }

/* --- Footer ------------------------------------------------------------------------------------ */
#btn_save, #btn_save_label { left: 120px; top: 388px; }
#btn_init, #btn_init_label { left: 65px;  top: 388px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
/* Between the frame's top corners, clear of the close button. */
#title { left: 28px; width: calc(134px * var(--root-scale)); }
#tab_0_label { width: calc(56px * var(--root-scale)); height: calc(22px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
#tab_1_label { width: calc(56px * var(--root-scale)); height: calc(22px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
#tab_2_label { width: calc(56px * var(--root-scale)); height: calc(22px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
#btn_potion_setting_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#distance_time { width: calc(17px * var(--root-scale)); height: calc(12px * var(--root-scale)); }
#skill2_delay { width: calc(17px * var(--root-scale)); height: calc(12px * var(--root-scale)); }
#btn_skill2_setting_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#skill3_delay { width: calc(17px * var(--root-scale)); height: calc(12px * var(--root-scale)); }
#btn_skill3_setting_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#btn_party_setting_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#item_name { width: calc(88px * var(--root-scale)); height: calc(12px * var(--root-scale)); }
#btn_add_item_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#extra_list { width: calc(160px * var(--root-scale)); height: calc(70px * var(--root-scale)); }
.mh-extra-row { height: calc(13px * var(--root-scale)); padding: calc(3px * var(--root-scale)) 0 0 calc(8px * var(--root-scale)); }
#btn_delete_item_label { width: calc(38px * var(--root-scale)); height: calc(24px * var(--root-scale)); line-height: calc(24px * var(--root-scale)); }
#btn_save_label { width: calc(52px * var(--root-scale)); height: calc(26px * var(--root-scale)); line-height: calc(26px * var(--root-scale)); }
#btn_init_label { width: calc(52px * var(--root-scale)); height: calc(26px * var(--root-scale)); line-height: calc(26px * var(--root-scale)); }

/* Every label keeps one line in the room native left it: from where native drew it to the next
   control, or to its box's inner edge. Longer text ends in ".." and scrolls on hover
   (base.rcss .marquee, RmlMarquee.h). The tab and button labels already have their boxes. */
#h_range_label, #o_range_label { width: calc(38px * var(--root-scale)); }
#cb_potion .checkbox-label, #cb_auto_heal .checkbox-label, #cb_drain_life .checkbox-label { width: calc(37px * var(--root-scale)); }
#cb_long_distance .checkbox-label, #cb_use_pet .checkbox-label, #cb_fallback .checkbox-label,
#cb_buff_duration .checkbox-label, #cb_auto_friend .checkbox-label, #cb_auto_guild .checkbox-label,
#cb_auto_defend .checkbox-label { width: calc(137px * var(--root-scale)); }
#cb_orig_position .checkbox-label, #cb_repair .checkbox-label { width: calc(76px * var(--root-scale)); }
#distance_label, #cb_skill2_delay .checkbox-label, #cb_skill3_delay .checkbox-label { width: calc(30px * var(--root-scale)); }
#distance_unit, #skill2_unit, #skill3_unit { width: calc(12px * var(--root-scale)); }
#cb_skill2_condition .checkbox-label, #cb_skill3_condition .checkbox-label { width: calc(22px * var(--root-scale)); }
#basic_skill_label { width: calc(41px * var(--root-scale)); }
#activation1_label, #activation2_label { width: calc(35px * var(--root-scale)); }
#cb_combo .checkbox-label, #cb_party .checkbox-label { width: calc(27px * var(--root-scale)); }
#rb_raven_cease .checkbox-label { width: calc(61px * var(--root-scale)); }
#rb_raven_auto .checkbox-label { width: calc(48px * var(--root-scale)); }
#rb_raven_together .checkbox-label { width: calc(125px * var(--root-scale)); }
#cb_pick_all .checkbox-label, #cb_pick_selected .checkbox-label { width: calc(138px * var(--root-scale)); }
#cb_pick_jewel .checkbox-label, #cb_pick_zen .checkbox-label { width: calc(47px * var(--root-scale)); }
#cb_pick_ancient .checkbox-label, #cb_pick_excellent .checkbox-label { width: calc(70px * var(--root-scale)); }
#cb_pick_extra .checkbox-label { width: calc(94px * var(--root-scale)); }
#extension_used, #extension_none { width: calc(151px * var(--root-scale)); }

/* The hunting page's line on clearing a skill slot shows in the phone view only (below). */
#mh_slot_hint, #box_slot_hint { display: none; }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode). Native's 190 units at the
   native text size cut most labels short, and its 15-unit boxes were too small for a finger. Here the
   window is 640 units wide: native's groups in two columns (the skills, the extra-item list and the
   defence group on the right), every label with room for its Russian text, the boxes, steppers, plates,
   slots and buttons a third larger (the shared pieces, the frame and the parchment from
   mu_helper_common.rcss's phone block), and a check box's finger area running on over its label. The
   tabs' and buttons' ends keep their size while their plain middles stretch. Under the hunting page's groups, where the other pages show the extension note, a
   line says how to clear a skill slot: a long press is the right button, which clears it. */
@spritesheet mh-phone-tab-sheet {
	src: "../../../newui_guild_tab04.tga";
	mh-phone-tab-up: 0px 0px 56px 22px; mh-phone-tab-up-inner: 8px 4px 40px 14px;
	mh-phone-tab-on: 0px 22px 56px 22px; mh-phone-tab-on-inner: 8px 26px 40px 14px;
}
@spritesheet mh-phone-setting-sheet {
	src: "../../../newui_Bt_clearness_illusion.jpg";
	mh-phone-setting-up: 0px 0px 38px 24px; mh-phone-setting-up-inner: 6px 5px 26px 14px;
	mh-phone-setting-over: 0px 24px 38px 24px; mh-phone-setting-over-inner: 6px 29px 26px 14px;
	mh-phone-setting-down: 0px 48px 38px 24px; mh-phone-setting-down-inner: 6px 53px 26px 14px;
}
@media (theme: mobile) {
	#panel { width: 640px; }
	#title { width: calc(584px * var(--root-scale)); }

	/* --- Tabs --- */
	.mh-tab { top: 44px; width: 140px; height: 28px; decorator: ninepatch(mh-phone-tab-up, mh-phone-tab-up-inner); }
	.mh-tab.active { decorator: ninepatch(mh-phone-tab-on, mh-phone-tab-on-inner); }
	.mh-tab-label { top: 44px; }
	#tab_0, #tab_0_label { left: 24px; }
	#tab_1, #tab_1_label { left: 164px; }
	#tab_2, #tab_2_label { left: 304px; }
	#tab_0_label, #tab_1_label, #tab_2_label {
		width: calc(140px * var(--root-scale));
		height: calc(28px * var(--root-scale));
		line-height: calc(28px * var(--root-scale));
	}

	/* --- The pieces, a third larger; the steppers' decorators paint their content box --- */
	.mh-check { width: 20px; height: 20px; }
	.mh-btn-plus, .mh-btn-minus { width: 24px; height: 22px; margin: -4px; padding: 4px; }
	.mh-btn-setting { width: 58px; height: 30px; decorator: ninepatch(mh-phone-setting-up, mh-phone-setting-up-inner); }
	.mh-btn-setting:hover { decorator: ninepatch(mh-phone-setting-over, mh-phone-setting-over-inner); }
	.mh-btn-setting:active { decorator: ninepatch(mh-phone-setting-down, mh-phone-setting-down-inner); }
	.mh-string-plate { width: 196px; height: 22px; }
	.mh-range-digit { width: 20px; height: 25px; }
	.mh-slot { width: 36px; height: 42px; }
	.mh-slot-icon { left: 7px; top: 7px; width: 22px; height: 31px; }
	#btn_potion_setting_label, #btn_skill2_setting_label, #btn_skill3_setting_label, #btn_party_setting_label,
	#btn_add_item_label, #btn_delete_item_label {
		width: calc(58px * var(--root-scale));
		height: calc(30px * var(--root-scale));
		line-height: calc(30px * var(--root-scale));
	}
	#distance_time, #skill2_delay, #skill3_delay { width: calc(26px * var(--root-scale)); height: calc(16px * var(--root-scale)); }

	/* --- Hunting, left: range and recovery, movement, buffs (the pick-up page's range and repair alike) --- */
	#box_h_range, #box_o_range { left: 24px; top: 73px; width: 110px; height: 78px; }
	#box_h_recovery, #box_o_repair { left: 130px; top: 73px; width: 188px; height: 78px; }
	#box_h_movement { left: 24px; top: 148px; width: 294px; height: 100px; }
	#box_h_buffs { left: 24px; top: 245px; width: 294px; height: 94px; }
	#h_range_label, #o_range_label { left: 34px; top: 80px; width: calc(60px * var(--root-scale)); }
	#h_range_rule, #o_range_rule { left: 34px; top: 85px; }
	#h_range_digit, #o_range_digit { left: 54px; top: 106px; }
	#btn_hunt_add, #btn_pick_add { left: 100px; top: 82px; }
	#btn_hunt_minus, #btn_pick_minus { left: 100px; top: 116px; }

	#cb_potion { left: 142px; top: 84px; }
	#cb_auto_heal, #cb_drain_life { left: 142px; top: 118px; }
	/* Beside the potion, whatever the class: the second row is the heal's or the drain's alone. */
	#btn_potion_setting, #btn_potion_setting_label,
	#btn_potion_setting.summoner, #btn_potion_setting_label.summoner { left: 254px; top: 79px; }

	#cb_long_distance { left: 34px; top: 158px; }
	#cb_orig_position { left: 34px; top: 188px; }
	#distance_label { left: 60px; top: 223px; width: calc(100px * var(--root-scale)); }
	#distance_plate { left: 168px; top: 218px; }
	#distance_time { left: 170px; top: 221px; }
	#distance_unit { left: 204px; top: 223px; }

	#cb_buff_duration { left: 34px; top: 255px; }
	#slot_3 { left: 40px; top: 284px; }
	#slot_4 { left: 88px; top: 284px; }
	#slot_5 { left: 136px; top: 284px; }

	/* --- Hunting, right: the skills, each slot with its label and options beside it --- */
	#box_h_skills { left: 322px; top: 73px; width: 294px; height: 266px; }
	#slot_0 { left: 334px; top: 82px; }
	#basic_skill_label { left: 380px; top: 97px; }
	#activation1_label { left: 380px; top: 128px; }
	#slot_1 { left: 334px; top: 140px; }
	#cb_skill2_delay { left: 380px; top: 146px; }
	#skill2_plate { left: 484px; top: 145px; }
	#skill2_delay { left: 486px; top: 148px; }
	#skill2_unit { left: 518px; top: 150px; }
	#cb_skill2_condition { left: 380px; top: 172px; }
	#btn_skill2_setting, #btn_skill2_setting_label { left: 548px; top: 157px; }
	#activation2_label { left: 380px; top: 208px; }
	#slot_2 { left: 334px; top: 220px; }
	#cb_skill3_delay { left: 380px; top: 226px; }
	#skill3_plate { left: 484px; top: 225px; }
	#skill3_delay { left: 486px; top: 228px; }
	#skill3_unit { left: 518px; top: 230px; }
	#cb_skill3_condition { left: 380px; top: 252px; }
	#btn_skill3_setting, #btn_skill3_setting_label { left: 548px; top: 237px; }
	/* A delay's finger area stops short of its number field. */
	#cb_skill2_delay .checkbox-box, #cb_skill3_delay .checkbox-box { padding-right: 76px; }

	/* The Dark Lord has no third skill, so his raven takes its rows; the other classes' combo or party row
	   is under them. */
	#cb_use_pet { left: 332px; top: 206px; }
	#rb_raven_auto { left: 346px; top: 232px; }
	#rb_raven_cease { left: 480px; top: 232px; }
	#rb_raven_together { left: 346px; top: 258px; }
	#cb_combo, #cb_party { left: 332px; top: 286px; }
	#btn_party_setting, #btn_party_setting_label { left: 548px; top: 281px; }
	#cb_fallback { left: 332px; top: 314px; }

	/* --- Item pick-up: the mode and the kinds on the left, the extra-item list on the right --- */
	#box_o_mode { left: 24px; top: 148px; width: 294px; height: 44px; }
	#box_o_items { left: 24px; top: 189px; width: 294px; height: 150px; }
	#box_o_list { left: 322px; top: 73px; width: 294px; height: 266px; }
	#cb_repair { left: 142px; top: 102px; }
	#cb_pick_all { left: 34px; top: 160px; }
	#cb_pick_selected { left: 34px; top: 200px; }
	#cb_pick_jewel { left: 48px; top: 226px; }
	#cb_pick_ancient { left: 48px; top: 252px; }
	#cb_pick_zen { left: 48px; top: 278px; }
	#cb_pick_excellent { left: 48px; top: 304px; }
	#cb_pick_extra { left: 332px; top: 84px; }
	#item_plate { left: 334px; top: 113px; }
	#item_name {
		left: 338px;
		top: 116px;
		width: calc(188px * var(--root-scale));
		height: calc(16px * var(--root-scale));
	}
	#btn_add_item, #btn_add_item_label { left: 546px; top: 109px; }
	#extra_list {
		left: 334px;
		top: 148px;
		width: calc(270px * var(--root-scale));
		height: calc(144px * var(--root-scale));
	}
	.mh-extra-row { height: calc(24px * var(--root-scale)); padding: calc(6px * var(--root-scale)) 0 0 calc(8px * var(--root-scale)); }
	#btn_delete_item, #btn_delete_item_label { left: 546px; top: 300px; }

	/* --- Other --- */
	#box_x_accept { left: 24px; top: 73px; width: 294px; height: 266px; }
	#box_x_defend { left: 322px; top: 73px; width: 294px; height: 266px; }
	#cb_auto_friend { left: 34px; top: 84px; }
	#cb_auto_guild { left: 34px; top: 112px; }
	#cb_auto_defend { left: 332px; top: 84px; }

	/* --- Under the groups: the extension note (second and third tabs) or the slot line (first) --- */
	#box_extension { left: 24px; top: 336px; width: 592px; height: 48px; }
	#extension_used { left: 36px; top: 344px; }
	#extension_none { left: 36px; top: 362px; }
	#box_slot_hint { display: block; left: 24px; top: 336px; width: 592px; height: 48px; }
	#mh_slot_hint { display: block; left: 36px; top: 354px; color: token(text-muted); }

	/* --- Footer --- */
	#btn_init, #btn_init_label { left: 358px; top: 386px; }
	#btn_save, #btn_save_label { left: 480px; top: 386px; }
	#btn_init { width: 116px; }
	#btn_save { width: 136px; }
	#btn_init_label, #btn_save_label { height: calc(30px * var(--root-scale)); line-height: calc(30px * var(--root-scale)); }
	#btn_init_label { width: calc(116px * var(--root-scale)); }
	#btn_save_label { width: calc(136px * var(--root-scale)); }

	/* --- Each label's room, to the next control or its group's inner edge --- */
	#cb_potion .checkbox-label { width: calc(80px * var(--root-scale)); }
	#cb_auto_heal .checkbox-label, #cb_drain_life .checkbox-label, #cb_repair .checkbox-label { width: calc(144px * var(--root-scale)); }
	#cb_long_distance .checkbox-label, #cb_orig_position .checkbox-label, #cb_buff_duration .checkbox-label,
	#cb_pick_all .checkbox-label, #cb_pick_selected .checkbox-label, #cb_auto_friend .checkbox-label,
	#cb_auto_guild .checkbox-label { width: calc(250px * var(--root-scale)); }
	#cb_pick_jewel .checkbox-label, #cb_pick_ancient .checkbox-label, #cb_pick_zen .checkbox-label,
	#cb_pick_excellent .checkbox-label { width: calc(236px * var(--root-scale)); }
	#basic_skill_label, #activation1_label, #activation2_label { width: calc(226px * var(--root-scale)); }
	#cb_skill2_delay .checkbox-label, #cb_skill3_delay .checkbox-label { width: calc(74px * var(--root-scale)); }
	#distance_unit, #skill2_unit, #skill3_unit { width: calc(20px * var(--root-scale)); }
	#cb_skill2_condition .checkbox-label, #cb_skill3_condition .checkbox-label { width: calc(134px * var(--root-scale)); }
	#cb_combo .checkbox-label, #cb_party .checkbox-label { width: calc(180px * var(--root-scale)); }
	#rb_raven_auto .checkbox-label { width: calc(104px * var(--root-scale)); }
	#rb_raven_cease .checkbox-label { width: calc(100px * var(--root-scale)); }
	#cb_use_pet .checkbox-label, #cb_fallback .checkbox-label, #cb_pick_extra .checkbox-label,
	#cb_auto_defend .checkbox-label, #rb_raven_together .checkbox-label { width: calc(234px * var(--root-scale)); }
	#extension_used, #extension_none, #mh_slot_hint { width: calc(568px * var(--root-scale)); }
}
