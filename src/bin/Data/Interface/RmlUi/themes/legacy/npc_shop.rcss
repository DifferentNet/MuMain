/* Legacy theme for CNPCShop's chrome (frame/title/tax-rate line/repair buttons/repair-money
   strip). The workspace places #panel (its slot's left/top/scale), so coordinates below are
   plain reference px, not dp. No exit button -- the frame's corner "X" closes it. Button/text positions match NPCShop.cpp's former RenderTexts()/
   SetButtonInfo()/RenderRepairMoney() constants. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 11px; /* native y+12 (glyph top) */
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: token(text-label);
	font-weight: bold;
	font-size: 1em;
}
#tax_rate {
	position: absolute;
	left: 0;
	top: 26px; /* native y+27 */
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: token(text-label);
	font-weight: bold;
	font-size: 1em;
}

/* Both buttons share one sprite -- NPCShop.cpp's former SetButtonInfo() pointed both
   m_BtnRepair/m_BtnRepairAll at the same IMAGE_NPCSHOP_BTN_REPAIR image, differing only by
   tooltip text. */
@spritesheet shop-btn-repair-sheet { src: "../../../newui_repair_00.tga"; shop-btn-repair: 0px 0px 36px 29px; }
.shop-btn {
	position: absolute;
	top: 390px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(shop-btn-repair);
}
.shop-btn:hover { filter: brightness(1.25); }
.shop-btn.hidden { display: none; }

.shop-btn-repair     { left: 54px; }
.shop-btn-repair-all { left: 98px; }

@spritesheet repair-money-sheet { src: "../../../newui_item_money2.tga"; repair-money: 0px 0px 170px 24px; }
.repair-money {
	position: absolute;
	left: 10px;
	top: 355px;
	width: 170px;
	height: 24px;
	pointer-events: none;
	decorator: image(repair-money);
}
.repair-money.hidden { display: none; }

.repair-money-label, .repair-money-value {
	position: absolute;
	top: 362px;
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
.repair-money-label { left: 20px; color: token(text-label); }
.repair-money-value { left: 100px; }
.repair-money-label.hidden, .repair-money-value.hidden { display: none; }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 50px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
@spritesheet shop-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   shop-bg-fill:   0px 0px 190px 429px; }
@spritesheet shop-bg-top-sheet    { src: "../../../newui_item_back04.tga";   shop-bg-top:    0px 0px 190px 64px;  }
@spritesheet shop-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; shop-bg-left:   0px 0px 21px 320px;  }
@spritesheet shop-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; shop-bg-right:  0px 0px 21px 320px;  }
@spritesheet shop-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   shop-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(shop-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(shop-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(shop-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(shop-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(shop-bg-bottom); }

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode): the full 432 height of
   the dock, 42 px cells, 8 of the 15 rows on view (item_grid.rcss pages them), the ▲▼ and the repair
   buttons down the right side, the repair money under the grid. 420 wide, so the bag-only inventory
   fits beside it on a phone. */
@spritesheet shop-phone-top-sheet    { src: "../../../newui_item_back04.tga"; shop-phone-top-l: 0px 0px 60px 64px; shop-phone-top-c: 90px 0px 10px 64px; shop-phone-top-r: 130px 0px 60px 64px; }
@spritesheet shop-phone-bottom-sheet { src: "../../../newui_item_back03.tga"; shop-phone-bottom-l: 0px 0px 50px 45px; shop-phone-bottom-c: 90px 0px 10px 45px; shop-phone-bottom-r: 140px 0px 50px 45px; }

@media (theme: mobile) {
	#panel { --item-cell: 42px; width: 420px; height: 432px; }

	.bg-fill { width: 100%; height: 432px; }
	.bg-top { width: 100%; decorator: tiled-horizontal(shop-phone-top-l, shop-phone-top-c, shop-phone-top-r); }
	.bg-left { height: 323px; }
	.bg-right { left: auto; right: 0; height: 323px; }
	.bg-bottom { top: 387px; width: 100%; decorator: tiled-horizontal(shop-phone-bottom-l, shop-phone-bottom-c, shop-phone-bottom-r); }

	/* The grid's first cell at (16, 50). */
	#grid_viewport { left: 10px; top: 44px; }
	.grid-scroll-up { left: 364px; top: 50px; }
	.grid-scroll-down { left: 364px; top: calc(50px + 8 * var(--item-cell) - 44px); }

	.shop-btn { left: 364px; width: 44px; height: 36px; }
	.shop-btn-repair { top: 150px; }
	.shop-btn-repair-all { top: 196px; }

	.repair-money { left: 56px; top: 398px; }
	.repair-money-label, .repair-money-value { top: 405px; }
	.repair-money-label { left: 66px; }
	.repair-money-value { left: 146px; }
}
