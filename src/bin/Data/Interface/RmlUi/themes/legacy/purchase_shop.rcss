/* Legacy theme for CPurchaseShopInventory's chrome (frame/title/subtitle-strip/warning-text/exit
   button). #panel's left/top/scale come live from C++ (SyncRmlModel()), so coordinates below are
   plain reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* Between the frame's top corners, clear of the close button; a longer title ends in ".." and
   scrolls on hover (base.rcss .marquee). */
#title {
	position: absolute;
	left: 28px;
	top: 15px;
	width: calc(134px * var(--root-scale));
	text-align: center;
	/* Native draws it in the normal font, 0xFF49B0FF -- an ABGR DWORD, i.e. (255,176,73). */
	color: #ffb049;
	font-size: 1em;
}

/* Same sprite as CMyShopInventory's own subject-box background (newui_Box_openTitle.tga) --
   purely decorative here, behind a read-only shop-owner name instead of a live text field. */
@spritesheet pshop-title-strip-sheet { src: "../../../newui_Box_openTitle.tga"; pshop-title-strip: 0px 0px 169px 26px; }
.shop-title-strip {
	position: absolute;
	left: 12px;
	top: 49px;
	width: 169px;
	height: 26px;
	pointer-events: none;
	decorator: image(pshop-title-strip);
}
#shop_owner_text {
	position: absolute;
	left: 0;
	top: 58px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: #00ff00;
	font-weight: bold;
	font-size: 1em;
	pointer-events: none;
}

/* The old RenderTextInfo()'s colours; shop_notice.rcss lays the notice out. */
.warning-label { color: #ff2d2f; }
.warning-line { color: token(text-notice); }

@spritesheet pshop-btn-exit-sheet { src: "../../../newui_exit_00.tga"; pshop-btn-exit: 0px 0px 36px 29px; }
.shop-btn-exit {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(pshop-btn-exit);
}
.shop-btn-exit:hover { filter: brightness(1.25); }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 16px; top: 90px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
@spritesheet pshop-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   pshop-bg-fill:   0px 0px 190px 429px; }
@spritesheet pshop-bg-top-sheet    { src: "../../../newui_item_back01.tga";   pshop-bg-top:    0px 0px 190px 64px;  }
@spritesheet pshop-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; pshop-bg-left:   0px 0px 21px 320px;  }
@spritesheet pshop-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; pshop-bg-right:  0px 0px 21px 320px;  }
@spritesheet pshop-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   pshop-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(pshop-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(pshop-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(pshop-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(pshop-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(pshop-bg-bottom); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode): the full 432 height of
   the dock, the grid down the right side in 42 px cells, the owner's name, notes and exit button
   (44 x 36) in the native column on the left, the notes taking the grid's old place. 552 wide: with
   the bag-only inventory beside it, a phone's width (19.5:9 and wider). shop_notice.rcss comes after
   this sheet, so its box is named through #panel here. */
@spritesheet pshop-phone-top-sheet    { src: "../../../newui_item_back01.tga"; pshop-phone-top-l: 0px 0px 60px 64px; pshop-phone-top-c: 90px 0px 10px 64px; pshop-phone-top-r: 130px 0px 60px 64px; }
@spritesheet pshop-phone-bottom-sheet { src: "../../../newui_item_back03.tga"; pshop-phone-bottom-l: 0px 0px 50px 45px; pshop-phone-bottom-c: 90px 0px 10px 45px; pshop-phone-bottom-r: 140px 0px 50px 45px; }

@media (theme: mobile) {
	#panel { --item-cell: 42px; width: 552px; height: 432px; }

	.bg-fill { width: 100%; height: 432px; }
	.bg-top { width: 100%; decorator: tiled-horizontal(pshop-phone-top-l, pshop-phone-top-c, pshop-phone-top-r); }
	.bg-left { height: 323px; }
	.bg-right { left: auto; right: 0; height: 323px; }
	.bg-bottom { top: 387px; width: 100%; decorator: tiled-horizontal(pshop-phone-bottom-l, pshop-phone-bottom-c, pshop-phone-bottom-r); }
	#item_view { width: calc(100% + 40px); height: 472px; }

	#title { width: calc(496px * var(--root-scale)); }
	#item_grid, #item_grid_counts { left: 200px; top: 50px; }
	#panel .shop-notice { top: 90px; height: calc(286px * var(--root-scale)); }
	.shop-btn-exit { left: 16px; top: 384px; width: 44px; height: 36px; }
}
