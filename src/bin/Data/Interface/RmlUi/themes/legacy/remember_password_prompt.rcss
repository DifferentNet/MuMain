/* Legacy theme for the "remember password" OK/Cancel confirmation -- no dedicated sprite, flat/
   programmatic panel matching login.rcss's palette. */

/* #panel is centered via the .center-both utility class (remember_password_prompt.rml); every
   dimension is dp for the global auto-fit. */
#panel {
	width: 340dp;
	height: 150dp;
	font-family: "token(font-body)";
	font-size: 12dp;
	color: token(text-primary);
	background-color: #1a140a;
	border: 1dp #806040;
}

.prompt-title {
	position: absolute;
	left: 20dp;
	top: 15dp;
	width: 300dp;
	color: token(accent-gold);
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 20dp;
	top: 40dp;
	width: 300dp;
	color: #ff9c40;
	white-space: normal;
}

.btn-ok     { left: 52dp;  top: 105dp; }
.btn-cancel { left: 180dp; top: 105dp; }

/* MU Moldova: larger on a phone (theme flag "mobile"), as msg_win.rcss: its buttons about 125x35 css.
   The translate keeps .center-both's centring (base.rcss). */
@media (theme: mobile) {
	#panel { transform: translate(-50%, -50%) scale(1.35); }
}
