/* Legacy theme for CStorageInventory's chrome (frame/title/money/buttons). #panel's left/top/
   scale come live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp.
   Button layout matches my_inventory.rcss's own action row exactly (same 13/50/87/124 slots,
   36x29 boxes, top:391) -- this window's frame budget is identical in that respect, just
   different icons/tooltips/click targets. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 11px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: rgb(216, 216, 216);
	font-weight: bold;
	font-size: 1em;
}
/* Matches CStorageInventory::RenderText()'s former red title when locked (m_bLock). */
#title.locked { color: rgb(240, 32, 32); }

@spritesheet stor-money-sheet { src: "../../../newui_item_money3.tga"; stor-money: 0px 0px 170px 46px; }
#money_bg {
	position: absolute;
	left: 10px;
	top: 342px;
	width: 170px;
	height: 46px;
	decorator: image(stor-money);
	pointer-events: none;
}
#zen_text {
	position: absolute;
	right: 22px;
	top: 350px;
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
#fee_label {
	position: absolute;
	left: 25px;
	top: 371px;
	color: rgb(240, 64, 64);
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
#fee_value {
	position: absolute;
	right: 22px;
	top: 371px;
	color: rgb(255, 220, 150);
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}

/* Buttons: same 36x29 reference-pixel boxes, same 13/50/87/124 slots as my_inventory.rcss's
   action row. */
@spritesheet stor-btn-insert-sheet    { src: "../../../newui_Bt_money01.tga";  stor-btn-insert:    0px 0px 36px 29px; }
@spritesheet stor-btn-take-sheet      { src: "../../../newui_Bt_money02.tga";  stor-btn-take:      0px 0px 36px 29px; }
@spritesheet stor-lock-unlocked-sheet { src: "../../../newui_Bt_lock02.tga";   stor-lock-unlocked: 0px 0px 36px 29px; }
@spritesheet stor-lock-locked-sheet   { src: "../../../newui_Bt_lock.tga";     stor-lock-locked:   0px 0px 36px 29px; }
@spritesheet stor-btn-expand-sheet    { src: "../../../newui_expansion_btn.tga"; stor-btn-expand:  0px 0px 36px 29px; }

.stor-btn {
	position: absolute;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.stor-btn:hover { filter: brightness(1.25); }
.stor-btn.hidden { display: none; }

.stor-btn-insert { left: 13px;  decorator: image(stor-btn-insert); }
.stor-btn-take   { left: 50px;  decorator: image(stor-btn-take); }
.stor-btn-lock   { left: 87px;  decorator: image(stor-lock-unlocked); }
/* Icon swap on the lock button itself -- same toggle-class mechanism as my_inventory.rcss's
   .inv-btn-myshop/.close-mode, just swapping the actual sprite here instead of just an accent. */
.stor-btn-lock.locked-mode { decorator: image(stor-lock-locked); }
.stor-btn-expand { left: 124px; decorator: image(stor-btn-expand); }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 36px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
@spritesheet stor-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   stor-bg-fill:   0px 0px 190px 429px; }
@spritesheet stor-bg-top-sheet    { src: "../../../newui_item_back01.tga";   stor-bg-top:    0px 0px 190px 64px;  }
@spritesheet stor-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; stor-bg-left:   0px 0px 21px 320px;  }
@spritesheet stor-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; stor-bg-right:  0px 0px 21px 320px;  }
@spritesheet stor-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   stor-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(stor-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(stor-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(stor-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(stor-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(stor-bg-bottom); }

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }

/* The vault page arrows beside the title (VaultPages.h): the cash shop storage's page arrows
   (in_game_shop.rcss), 20x22 with hover and pressed frames, placed evenly around the centred title
   and clear of the corner close (x 163-187). Dimmed while a switch waits or an item is held. */
@spritesheet stor-page-left-sheet  { src: "../../../InGameShop/IGS_Storage_Page_Left.tga";  stor-page-left-up: 0px 0px 20px 22px;  stor-page-left-over: 0px 22px 20px 22px;  stor-page-left-down: 0px 44px 20px 22px; }
@spritesheet stor-page-right-sheet { src: "../../../InGameShop/IGS_Storage_Page_Right.tga"; stor-page-right-up: 0px 0px 20px 22px; stor-page-right-over: 0px 22px 20px 22px; stor-page-right-down: 0px 44px 20px 22px; }
.stor-page-btn {
	position: absolute;
	top: 7px;
	width: 20px;
	height: 22px;
	cursor: pointer;
	pointer-events: auto;
}
.stor-page-btn.hidden { display: none; }
.stor-page-btn.busy { pointer-events: none; filter: brightness(0.5); }
.stor-page-prev { left: 30px; decorator: image(stor-page-left-up); }
.stor-page-prev:hover { decorator: image(stor-page-left-over); }
.stor-page-prev:active { decorator: image(stor-page-left-down); }
.stor-page-next { left: 140px; decorator: image(stor-page-right-up); }
.stor-page-next:hover { decorator: image(stor-page-right-over); }
.stor-page-next:active { decorator: image(stor-page-right-down); }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode): the full 432 height of
   the dock, 42 px cells, 8 of the 15 rows on view (item_grid.rcss pages them), the ▲▼ and the four
   buttons down the right side, the money under the grid, bigger page arrows. 420 wide, so the
   bag-only inventory fits beside it on a phone. */
@spritesheet stor-phone-top-sheet    { src: "../../../newui_item_back01.tga"; stor-phone-top-l: 0px 0px 60px 64px; stor-phone-top-c: 90px 0px 10px 64px; stor-phone-top-r: 130px 0px 60px 64px; }
@spritesheet stor-phone-bottom-sheet { src: "../../../newui_item_back03.tga"; stor-phone-bottom-l: 0px 0px 50px 45px; stor-phone-bottom-c: 90px 0px 10px 45px; stor-phone-bottom-r: 140px 0px 50px 45px; }

@media (theme: mobile) {
	#panel { --item-cell: 42px; width: 420px; height: 432px; }

	.bg-fill { width: 100%; height: 432px; }
	.bg-top { width: 100%; decorator: tiled-horizontal(stor-phone-top-l, stor-phone-top-c, stor-phone-top-r); }
	.bg-left { height: 323px; }
	.bg-right { left: auto; right: 0; height: 323px; }
	.bg-bottom { top: 387px; width: 100%; decorator: tiled-horizontal(stor-phone-bottom-l, stor-phone-bottom-c, stor-phone-bottom-r); }

	/* The grid's first cell at (16, 40). */
	#grid_viewport { left: 10px; top: 34px; }
	.grid-scroll-up { left: 364px; top: 40px; }
	.grid-scroll-down { left: 364px; top: calc(40px + 8 * var(--item-cell) - 44px); }

	.stor-btn { left: 364px; width: 44px; height: 36px; }
	.stor-btn-insert { top: 96px; }
	.stor-btn-take { top: 142px; }
	.stor-btn-lock { top: 188px; }
	.stor-btn-expand { top: 234px; }

	/* The money strip under the grid; its texts keep their places on it. */
	#money_bg { left: 56px; top: 384px; }
	#zen_text { right: 206px; top: 392px; }
	#fee_label { left: 71px; top: 413px; }
	#fee_value { right: 206px; top: 413px; }

	/* The vault page arrows, 30 x 33, either side of the title and clear of the corner close. */
	.stor-page-btn { top: 2px; width: 30px; height: 33px; }
	.stor-page-prev { left: 60px; }
	.stor-page-next { left: 330px; }
}
