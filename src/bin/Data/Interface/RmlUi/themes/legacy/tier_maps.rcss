/* Legacy theme for CTierMapsWindow (Adviser Jerinteu's Tier Maps), in the daily rewards window's look
   (daily_rewards.rcss): the docked_panel_frame.rcss frame (linked first; newui_item_back01 top) stretched to the full
   dock height (432), the title bold and centred, four status lines, then one counter-scaled pane in which the tiers
   flow (a clickable row each), the party's members, the hint and the enter button in the event entry's button art
   (event_entry.rcss); and the exit button. Reference px inside #panel; inside the pane, physical px (reference px
   times --root-scale). */

@spritesheet tm-btn-sheet {
	src: "../../../newui_btn_empty_big.tga";
	tm-btn-up: 0px 0px 180px 29px;
	tm-btn-over: 0px 29px 180px 29px;
	tm-btn-down: 0px 58px 180px 29px;
}

.frame-top { decorator: image(docked-bg-top-b); }
#panel { height: 432px; pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; }

.tm-title { left: 0; top: 12px; text-align: center; font-weight: bold; pointer-events: none; }
#tm_today { left: 12px; top: 34px; font-weight: bold; pointer-events: none; }
#tm_power { left: 12px; top: 49px; pointer-events: none; }
#tm_ticket { left: 12px; top: 63px; pointer-events: none; }
#tm_reset { left: 12px; top: 77px; pointer-events: none; }

#tm_list { left: 12px; top: 94px; --flow-w: 166px; line-height: 1.12; }
.tm-tier {
	display: block;
	padding: calc(2px * var(--root-scale)) calc(4px * var(--root-scale));
	margin-bottom: calc(1px * var(--root-scale));
	cursor: pointer;
	pointer-events: auto;
}
.tm-tier-title { display: block; white-space: nowrap; font-weight: bold; pointer-events: none; }
.tm-tier-detail { display: block; white-space: nowrap; pointer-events: none; }
.tm-note { display: block; margin-top: calc(3px * var(--root-scale)); white-space: nowrap; }
.tm-members-title { display: block; margin-top: calc(6px * var(--root-scale)); white-space: nowrap; font-weight: bold; }
.tm-member { display: block; padding-left: calc(4px * var(--root-scale)); white-space: nowrap; }
.tm-hint { display: block; margin-top: calc(5px * var(--root-scale)); white-space: nowrap; }

#tm_enter {
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: calc(4px * var(--root-scale));
	height: calc(29px * var(--root-scale));
	cursor: pointer;
	pointer-events: auto;
	decorator: image(tm-btn-up);
}
#tm_enter:hover { decorator: image(tm-btn-over); }
#tm_enter:active { decorator: image(tm-btn-down); }
#tm_enter.off { opacity: 0.45; cursor: arrow; }
#tm_enter.off:hover, #tm_enter.off:active { decorator: image(tm-btn-up); }
.tm-enter-label { display: block; white-space: nowrap; font-weight: bold; pointer-events: none; }

/* The event timer's colours: gold title, light text, blue detail. A tier the party may enter is bright, a closed one
   grey; the picked one on a gold band. Ready members green, the others red; a bad hint red. */
.tm-title { color: rgb(255, 220, 120); }
#tm_today { color: rgb(240, 240, 240); }
#tm_power { color: rgb(200, 220, 255); }
#tm_ticket { color: rgb(255, 120, 110); }
#tm_ticket.ok { color: rgb(150, 255, 150); }
#tm_reset { color: rgb(170, 170, 170); }
.tm-tier { color: rgb(130, 130, 130); }
.tm-tier:hover { background-color: rgba(255, 255, 255, 14); }
.tm-tier.open .tm-tier-title { color: rgb(240, 240, 240); }
.tm-tier.open .tm-tier-detail { color: rgb(200, 220, 255); }
.tm-tier.selected { background-color: rgba(255, 210, 100, 48); }
.tm-tier.selected .tm-tier-title { color: rgb(255, 220, 120); }
.tm-note { color: rgb(255, 200, 120); }
.tm-members-title { color: rgb(225, 225, 225); }
.tm-member { color: rgb(255, 120, 110); }
.tm-member.ready { color: rgb(150, 255, 150); }
.tm-hint { color: rgb(200, 220, 255); }
.tm-hint.bad { color: rgb(255, 150, 120); }
.tm-enter-label { color: #ffffff; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#tm_title { width: calc(100% * var(--root-scale)); }
#tm_today, #tm_power, #tm_ticket, #tm_reset { width: calc(166px * var(--root-scale)); }
