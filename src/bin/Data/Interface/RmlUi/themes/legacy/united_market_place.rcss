/* Legacy theme for CUnitedMarketPlaceWindow, reproducing its RenderFrame()/Render(): the
   docked_panel_frame.rcss frame (linked first; newui_item_back01 top), "Julia" bold (220, 220, 220)
   centred on 160 units from x 15 at y 13, the description in the normal font, (220, 220, 220),
   centred on 190 units every 20 from y 60, the 53 x 23 Warp button at (68, 230)
   (newui_btn_empty_very_small up / over / down, tinted (100, 100, 100) with a grey label while
   locked) and the exit button. Coordinates are reference px inside #panel. */

@spritesheet market-btn-sheet
{
	src: "../../../newui_btn_empty_very_small.tga";
	market-btn-up: 0px 0px 53px 23px;
	market-btn-over: 0px 23px 53px 23px;
	market-btn-down: 0px 46px 53px 23px;
}

.frame-top { decorator: image(docked-bg-top-b); }
#panel { pointer-events: auto; }

#title, .market-line, #warp_label {
	display: block;
	position: absolute;
	white-space: nowrap;
	text-align: center;
	pointer-events: none;
}
#title { left: 15px; top: 13px; font-weight: bold; color: #dcdcdc; }
.market-line { left: 0; color: #dcdcdc; }

#warp {
	display: block;
	position: absolute;
	left: 68px;
	top: 230px;
	width: 53px;
	height: 23px;
	decorator: image(market-btn-up);
	pointer-events: auto;
}
#warp:hover { decorator: image(market-btn-over); }
#warp:active { decorator: image(market-btn-down); }
#warp.locked, #warp.locked:hover, #warp.locked:active { decorator: image(market-btn-up); image-color: #646464; }
#warp_label { left: 0; color: #ffffff; }
#warp.locked #warp_label { color: #646464; }

/* The description's own rows: every 20 units from y 60. */
.market-lines { position: static; }
.market-line:nth-child(1) { top: 60px; }
.market-line:nth-child(2) { top: 80px; }
.market-line:nth-child(3) { top: 100px; }
.market-line:nth-child(4) { top: 120px; }
.market-line:nth-child(5) { top: 140px; }
.market-line:nth-child(6) { top: 160px; }
.market-line:nth-child(7) { top: 180px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
.market-line { width: calc(190px * var(--root-scale)); }
#warp_label { width: calc(53px * var(--root-scale)); }

/* MU Moldova: the phone view (theme flag "mobile"): the window is 300 units wide, so the description's
   lines, which the phone's readable text makes longer than 190 units, stay on it, and Warp is a finger's size
   (90 x 38), drawn from newui_btn_empty_small's stretch-safe middle. The frame's ends keep their art while its
   plain middle repeats (docked_panel_frame.rcss), and the parchment repeats. A locked Warp keeps its tint. */
@spritesheet market-phone-btn-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	market-phone-btn-up: 0px 0px 64px 29px; market-phone-btn-up-inner: 10px 7px 44px 15px;
	market-phone-btn-over: 0px 29px 64px 29px; market-phone-btn-over-inner: 10px 36px 44px 15px;
	market-phone-btn-down: 0px 58px 64px 29px; market-phone-btn-down-inner: 10px 65px 44px 15px;
}
@media (theme: mobile) {
	#panel { width: 300px; decorator: image(docked-bg-fill repeat left top); }
	.frame-top { decorator: tiled-horizontal(docked-phone-top-b-l, docked-phone-top-b-c, docked-phone-top-b-r); }
	.frame-bottom { decorator: tiled-horizontal(docked-phone-bottom-l, docked-phone-bottom-c, docked-phone-bottom-r); }
	#title { width: calc(270px * var(--root-scale)); }
	.market-line { width: calc(300px * var(--root-scale)); }

	#warp { left: 105px; top: 226px; width: 90px; height: 38px; }
	#warp, #warp.locked, #warp.locked:hover, #warp.locked:active {
		decorator: ninepatch(market-phone-btn-up, market-phone-btn-up-inner);
	}
	#warp:hover { decorator: ninepatch(market-phone-btn-over, market-phone-btn-over-inner); }
	#warp:active { decorator: ninepatch(market-phone-btn-down, market-phone-btn-down-inner); }
	#warp_label { width: calc(90px * var(--root-scale)); }
}
