/* Modern theme for the character-select scene's per-character name/guild/level tags -- flat,
   semi-transparent rounded backing instead of legacy sprite art. */

/* The balloon's sizes are pixels of the original screen times --layout-pixel (1 on the desktop,
   the page's pixel density in the browser), so it keeps its size on a high-density screen and its
   text is rasterised sharp. C++ places the top-left at the anchor (bottom centre, 59x54) minus
   (59, 54); the margins move it by the rest, so the anchor stays put at any ratio. */
.balloon {
	position: absolute;
	width: calc(118px * var(--layout-pixel, 1));
	height: calc(54px * var(--layout-pixel, 1));
	margin-left: calc(59px - 59px * var(--layout-pixel, 1));
	margin-top: calc(54px - 54px * var(--layout-pixel, 1));
	pointer-events: none;
	font-family: "token(font-body)";
	color: token(text-primary);
}
.balloon-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: calc(118px * var(--layout-pixel, 1));
	height: calc(54px * var(--layout-pixel, 1));
	background-color: rgba(0, 0, 0, 110);
	border: 1px token(border-frame);
	border-radius: 2px;
}

.balloon-name, .balloon-guild, .balloon-class {
	position: absolute;
	left: 0;
	width: calc(118px * var(--layout-pixel, 1));
	text-align: center;
	white-space: nowrap;
	font-size: calc(12px * var(--layout-pixel, 1));
	font-family: "token(font-body)";
}
.balloon-name {
	top: calc(6px * var(--layout-pixel, 1));
	font-weight: bold;
	color: token(text-primary);
}
.balloon-guild {
	top: calc(22px * var(--layout-pixel, 1));
	color: token(text-primary);
}
.balloon-class {
	top: calc(38px * var(--layout-pixel, 1));
	color: token(accent-gold);
}

/* Name by control status (BalloonNameStatus; the RML toggles .name-<key>). The original
   client's colors; a normal name keeps the .balloon-name color. */
.balloon-name.name-blocked-character { color: #00ffff; }
.balloon-name.name-blocked-items     { color: #ffd927; }
.balloon-name.name-operator          { color: #ff0000; }
