/* Modern theme for the native item grids (CInventoryCtrl), drawn from the window's model
   (UI/Inventory/ItemGridModel.h): recessed cells with a hairline edge, tinted by their item's
   state as in legacy, a forged edge round the grid, and the same drop preview. The items are 3D,
   drawn into the window's .item-view image over all of it; the stack counts (.item-grid-counts)
   sit over the items. Reference px under the window's root transform. The cell pitch is
   --item-cell; CInventoryCtrl::FollowGrid() reads it back for the hit tests and the items' boxes. A
   window places and sizes each grid by its id: width and height are its columns and rows times it. */

body { --item-cell: 20px; }

.item-grid, .item-grid-counts { position: absolute; pointer-events: none; }
.item-grid-cells, .item-grid-counts { display: flex; flex-wrap: wrap; }
.item-grid-cells { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.item-cell, .item-count { position: relative; flex: 0 0 var(--item-cell); width: var(--item-cell); height: var(--item-cell); }
/* The legacy tints, so wear reads the same in both themes. */
.item-cell.tint-normal { background-color: rgba(80, 128, 128, 120); }
.item-cell.tint-durability-50 { background-color: rgba(255, 255, 0, 102); }
.item-cell.tint-durability-70 { background-color: rgba(255, 168, 0, 102); }
.item-cell.tint-durability-80 { background-color: rgba(255, 84, 0, 102); }
.item-cell.tint-durability-100 { background-color: rgba(255, 0, 0, 102); }
.item-cell.tint-untradeable { background-color: rgba(255, 51, 26, 102); }
.item-cell-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; box-sizing: border-box; border: 1px token(border-inner); }
.item-cell-drop { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.item-cell.drop-free .item-cell-drop { background-color: rgba(26, 102, 204, 102); }
.item-cell.drop-blocked .item-cell-drop, .item-cell.drop-invalid .item-cell-drop { background-color: rgba(255, 51, 51, 102); }
.item-cell.drop-valid .item-cell-drop { background-color: rgba(51, 102, 51, 102); }

.item-grid-cells { background-color: token(surface-recessed); }
.item-grid-frame {
	position: absolute;
	left: -2px;
	top: -2px;
	right: -2px;
	bottom: -2px;
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow: inset 0 0 6px rgba(0, 0, 0, 160);
}
.igf { display: none; }

.item-count-text {
	position: absolute;
	right: 0;
	top: 1px;
	transform-origin: right top;
	white-space: nowrap;
	font-weight: bold;
	color: token(text-primary);
	font-effect: outline(1px #000000);
}

/* The window's live items: the panel and a margin round it, for a model reaching past its slot. */
.item-view { position: absolute; left: -20px; top: -20px; width: 230px; height: 469px; pointer-events: none; }

/* A tall grid's viewport (npc_shop, storage, storage_ext, inventory_extension: #grid_viewport round
   the grids, their items and counts): the whole panel on a PC, so nothing moves; a page of rows where
   the theme pages the grid (the phone view below). Its paging buttons (UI/Inventory/ItemGridScroll.h)
   show only there. */
.item-grid-viewport { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.item-grid-scroll { display: none; }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode). Item windows are laid
   out full height with finger-sized cells by their own sheets; here the parts they share: a corner
   close a finger can hit, the 15-row grids shown 8 rows at a time with ▲▼ paging (7 rows a page, one
   kept in sight), icon buttons 44 x 36 and the money and titles a size up. The viewport's 6px padding
   shows the grid's frame; the grid flows in it, so its height is what scrolls. Hit tests stop at the
   viewport's edge (DrawnGridGeometry()). Every window gives its buttons a top here. */
@media (theme: mobile) {
	#frame_corner_close { top: 0; right: 0; width: 44px; height: 40px; }

	.item-grid-viewport {
		overflow: hidden;
		padding: 6px;
		width: calc(8 * var(--item-cell));
		height: calc(8 * var(--item-cell));
	}
	/* A div is inline unless told otherwise; inline, the grid would ignore its width and height. */
	.item-grid-viewport #item_grid { display: block; position: relative; left: 0; top: 0; }
	.item-grid-viewport #item_grid_counts { left: 6px; top: 6px; }
	.item-grid-viewport #item_view {
		left: 0;
		top: 0;
		width: calc(8 * var(--item-cell) + 12px);
		height: calc(15 * var(--item-cell) + 12px);
	}

	.modern-icon-btn-px { bottom: auto; width: 44px; height: 36px; line-height: 36px; }
	.modern-icon-btn-glyph-px { font-size: 16px; }
	.item-grid-scroll { display: block; height: 44px; line-height: 44px; }

	.modern-header-title-px { font-size: 15px; }
	.modern-wallet-px { height: 24px; }
	.modern-wallet-label-px { font-size: 9px; }
	.modern-wallet-value-px { font-size: 12px; }
}
