/* Modern theme for CLootFilterWindow (the loot highlight filter's settings): window_shell's forged frame and header
   rail; the on switch and the presets on top, the scrolling settings in the content well, Close at the bottom.
   Segments, steppers and buttons in the dark-iron look of base.rcss's .btn (steel on hover, gold for what is picked).
   The phone view makes every control finger-sized. */

#panel {
	width: 480dp;
	height: 480dp;
	max-height: 96%;
	font-family: "token(font-body)";
	font-size: 12dp;
	color: token(text-primary);
}

/* The content: the top bar, the scrolling settings and the foot, one under the other. An ID selector, so it wins
   over window_shell.rcss's own .window-shell-content layout. */
#content {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	justify-content: flex-start;
	padding-left: 10dp;
	padding-right: 10dp;
	padding-bottom: 8dp;
}

.lf-top {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	flex-shrink: 0;
	padding: 4dp 0 6dp;
	border-bottom: 1dp rgba(255, 255, 255, 20);
}
.lf-presets {
	display: flex;
	flex-direction: row;
	align-items: center;
}
.lf-presets-label {
	margin-right: 4dp;
	color: token(text-secondary);
}

/* A stretched flex child bounds the scrolling settings (base.rcss's .scroll-pane). */
.lf-scroll {
	flex: 1 1 0;
	min-height: 0;
	padding: 4dp 8dp 4dp 2dp;
}
.lf-scroll.off .lf-row,
.lf-scroll.off .lf-check-row,
.lf-scroll.off .lf-name-entry,
.lf-scroll.off .lf-chips { opacity: 0.5; }

.lf-section {
	margin: 10dp 0 4dp;
	padding-bottom: 3dp;
	border-bottom: 1dp rgba(255, 255, 255, 20);
	color: token(accent-gold);
	font-weight: bold;
	letter-spacing: 1dp;
}

.lf-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 28dp;
	margin-bottom: 2dp;
}
.lf-row-label {
	flex: 1 1 auto;
	padding-right: 8dp;
	white-space: normal;
	color: token(text-primary);
}

/* Hide / Normal / Highlight: three joined boxes, the picked one lit. */
.lf-segments {
	display: flex;
	flex-direction: row;
	flex-shrink: 0;
}
.lf-seg {
	width: 80dp;
	height: 22dp;
	line-height: 22dp;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-muted);
	background-color: token(surface-recessed);
	border: 1dp token(border-frame);
	margin-left: -1dp;
}
.lf-seg:hover { color: token(text-primary); border-color: token(accent-steel-hover); }
.lf-seg.active { color: #ffffff; background-color: token(surface-raised); border-color: token(accent-steel-hover); }
.lf-seg-hide.active { background-color: rgba(120, 40, 34, 220); border-color: token(semantic-danger); }
.lf-seg-highlight.active { color: #fff8e6; background-color: rgba(196, 154, 60, 210); border-color: token(accent-gold-hover); }
.lf-seg.locked { opacity: 0.3; pointer-events: none; cursor: arrow; }

/* A checkbox and its label; the whole row takes the click. */
.lf-check-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 24dp;
	cursor: pointer;
	pointer-events: auto;
}
.lf-check-row .checkbox-box { flex-shrink: 0; }
.lf-check-label {
	margin-left: 8dp;
	white-space: normal;
	color: token(text-primary);
}
.lf-check-row:hover .checkbox-box { border-color: token(accent-steel-hover); }

.lf-stepper {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-shrink: 0;
}
.lf-step {
	width: 26dp;
	height: 22dp;
	line-height: 22dp;
	text-align: center;
	font-weight: bold;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-primary);
	background-color: token(surface-raised);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.lf-step:hover { border-color: token(accent-steel-hover); }
.lf-step:active { background-color: token(surface-recessed); }
.lf-step-value {
	width: 96dp;
	text-align: center;
	color: token(accent-gold);
}

/* Text buttons sized by their label. */
.lf-button {
	min-width: 64dp;
	height: 24dp;
	line-height: 24dp;
	padding: 0 8dp;
	margin-left: 4dp;
	text-align: center;
	white-space: nowrap;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-primary);
	background-color: token(surface-raised);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.lf-button:hover { border-color: token(accent-steel-hover); }
.lf-button:active { background-color: token(surface-recessed); }
.lf-button.disabled { opacity: 0.45; pointer-events: none; cursor: arrow; }

.lf-hint {
	margin-bottom: 4dp;
	white-space: normal;
	color: token(text-muted);
}
.lf-name-entry {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 4dp;
}
.lf-name-field {
	flex: 1 1 auto;
	height: 24dp;
	padding: 4dp 6dp 0;
}
.lf-chips {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.lf-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin: 0 4dp 4dp 0;
	padding: 0 8dp;
	cursor: pointer;
	pointer-events: auto;
	background-color: rgba(196, 154, 60, 60);
	border: 1dp token(accent-gold);
	border-radius: 11dp;
}
.lf-chip-text { color: token(text-primary); white-space: nowrap; }
.lf-chip-x { margin-left: 6dp; color: token(text-muted); font-weight: bold; }
.lf-chip:hover .lf-chip-x { color: token(semantic-danger); }

.lf-foot {
	display: flex;
	flex-direction: row;
	justify-content: center;
	flex-shrink: 0;
	padding-top: 6dp;
}
.lf-close { min-width: 100dp; margin-left: 0; }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode): the window nearly fills the screen,
   with larger text and finger-sized rows, segments, steppers, boxes and buttons (40 dp at least). */
@media (theme: mobile) {
	#panel { width: 640dp; max-width: 96%; height: 96%; font-size: 15dp; }
	.lf-row, .lf-check-row { min-height: 44dp; }
	.lf-seg { width: 96dp; height: 40dp; line-height: 40dp; }
	.lf-step { width: 44dp; height: 40dp; line-height: 40dp; }
	.lf-step-value { width: 120dp; }
	.lf-button { height: 40dp; line-height: 40dp; padding: 0 12dp; }
	.lf-name-field { height: 40dp; padding-top: 11dp; }
	.lf-chip { height: 40dp; padding: 0 12dp; border-radius: 20dp; }
	.checkbox-box { width: 24dp; height: 24dp; }
}
