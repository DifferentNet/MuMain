/* Modern theme for CMyInventory's chrome -- frame/header/wallet/action-row are vector forged-metal
   chrome (matching Login/SysMenu's forged-dialog language). Equipment board and bag grid stay
   fully native (sprite art + live 3D icons), same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}
/* The page tabs (BagPages.h) and the sort button (InventorySort.h) sit on the grid's top edge: the grid and the
   wallet move down 10 and the buttons 3 (6 above the groove instead of 9). The sort button shows without pages
   too, so the room is always there. */
#panel { --bag-tabs-shift: 10px; --bag-buttons-shift: 3px; }
#gold_bg { top: calc(366px + var(--bag-tabs-shift, 0px)); }
#gold_text { top: calc(371px + var(--bag-tabs-shift, 0px)); }
#panel .modern-icon-btn-px { bottom: calc(9px - var(--bag-buttons-shift, 0px)); }

/* Header uses base.rcss's .modern-header-rail-px/.modern-joint-px/.modern-header-text-px/
   .modern-header-title-px family -- the px companions of SysMenu's own
   dp-based classes (see base.rcss's comment on that class family for why a scaled
   #panel like this one needs the px variants, not the dp originals).

   top:7 matches SysMenu's own rail top exactly (so .modern-joint-px's rivet sits at the same -1px
   relative to the frame's shell-edge at -3px -- 2px contained clearance,
   identical relationship to SysMenu's). Only height is trimmed, 36 vs SysMenu's 38, because the
   native paperdoll grid starts at `m_Pos.y + 44` (MyInventory.cpp) -- ends at 43px, 1px clear. */
.inv-header-rail {
	top: 7px;
	height: 36px;
}

/* Drag handle -- pointer-events/drag are force-set in C++ by UI::RmlBridge::MakeDraggable();
   cursor here is purely cosmetic. Color/font come from .modern-header-title-px (shared with
   SysMenu's dp version). */
#title {
	cursor: move;
}

/* Wallet bar and action buttons use base.rcss's shared .modern-wallet-px/.modern-icon-btn-px
   family (generalized from this window's own original recipe -- see that file's comment) at their
   default geometry, which already matches this window exactly. Only per-instance specifics stay
   here: each button's own left offset, the exit button's warm-red accent, myshop's close-mode
   accent. */
.inv-btn-exit   { left: 15px;  color: #d59b79; border-color: #5c382b; }
.inv-btn-repair { left: 56px;  }
.inv-btn-myshop { left: 97px;  }
.inv-btn-myshop.close-mode { color: token(accent-gold-hover); border-color: token(border-hover); }
/* The jewel bank, where the expanded inventory's button was. */
.inv-btn-jewel-bank { left: 138px; }

/* Set/Socket option header labels -- gray/yellow match legacy since they're semantic
   (active vs. inactive), not part of modern's chrome palette. */
.option-label {
	position: absolute;
	top: 32px;
	width: 95px;
	height: 12px;
	text-align: center;
	font-family: "token(font-body)";
	font-weight: normal;
	font-size: 10px;
	color: #666666;
	pointer-events: auto;
	cursor: default;
}
.option-label.active { color: #ffcc1a; }
.option-label-set { left: 0; }
.option-label-socket { left: 95px; }

/* Native equipment slots, item grid and item-option tooltip: where CMyInventory places them, in
   #panel's units. A slot's box is its hit and drop area; the grid's top-left is its first cell;
   the tooltip anchor is the tooltip's top centre. */
.native-anchor { position: absolute; pointer-events: none; }
#slot_helper { left: 15px; top: 44px; width: 46px; height: 46px; }
#slot_helm { left: 75px; top: 44px; width: 46px; height: 46px; }
#slot_wing { left: 120px; top: 44px; width: 61px; height: 46px; }
#slot_weapon_left { left: 135px; top: 87px; width: 46px; height: 66px; }
#slot_armor { left: 75px; top: 87px; width: 46px; height: 66px; }
#slot_weapon_right { left: 15px; top: 87px; width: 46px; height: 66px; }
#slot_gloves { left: 15px; top: 150px; width: 46px; height: 46px; }
#slot_pants { left: 75px; top: 150px; width: 46px; height: 46px; }
#slot_boots { left: 135px; top: 150px; width: 46px; height: 46px; }
#slot_ring_left { left: 114px; top: 150px; width: 28px; height: 28px; }
#slot_amulet { left: 54px; top: 87px; width: 28px; height: 28px; }
#slot_ring_right { left: 54px; top: 150px; width: 28px; height: 28px; }
/* The slots: recessed boxes. */
.equip-slot { box-sizing: border-box; border: 1px token(border-inner); background-color: rgba(0, 0, 0, 90); }

/* A slot's state (CMyInventory::SyncSlotStates()): no-art where the class wears nothing there (a
   Dark Lord's helm, a Rage Fighter's gloves); its item's wear or unfitness as a tint inset 1 from the
   left and 4 from the right and bottom, as RenderEquippedItem() drew it; refused while the item on
   the cursor cannot go in. */
.equip-slot.no-art { background-color: transparent; border-color: transparent; }
/* Where the equipped item draws and the pointer hits it (CMyInventory), tinted by the slot's state. */
.equip-slot-item { position: absolute; left: 1px; top: 0; right: 3px; bottom: 4px; }
.equip-slot.broken .equip-slot-item, .equip-slot.unequipable .equip-slot-item { background-color: rgba(255, 0, 0, 64); }
.equip-slot.durability-20 .equip-slot-item { background-color: rgba(255, 38, 0, 64); }
.equip-slot.durability-30 .equip-slot-item { background-color: rgba(255, 128, 0, 64); }
.equip-slot.durability-50 .equip-slot-item { background-color: rgba(255, 255, 0, 64); }
.equip-slot.refused .equip-slot-item { background-color: rgba(230, 26, 26, 102); }
#item_grid, #item_grid_counts, #bag_lock { left: 15px; top: calc(200px + var(--bag-tabs-shift, 0px)); width: calc(8 * var(--item-cell)); height: calc(8 * var(--item-cell)); }

/* Bag page 2 while not bought (BagPages.h): a dark cover over the grid with three centred lines and
   the buy button. */
.bag-lock {
	position: absolute;
	background-color: rgba(0, 0, 0, 200);
	pointer-events: auto;
}
.bag-lock-line {
	position: absolute;
	left: 0;
	width: 100%;
	text-align: center;
	transform-origin: center top;
}
.bag-lock-title { top: 34px; font-weight: bold; color: #ffcc19; }
.bag-lock-cells { top: 54px; color: #c8c8c8; }
.bag-lock-price { top: 74px; font-weight: bold; color: #ffffff; }
.bag-lock-btn { left: 26px; top: 100px; width: 108px; height: 30px; line-height: 30px; }

/* The bag's page tabs on the grid's top edge, under the bottom row of slots (their boxes end at y 196): forged
   tabs whose bottom edge is the grid frame's top line; the shown page in the grid's recessed fill with a gold
   edge and number, open into the grid. Page 2 dimmer with a small padlock while it is not bought. */
.bag-tab {
	position: absolute;
	top: 197px;
	width: 30px;
	height: 12px;
	box-sizing: border-box;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	background-color: #13140f;
	decorator: linear-gradient(to bottom, #26251d, #15160f 56%, #090a08);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px token(radius-sm)px 0px 0px;
}
.bag-tab:hover { border-color: token(border-hover); border-bottom-color: token(border-frame); }
.bag-tab.active {
	background-color: token(surface-recessed);
	decorator: none;
	border-color: token(border-selected);
	border-bottom-color: token(surface-recessed);
}
.bag-tab-1 { left: 15px; }
.bag-tab-2 { left: 47px; }
.bag-tab-label {
	display: block;
	font-family: "token(font-body)";
	font-weight: bold;
	font-size: 9px;
	line-height: 10px;
	color: token(text-secondary);
	pointer-events: none;
}
.bag-tab:hover .bag-tab-label { color: token(text-primary); }
.bag-tab.locked .bag-tab-label { color: token(text-muted); }
.bag-tab.active .bag-tab-label { color: token(accent-gold); }
/* The padlock: a shackle over a body, in the label's colour. */
.bag-tab-lock { position: absolute; right: 3px; top: 1px; width: 5px; height: 7px; pointer-events: none; }
.bag-tab-lock-shackle {
	position: absolute;
	left: 1px;
	top: 0;
	width: 3px;
	height: 3px;
	box-sizing: border-box;
	border: 1px token(text-muted);
	border-bottom-width: 0;
}
.bag-tab-lock-body { position: absolute; left: 0; top: 3px; width: 5px; height: 4px; background-color: token(text-muted); }
.bag-tab.active .bag-tab-lock-shackle { border-color: token(accent-gold); }
.bag-tab.active .bag-tab-lock-body { background-color: token(accent-gold); }
/* The sort button (InventorySort.h): an idle tab at the grid's top right (x 145-175), three bars short to long in
   the page numbers' colour, lighter on hover; dimmed and deaf while it can't sort. */
#btn_bag_sort { left: 145px; }
.bag-sort.busy { pointer-events: none; filter: brightness(0.5); }
.bag-sort-icon { position: absolute; left: 50%; top: 50%; width: 10px; height: 7px; margin-left: -5px; margin-top: -4px; pointer-events: none; }
.bag-sort-bar { position: absolute; left: 0; height: 1px; background-color: token(text-secondary); }
.bag-sort-bar-1 { top: 0; width: 4px; }
.bag-sort-bar-2 { top: 3px; width: 7px; }
.bag-sort-bar-3 { top: 6px; width: 10px; }
.bag-sort:hover .bag-sort-bar { background-color: token(text-primary); }
#option_tooltip_anchor { left: 95px; top: 40px; }

/* The frame: values below are copied VERBATIM from sys_menu.rcss's #panel and base.rcss's
   .modern-shell-edge/.modern-groove (the unmodified defaults -- SysMenu doesn't override them,
   unlike Login's warmer .login-shell-edge/.login-groove tint) -- not approximated, so this frame
   is pixel/color-identical to SysMenu's, not just similar. If either source ever changes, update
   here too by copying the new literal values, not by eyeballing a new approximation. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

/* Outer blackened-iron edge, -3px -- base.rcss's .modern-shell-edge, unmodified. */
.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

/* Inner groove, ~4px inward -- base.rcss's .modern-groove, unmodified (no border-radius there
   either -- square inner corners is correct, matches SysMenu). */
.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .inv-header-rail (my_inventory.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 36px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested in .rail-fill so left/right/bottom resolve against it. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }


/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode), the full 432 height of
   the dock with finger-sized cells, as the legacy theme lays it out. Alone, the inventory spreads out:
   the equipment on the left in 70 px slots (rings and amulet 40) with the gold and the buttons under
   it, the bag on the right in 44 px cells. Beside another window of its column (#panel.beside, set
   by CMyInventory::SyncBesideNeighbour()) it keeps the bag alone in 42 px cells, the gold above it and
   the buttons down its right side, so the two fit a phone's width. --bag-x is the bag's left edge;
   the panel's width follows from it. Equipped items in hidden slots are not drawn. */
@media (theme: mobile) {
	#panel {
		--bag-x: 344px;
		--bag-right: 16px;
		--item-cell: 44px;
		width: calc(var(--bag-x) + 8 * var(--item-cell) + var(--bag-right));
		height: 432px;
	}
	#panel.beside { --bag-x: 16px; --bag-right: 68px; --item-cell: 42px; }
	.bg-panel { width: 100%; height: 432px; }
	#item_view { width: calc(100% + 40px); height: 472px; }

	/* The equipment: three columns of 70 px slots, the amulet and rings in the gaps between them. */
	#slot_helper { left: 20px; top: 72px; width: 70px; height: 70px; }
	#slot_helm { left: 135px; top: 72px; width: 70px; height: 70px; }
	#slot_wing { left: 220px; top: 72px; width: 100px; height: 70px; }
	#slot_weapon_right { left: 20px; top: 152px; width: 70px; height: 100px; }
	#slot_amulet { left: 93px; top: 152px; width: 40px; height: 40px; }
	#slot_armor { left: 135px; top: 152px; width: 70px; height: 100px; }
	#slot_weapon_left { left: 250px; top: 152px; width: 70px; height: 100px; }
	#slot_gloves { left: 20px; top: 262px; width: 70px; height: 70px; }
	#slot_ring_right { left: 93px; top: 262px; width: 40px; height: 40px; }
	#slot_pants { left: 135px; top: 262px; width: 70px; height: 70px; }
	#slot_ring_left { left: 208px; top: 262px; width: 40px; height: 40px; }
	#slot_boots { left: 250px; top: 262px; width: 70px; height: 70px; }

	.option-label { top: 48px; width: 150px; height: 16px; font-size: 12px; }
	.option-label-set { left: 20px; }
	.option-label-socket { left: 170px; }
	#option_tooltip_anchor { left: 170px; top: 64px; }

	/* The bag from the top; the gold and a row of 60 x 48 buttons under the equipment. */
	#item_grid, #item_grid_counts, #bag_lock { left: var(--bag-x); top: 50px; }
	.bag-lock-title { top: 110px; }
	.bag-lock-cells { top: 140px; }
	.bag-lock-price { top: 170px; }
	.bag-lock-btn { left: calc(50% - 80px); top: 210px; width: 160px; height: 44px; line-height: 44px; }
	/* The page tabs a finger wide, on the header rail's right over the bag, clear of the corner close; whole
	   plates here, as the grid has no room above it. */
	.bag-tab { top: 8px; width: 36px; height: 28px; border-radius: token(radius-sm)px; }
	.bag-tab.active { border-bottom-color: token(border-selected); }
	.bag-tab-1 { left: auto; right: 94px; }
	.bag-tab-2 { left: auto; right: 54px; }
	.bag-tab-label { font-size: 13px; line-height: 26px; }
	.bag-tab-lock { right: 4px; top: 4px; width: 7px; height: 9px; }
	.bag-tab-lock-shackle { left: 1px; width: 5px; height: 4px; }
	.bag-tab-lock-body { top: 4px; width: 7px; height: 5px; }
	/* The sort button left of the tabs on the rail, its bars bigger. */
	#btn_bag_sort { left: auto; right: 134px; }
	.bag-sort-icon { width: 18px; height: 12px; margin-left: -9px; margin-top: -6px; }
	.bag-sort-bar { height: 2px; }
	.bag-sort-bar-1 { width: 7px; }
	.bag-sort-bar-2 { top: 5px; width: 12px; }
	.bag-sort-bar-3 { top: 10px; width: 18px; }
	#gold_bg { left: 20px; top: 340px; width: 300px; }
	#gold_text { left: 202px; right: auto; top: 345px; }
	#panel .modern-icon-btn-px { top: 372px; width: 60px; height: 48px; line-height: 48px; }
	.inv-btn-exit { left: 20px; }
	.inv-btn-repair { left: 100px; }
	.inv-btn-myshop { left: 180px; }
	.inv-btn-jewel-bank { left: 260px; }

	/* Beside another window: the bag alone under the gold, the buttons down its right side, 44 x 36. */
	#panel.beside .equip-slot, #panel.beside .option-label { display: none; }
	#panel.beside #gold_bg { left: var(--bag-x); top: 46px; width: calc(8 * var(--item-cell)); }
	#panel.beside #gold_text { left: calc(var(--bag-x) + 8 * var(--item-cell) - 118px); top: 51px; }
	#panel.beside #item_grid, #panel.beside #item_grid_counts, #panel.beside #bag_lock { top: 78px; }
	#panel.beside .modern-icon-btn-px {
		left: calc(var(--bag-x) + 8 * var(--item-cell) + 12px);
		width: 44px;
		height: 36px;
		line-height: 36px;
	}
	#panel.beside .inv-btn-exit { top: 78px; }
	#panel.beside .inv-btn-repair { top: 124px; }
	#panel.beside .inv-btn-myshop { top: 170px; }
	#panel.beside .inv-btn-jewel-bank { top: 216px; }
	/* The sort button joins them, under the jewel bank. */
	#panel.beside #btn_bag_sort { left: calc(var(--bag-x) + 8 * var(--item-cell) + 12px); right: auto; top: 262px; width: 44px; height: 36px; }
}
