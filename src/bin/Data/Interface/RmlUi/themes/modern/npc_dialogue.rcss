/* Modern theme for CNPCDialogue -- #panel/shell-edge/groove/header-rail fill come from
   docked_panel_frame.rcss, shared with character_info/my_quest_info/pet_info/party_info/
   quest_progress -- see that file's own header comment. L/R pagination arrows reuse legacy's own
   sprites (theme-local duplication), same reasoning quest_progress.rcss's modern fork already uses
   for this exact asset -- dialogue-specific navigation with no generic modern equivalent. */
@spritesheet nd-btn-l-sheet { src: "../../../Quest_bt_L.tga"; nd-btn-l: 0px 0px 17px 18px; }
@spritesheet nd-btn-r-sheet { src: "../../../Quest_bt_R.tga"; nd-btn-r: 0px 0px 17px 18px; }
@spritesheet nd-contribute-sheet { src: "../../../Gens_point.tga"; nd-contribute-img: 0px 0px 168px 18px; }

/* No explicit display -- see the legacy theme's own .nd-contribute comment for why (base.rcss's
   .hidden must win the cascade uncontested). */
.nd-contribute {
	position: absolute;
	left: 11px;
	top: 27px;
	width: 168px;
	height: 18px;
	text-align: center;
	color: token(text-primary);
	font-size: 12px;
	line-height: 18px;
	decorator: image(nd-contribute-img);
}

.nd-npc-lines {
	position: absolute;
	left: 13px;
	top: 59px;
	width: 164px;
}
.nd-line {
	display: block;
	color: token(text-primary);
	font-size: 12px;
	white-space: nowrap;
}

.nd-divider {
	position: absolute;
	left: 0;
	top: 181px;
	width: 190px;
	height: 21px;
	border-top: 1dp token(border-frame);
}

.nd-btn-l, .nd-btn-r {
	position: absolute;
	width: 17px;
	height: 18px;
	cursor: pointer;
	pointer-events: auto;
}
.nd-btn-l { left: 131px; decorator: image(nd-btn-l); }
.nd-btn-r { left: 153px; decorator: image(nd-btn-r); }
.nd-btn-npc { top: 165px; }
.nd-btn-ans { top: 372px; }
.nd-btn-l:hover, .nd-btn-r:hover { filter: brightness(1.25); }
.nd-btn-l.locked, .nd-btn-r.locked { filter: brightness(0.6); }

.nd-answers {
	position: absolute;
	left: 13px;
	top: 207px;
	width: 164px;
}
.nd-answer-row {
	display: block;
	color: token(text-primary);
	font-size: 12px;
	white-space: pre-line;
	cursor: pointer;
	pointer-events: auto;
	margin-bottom: 2px;
}
.nd-answer-row:hover { background-color: token(surface-panel); color: token(accent-gold-hover); }

/* .modern-icon-btn-px sets top:392px but leaves left unset (every window supplies its own) -- same
   13px left quest_progress.rcss's own .qp-btn-exit uses, matching the legacy #btn_exit box exactly. */
.nd-btn-exit { left: 13px; }

/* MU Moldova: the phone view (theme flag "mobile"): the window is 300 units wide with 16-unit text, the
   answers are rows a finger can hit, and the page arrows and the exit grow to finger size (legacy's
   layout, themes/legacy/npc_dialogue.rcss). The text areas take the lines' size, as NPCDialogue.cpp
   wraps at their width at their own text size. It counts the lines a page holds from the line height and
   the room above each area's next arrow, not the answer rows' padding, so a page of answers can be taller
   than its area: both areas scroll by finger, with a slim bar showing where they are. */
@media (theme: mobile) {
	#panel { width: 300px; }
	.nd-contribute { left: 66px; }

	/* --- The NPC's text: five 22-unit lines under the header, then its arrows beside the divider --- */
	.nd-npc-lines { top: 50px; height: 110px; }
	.nd-btn-npc { top: 162px; }
	.nd-divider { top: 182px; width: 188px; }

	/* --- The answers: four 44-unit rows, then their arrows level with the exit --- */
	.nd-answers { top: 206px; height: 176px; }
	.nd-btn-ans { top: 384px; }
	.nd-btn-exit { width: 42px; height: 38px; bottom: 5px; line-height: 38px; }

	/* --- The arrows: 43 x 40 boxes at the right, the sprite in the middle (the decorator paints the
	   content box alone) --- */
	.nd-btn-l, .nd-btn-r { padding: 11px 13px; }
	.nd-btn-l { left: 192px; decorator: image(nd-btn-l) content-box; }
	.nd-btn-r { left: 236px; decorator: image(nd-btn-r) content-box; }

	.nd-npc-lines, .nd-answers {
		width: 256px;
		padding-right: 8px;
		font-size: 16px;
		line-height: 22px;
		overflow: hidden auto;
		pointer-events: auto;
	}
	.nd-line, .nd-answer-row { font-size: 16px; }
	/* NPCDialogue.cpp has already broken an answer into its lines, so the row keeps them as they are. */
	.nd-answer-row {
		width: 256px;
		padding: 9px 0;
		border-bottom-width: 1px;
		border-bottom-color: token(border-inner);
		margin-bottom: 3px;
		white-space: pre;
	}
	.nd-npc-lines scrollbarvertical, .nd-answers scrollbarvertical { width: 4px; }
	.nd-npc-lines scrollbarvertical slidertrack, .nd-answers scrollbarvertical slidertrack {
		background-color: token(metal-rail-dark);
	}
	.nd-npc-lines scrollbarvertical sliderbar, .nd-answers scrollbarvertical sliderbar {
		min-height: 24px;
		background-color: token(metal-edge);
	}
	.nd-npc-lines scrollbarvertical sliderarrowdec, .nd-npc-lines scrollbarvertical sliderarrowinc,
	.nd-answers scrollbarvertical sliderarrowdec, .nd-answers scrollbarvertical sliderarrowinc { height: 0; }
}

