/* Modern theme for what the gamepad shows over the world and its windows (pad_overlay.rml): a gold
   frame on the target the pad is on, the hero hub's tabs and the pad's buttons at the screen's top,
   and the pickup prompt under a drop. Only the pad works it: nothing here takes the pointer. */

body, body * {
	pointer-events: none;
}

/* The pad glyphs (gamepad_glyphs.rcss) are sized in rem: here one is one dp. */
body {
	font-size: 1dp;
	font-family: "token(font-body)";
	color: token(text-primary);
	font-effect: shadow(0dp 1dp #000000);
}

#po_frame {
	position: absolute;
	box-sizing: border-box;
	border: 3dp token(accent-gold);
	border-radius: 3dp;
	/* A dark rim outside the gold: the frame shows on bright cells and bright items too (pad round 3). */
	box-shadow: 0 0 0 1dp rgba(0, 0, 0, 200);
}

/* A slow pulse of the fill, on its own element: the frame's shadow keeps its texture (a shadow
   redraws whenever its element's background changes). */
#po_frame_fill {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(242, 194, 48, 28);
	animation: 0.9s quadratic-in-out infinite alternate po-frame-pulse;
}

@keyframes po-frame-pulse {
	from { background-color: rgba(242, 194, 48, 18); }
	to { background-color: rgba(242, 194, 48, 64); }
}

/* The prompt's point is the drop's foot: the prompt stands centred just under it. */
#po_prompt {
	position: absolute;
	width: 0;
	height: 0;
}
#po_prompt_inner {
	position: absolute;
	left: -80dp;
	top: 6dp;
	width: 160dp;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	font-size: 15dp;
}
#po_prompt_inner .pad-glyph {
	position: relative;
}

#po_top {
	position: absolute;
	left: 0;
	right: 0;
	top: 6dp;
	padding: 0 6dp;
	display: flex;
	flex-direction: column;
	align-items: center;
}
#po_tabs, #po_legend, #po_characters {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
	align-items: center;
	max-width: 100%;
	padding: 4dp 10dp;
	border: 1dp token(border-frame);
	border-radius: 6dp;
	background-color: rgba(6, 7, 6, 230);
}
#po_tabs {
	margin-bottom: 4dp;
	font-size: 15dp;
}
#po_legend, #po_characters {
	font-size: 14dp;
}
#po_top .pad-glyph {
	position: relative;
}
.po-tab {
	margin: 0 5dp;
	padding: 2dp 4dp;
	color: token(text-secondary);
	line-height: 20dp;
}
.po-tab.active {
	color: token(accent-gold);
	border-bottom: 2dp token(accent-gold);
}
/* A button and its label wrap to the next line together. */
.po-pair {
	display: flex;
	flex-direction: row;
	align-items: center;
}
.po-label {
	margin: 0 12dp 0 5dp;
	line-height: 22dp;
}

/* The controls card (pad round 3, B4): in the middle of the screen, clear of the hub's tabs along the
   top and the pad's row along the bottom. */
#po_card {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 640dp;
	margin-left: -320dp;
	margin-top: -170dp;
	padding: 10dp 14dp;
	box-sizing: border-box;
	border: 1dp token(border-frame);
	border-radius: 4dp;
	background-color: rgba(6, 7, 6, 235);
	font-size: 13dp;
}
#pc_head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8dp;
}
#pc_title {
	font-size: 16dp;
	color: token(accent-gold);
}
#pc_pages {
	display: flex;
	flex-direction: row;
}
.pc-page {
	margin-left: 8dp;
	padding: 1dp 6dp;
	color: rgba(242, 242, 242, 150);
}
.pc-page.active {
	color: token(accent-gold);
	border-bottom: 2dp token(accent-gold);
}
.pc-body {
	display: flex;
	flex-direction: row;
	height: 252dp;
}
.pc-col {
	width: 50%;
}
.pc-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 30dp;
}
.pc-keys {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	width: 104dp;
	margin-right: 8dp;
}
.pc-keys .pad-glyph, #pc_foot .pad-glyph {
	position: relative;
	margin-left: 2dp;
}
.pc-plus {
	margin: 0 2dp;
}
.pc-label {
	line-height: 15dp;
}
#pc_foot {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 4dp;
}
/* The phone view: the card fills the screen's width. */
@media (theme: mobile) {
	#po_card {
		left: 8dp;
		width: auto;
		right: 8dp;
		margin-left: 0;
		font-size: 11dp;
	}
	.pc-keys { width: 92dp; }
}
