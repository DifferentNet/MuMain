/* Modern theme for CStorageInventory's chrome -- header/wallet/action-row are vector forged-metal
   chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language). Inventory grid
   stays fully native (sprite art + live 3D icons), same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:6/height:29 -- identical budget to storage_ext.rcss's .storext-header-rail: this window's
   native grid also starts at `m_Pos.y + 36` (StorageInventory.cpp's CInventoryCtrl::Create()
   call), the same tight budget as Storage Ext (both are 190x429 VAULT-family frames). Ends at
   35px, 1px clear. Keeps .modern-joint-px's rivet at -2px, inside the frame's
   .inv-shell-edge at -3px -- same contained relationship as StorageExt/MyInventory/SysMenu. */
.stor-header-rail {
	top: 6px;
	height: 29px;
}
/* The title a bit further left and without letter spacing, so "Хранилище 10/10" (Liberation Sans 13 px, ~106 px
   wide: x 15-121; "Storage 10/10" ~81 px: x 15-96) ends left of the page arrows at 127. */
.stor-header-rail .modern-header-text-px { left: 7px; }
.stor-header-rail .modern-header-title-px { letter-spacing: 0px; }

/* Wallet bar heightened to fit both the Zen balance (top row) and the Storage Fee line
   CStorageInventory::RenderText() used to draw -- left/width stay the shared default (15/160). */
.stor-wallet-px {
	top: 342px;
	height: 46px;
}
/* Override just the shared value text's top for the Zen row -- its default top:371px already
   lines up with the Fee row below, so #fee_value reuses .modern-wallet-value-px unmodified. */
#zen_text {
	top: 349px;
}
/* Default top:50% centers these on the whole heightened 46px box (both Zen+Fee rows), not just
   the Zen row -- pin to the same ~7px offset #zen_text uses instead. */
.stor-wallet-px .modern-wallet-coin-px,
.stor-wallet-px .modern-wallet-label-px {
	top: 11px;
	margin-top: -4px;
}
.stor-fee-label-px {
	position: absolute;
	left: 25px;
	top: 371px;
	color: token(semantic-danger);
	font-size: 9px;
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}

/* Action row: base.rcss's shared .modern-icon-btn-px family (26 high, top:392); base.rcss's own
   comment on this class family names Storage explicitly as a consumer. Five slots with the sort
   button (InventorySort.h), so 29 wide with a 3 px gap: 15/47/79/111/143, ending at 172, clear of
   the frame's right edge (190). */
.stor-btn-insert, .stor-btn-take, .stor-btn-lock, .stor-btn-expand, .stor-sort-btn { width: 29px; }
.stor-btn-insert { left: 15px;  }
.stor-btn-take   { left: 47px;  }
.stor-btn-lock   { left: 79px;  }
.stor-btn-lock.locked-mode { color: token(accent-gold-hover); border-color: token(border-hover); }
.stor-btn-expand { left: 111px; }
.stor-sort-btn   { left: 143px; }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 36px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .stor-header-rail (storage.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 6px;
	height: 29px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* The vault page arrows on the header rail's right (VaultPages.h), after the left-aligned title and
   clear of the corner close (x 163-187): small forged buttons with a triangle, x 127-143 and 145-161.
   Dimmed while a switch or a sort waits or an item is held. */
.stor-page-btn {
	position: absolute;
	top: 14px;
	width: 16px;
	height: 18px;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 18px;
	color: token(text-secondary);
	background-color: #13140f;
	decorator: linear-gradient(to bottom, #26251d, #15160f 56%, #090a08);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.stor-page-btn:hover { color: token(accent-gold-hover); border-color: token(border-hover); }
.stor-page-btn.hidden { display: none; }
.stor-page-btn.busy { pointer-events: none; filter: brightness(0.5); }
.stor-page-prev { left: 127px; }
.stor-page-next { left: 145px; }
.stor-page-glyph {
	font-family: "DejaVu Sans";
	font-size: 9px;
	pointer-events: none;
}
/* The sort button (InventorySort.h) in the action row (above): three bars short to long; dimmed and deaf
   while it can't sort. */
.stor-sort-btn.busy { pointer-events: none; filter: brightness(0.5); }
.stor-sort-icon { position: absolute; left: 50%; top: 50%; width: 10px; height: 7px; margin-left: -5px; margin-top: -4px; pointer-events: none; }
.stor-sort-bar { position: absolute; left: 0; height: 1px; background-color: token(text-secondary); }
.stor-sort-bar-1 { top: 0; width: 4px; }
.stor-sort-bar-2 { top: 3px; width: 7px; }
.stor-sort-bar-3 { top: 6px; width: 10px; }
.stor-sort-btn:hover .stor-sort-bar { background-color: token(accent-gold-hover); }

/* MU Moldova: the phone view (theme flag "mobile", UI::Mobile::InterfaceMode), as the legacy theme
   lays it out: the full 432 height of the dock, 42 px cells, 8 of the 15 rows on view
   (item_grid.rcss pages them), the ▲▼ and the buttons down the right side, the money and the fee
   under the grid, the vault page arrows a finger wide in the header. 420 wide, so the bag-only
   inventory fits beside it on a phone. */
@media (theme: mobile) {
	#panel { --item-cell: 42px; width: 420px; height: 432px; }
	.bg-panel { width: 100%; height: 432px; }
	.stor-page-btn { top: 6px; width: 32px; height: 28px; line-height: 28px; }
	.stor-page-prev { left: 296px; }
	.stor-page-next { left: 334px; }
	.stor-page-glyph { font-size: 13px; }
	/* The sort button as big as them, left of them in the header (the action row runs down the right side
	   here, its four buttons back to their own 37 width). */
	.stor-btn-insert, .stor-btn-take, .stor-btn-lock, .stor-btn-expand { width: 37px; }
	.stor-sort-btn { left: 258px; top: 6px; bottom: auto; width: 32px; height: 28px; }
	.stor-sort-icon { width: 18px; height: 12px; margin-left: -9px; margin-top: -6px; }
	.stor-sort-bar { height: 2px; }
	.stor-sort-bar-1 { width: 7px; }
	.stor-sort-bar-2 { top: 5px; width: 12px; }
	.stor-sort-bar-3 { top: 10px; width: 18px; }

	/* The grid's first cell at (16, 42). */
	#grid_viewport { left: 10px; top: 36px; }
	.grid-scroll-up { left: 364px; top: 42px; }
	.grid-scroll-down { left: 364px; top: calc(42px + 8 * var(--item-cell) - 44px); }
	.stor-btn-insert, .stor-btn-take, .stor-btn-lock, .stor-btn-expand { left: 364px; }
	.stor-btn-insert { top: 98px; }
	.stor-btn-take { top: 144px; }
	.stor-btn-lock { top: 190px; }
	.stor-btn-expand { top: 236px; }

	.stor-wallet-px { left: 16px; top: 388px; width: 336px; height: 40px; }
	#zen_text { left: 234px; right: auto; top: 392px; }
	.stor-fee-label-px { left: 26px; top: 410px; font-size: 10px; }
	#fee_value { left: 234px; right: auto; top: 410px; }
}
