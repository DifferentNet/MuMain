/* Modern theme for CTitlesWindow (the titles): docked_panel_frame.rcss's forged panel (linked first) at the full
   dock height, the modern exit button and the GM panel's forged tab buttons (gm_panel.rcss). Geometry is the legacy
   one: reference px inside #panel, physical px (reference px times --root-scale) inside the list's pane. */

#panel { height: 432px; pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; transform-origin: left top; }

#btn_exit {
	position: absolute;
	left: 13px;
	top: 392px;
	width: 36px;
	height: 28px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
#btn_exit:hover { border-color: token(accent-steel-hover); }

.tt-title { left: 0; top: 12px; text-align: center; font-weight: bold; pointer-events: none; }
#tt_status { left: 12px; top: 32px; font-weight: bold; pointer-events: none; }
#tt_detail { left: 12px; top: 47px; pointer-events: none; }

#tt_body { left: 12px; top: 64px; --flow-w: 166px; line-height: 1.12; }

.tt-tabs {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: calc(3px * var(--root-scale));
}
.tt-tab {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: calc(82px * var(--root-scale));
	height: calc(18px * var(--root-scale));
	cursor: pointer;
	pointer-events: auto;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.tt-tab:hover { border-color: token(accent-steel-hover); }
.tt-tab:active { background-color: token(surface-recessed); }
.tt-tab.on { background-color: token(surface-recessed); border-color: token(accent-gold); }
.tt-tab-label { display: block; white-space: nowrap; pointer-events: none; }

.tt-list { display: block; width: 100%; height: calc(298px * var(--root-scale)); }
.tt-row {
	display: block;
	box-sizing: border-box;
	width: calc(100% - 17px * var(--root-scale));
	padding: calc(2px * var(--root-scale)) calc(4px * var(--root-scale));
	margin-bottom: calc(1px * var(--root-scale));
	border-radius: token(radius-sm)px;
	cursor: arrow;
	pointer-events: auto;
}
.tt-row.owned { cursor: pointer; }
.tt-row-name { display: block; white-space: nowrap; font-weight: bold; pointer-events: none; }
.tt-row-line { display: flex; flex-direction: row; justify-content: space-between; pointer-events: none; }
.tt-row-detail { display: block; white-space: nowrap; pointer-events: none; }
.tt-row-mark { display: block; white-space: nowrap; font-weight: bold; pointer-events: none; }
.tt-row-hint {
	display: block;
	white-space: normal;
	line-height: 1.1;
	margin-top: calc(1px * var(--root-scale));
	pointer-events: none;
}
.tt-footer {
	display: block;
	box-sizing: border-box;
	width: calc(100% - 17px * var(--root-scale));
	padding: calc(4px * var(--root-scale)) calc(4px * var(--root-scale)) 0;
	white-space: normal;
	line-height: 1.1;
	pointer-events: none;
}

/* A title's name is its plate's colour (the same in both themes: it is the plate's); one not owned yet is dimmed. */
.tt-title { color: token(accent-gold); }
#tt_status { color: token(text-primary); }
#tt_detail { color: token(text-muted); }
.tt-tab-label { color: token(text-secondary); }
.tt-tab.on .tt-tab-label { color: token(accent-gold); }
.tt-row-name { opacity: 0.5; }
.tt-row.owned .tt-row-name { opacity: 1; }
.tt-row.owned:hover { background-color: rgba(255, 255, 255, 12); }
.tt-row.worn, .tt-row.worn:hover { background-color: rgba(255, 200, 90, 40); }
.tt-row.none .tt-row-name { color: token(text-primary); }
.tt-row.r0 .tt-row-name { color: rgb(200, 205, 215); }
.tt-row.r1 .tt-row-name { color: rgb(130, 200, 255); }
.tt-row.r2 .tt-row-name { color: rgb(110, 230, 150); }
.tt-row.r3 .tt-row-name { color: rgb(255, 210, 90); }
.tt-row.r4 .tt-row-name { color: rgb(255, 110, 90); }
.tt-row.r5 .tt-row-name { color: rgb(200, 150, 255); }
.tt-row-detail { color: token(text-muted); }
.tt-row.owned .tt-row-detail { color: token(text-secondary); }
.tt-row-mark { color: token(accent-gold); }
.tt-row-hint { color: token(text-muted); }
.tt-footer { color: token(text-secondary); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#tt_title { width: calc(100% * var(--root-scale)); }
#tt_status, #tt_detail { width: calc(166px * var(--root-scale)); }
