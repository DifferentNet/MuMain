/* Modern theme for the on-screen controls of phones and tablets (touch_controls.rml). C++ reads the
   buttons' boxes to know which a finger landed on, so where a rule puts a button is where it
   answers. Nothing takes the pointer: the fingers come through Core::Input::Touch. */

/* One rem is one finger unit (UI::Mobile::TouchUnit, which sets the document's font size to it):
   the controls are as big as a thumb needs on any screen, whatever the game's resolution. Only
   what lines up with the PC-sized HUD stays in dp: the top row starts right of the location bar,
   the hero frame lies under it. 1dp until C++ sets the unit. */
body {
	font-size: 1dp;
}

#tc_stick, #tc_stick_idle, #tc_stick_base, #tc_quick, #tc_menu_backdrop, #tc_menu_panel, .tc-button, .tc-button *,
#tc_menu_legend, #tc_menu_legend *, #tc_picker_backdrop, #tc_picker, #tc_picker *, #tc_social_backdrop,
#tc_social_panel, #tc_social_panel * {
	pointer-events: none;
}

.tc-button {
	position: absolute;
	box-sizing: border-box;
	border: 2rem rgba(214, 210, 198, 70);
	background-color: rgba(6, 7, 6, 120);
	color: token(text-primary);
	font-family: "token(font-body)";
	font-size: 13rem;
	font-effect: shadow(0rem 1rem #000000);
	text-align: center;
}

/* The joystick's area: the bottom-left corner, under the potions. */
#tc_stick {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 36%;
	height: 64%;
}
#tc_stick_idle {
	position: absolute;
	left: 44rem;
	bottom: 44rem;
	width: 128rem;
	height: 128rem;
	border: 2rem rgba(214, 210, 198, 50);
	border-radius: 64rem;
	background-color: rgba(6, 7, 6, 50);
}
.tc-stick-idle-knob {
	position: absolute;
	left: 34rem;
	top: 34rem;
	width: 56rem;
	height: 56rem;
	border-radius: 28rem;
	background-color: rgba(214, 210, 198, 50);
}
/* A point at the finger's landing place; the ring centres on it, the knob is offset from it. */
#tc_stick_base {
	position: absolute;
	width: 0;
	height: 0;
}
.tc-stick-ring {
	position: absolute;
	left: -64rem;
	top: -64rem;
	width: 128rem;
	height: 128rem;
	box-sizing: border-box;
	border: 2rem rgba(196, 154, 60, 140);
	border-radius: 64rem;
	background-color: rgba(6, 7, 6, 70);
}
#tc_stick_knob {
	position: absolute;
	width: 56rem;
	height: 56rem;
	margin-left: -28rem;
	margin-top: -28rem;
	border-radius: 28rem;
	background-color: rgba(196, 154, 60, 170);
}

/* One row along the top, right of the location bar (207dp): the chat log's lines start at the
   top left on a phone and are drawn over the controls. It ends short of the page's own menu button
   (index.html's ⋮, 56 CSS pixels from the right); where the screen is too narrow for the row, its
   buttons narrow. */
#tc_quick {
	position: absolute;
	z-index: 2;
	left: 214dp;
	right: 72rem;
	top: 4rem;
	display: flex;
	gap: 4rem;
}
.tc-quick {
	position: relative;
	width: 72rem;
	min-width: 44rem;
	flex-shrink: 1;
	height: 36rem;
	line-height: 32rem;
	font-size: 12rem;
	border-radius: 6rem;
	overflow: hidden;
	white-space: nowrap;
}
#tc_menu.open, #tc_social.open {
	border-color: token(accent-gold);
}
/* The row's first button folds the rest of it away and back (config.ini [UI] TouchTopRow): three lines
   like the pad's Menu glyph, no text, gold-edged while the row shows. Folded, it stays alone. */
#tc_quick_toggle {
	position: relative;
	flex: 0 0 auto;
	width: 36rem;
	height: 36rem;
	border-radius: 6rem;
}
#tc_quick_toggle.open {
	border-color: token(accent-gold);
}
.tc-toggle-line {
	position: absolute;
	left: 8rem;
	width: 16rem;
	height: 2rem;
	border-radius: 1rem;
	background-color: token(text-primary);
}
.tc-toggle-line-1 { top: 9rem; }
.tc-toggle-line-2 { top: 15rem; }
.tc-toggle-line-3 { top: 21rem; }
#tc_quick.collapsed .tc-quick {
	display: none;
}

/* The screen around the open menu, dimmed; a tap there closes it. Over the other controls, which
   take no finger while the menu is open, under the top row and the menu. */
#tc_menu_backdrop {
	position: absolute;
	z-index: 1;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 90);
}

/* Under the row, centred: six columns of three, fewer where the screen is narrow. */
#tc_menu_panel {
	position: absolute;
	z-index: 2;
	left: 0;
	right: 0;
	top: 46rem;
	width: 652rem;
	max-width: 96%;
	margin: 0 auto;
	padding: 8rem;
	box-sizing: border-box;
	display: flex;
	flex-wrap: wrap;
	gap: 6rem;
	border: 1rem token(border-frame);
	border-radius: 6rem;
	background-color: rgba(6, 7, 6, 215);
}
.tc-menu-item {
	position: relative;
	width: 100rem;
	height: 38rem;
	padding: 0 4rem;
	border-radius: 4rem;
	display: flex;
	align-items: center;
	justify-content: center;
}
/* A long label (Russian "Боевой пропуск", "Вид ПК / телефон") takes two lines inside its button. */
.tc-menu-label {
	line-height: 15rem;
	text-align: center;
}
/* A switch that is on (PK): lit like Auto while the helper runs. */
.tc-menu-item.on {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 120);
}
/* The window a pad points at (its stick or d-pad move it, A opens it). */
.tc-menu-item.focused {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 80);
}
/* With a pad, its keys for the menu along the panel's foot. */
#tc_menu_legend {
	display: none;
	width: 100%;
	height: 22rem;
	padding-top: 2rem;
	flex-direction: row;
	align-items: center;
	color: token(text-primary);
	font-family: "token(font-body)";
	font-size: 12rem;
	font-effect: shadow(0rem 1rem #000000);
}
body.pad #tc_menu_legend {
	display: flex;
}
#tc_menu_legend .pad-glyph {
	position: relative;
}
.pad-legend-label {
	margin: 0 14rem 0 6rem;
	line-height: 20rem;
}

/* The skill picker (where the skill buttons are set): a panel over the left of the dimmed screen,
   the skill buttons lit right of it over the backdrop, the one being set in gold, the pad's
   highlight white. C++ measures the grid and its first entry for how many skills a page holds:
   the grid's gap is PickGapUnits in TouchControls.cpp. */
#tc_picker_backdrop {
	position: absolute;
	z-index: 1;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 120);
}
body.picking #tc_quick {
	z-index: 0;
}
body.picking #tc_bind_hint {
	display: none;
}
body.picking .tc-skill {
	z-index: 2;
	opacity: 1;
}
body.picking .tc-skill.selected {
	border-color: rgba(214, 210, 198, 70);
}
body.picking .tc-skill.target {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 110);
	box-shadow: 0 0 10rem 2rem rgba(196, 154, 60, 200);
}
body.picking .tc-skill.focused {
	border-color: rgba(255, 255, 255, 235);
}
#tc_picker {
	position: absolute;
	z-index: 3;
	left: 8rem;
	top: 8rem;
	right: 244rem;
	bottom: 8rem;
	padding: 8rem;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	border: 1rem token(border-frame);
	border-radius: 6rem;
	background-color: rgba(6, 7, 6, 225);
	color: token(text-primary);
	font-family: "token(font-body)";
	font-size: 13rem;
	font-effect: shadow(0rem 1rem #000000);
}
/* The pad's hero hub on its Skills tab: its tabs stand over the top of the screen. */
body.under-hub #tc_picker {
	top: 48dp;
}
#tc_pick_head, #tc_pick_hint_row, #tc_pick_pager {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6rem;
}
#tc_pick_head {
	flex-shrink: 0;
	height: 34rem;
}
#tc_pick_title {
	flex: 1 1 0;
	font-size: 15rem;
	color: token(accent-gold-hover);
	white-space: nowrap;
	overflow: hidden;
}
.tc-pick-button {
	position: relative;
	flex-shrink: 0;
	width: 84rem;
	height: 32rem;
	line-height: 28rem;
	border-radius: 6rem;
	white-space: nowrap;
	overflow: hidden;
}
#tc_pick_done {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 90);
}
#tc_pick_hint_row {
	flex-shrink: 0;
	min-height: 34rem;
}
#tc_pick_hint {
	flex: 1 1 0;
	font-size: 12rem;
	line-height: 15rem;
}
#tc_pick_pager {
	flex-shrink: 0;
	gap: 4rem;
}
.tc-pick-page {
	position: relative;
	width: 36rem;
	height: 32rem;
	line-height: 28rem;
	font-size: 15rem;
	border-radius: 6rem;
}
#tc_pick_page {
	min-width: 38rem;
	font-size: 12rem;
	text-align: center;
}
#tc_pick_grid {
	flex: 1 1 0;
	min-height: 0;
	margin-top: 4rem;
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: 6rem;
	overflow: hidden;
}
.tc-pick {
	position: relative;
	width: 112rem;
	height: 48rem;
	border-width: 1rem;
	border-radius: 6rem;
	text-align: left;
}
.tc-pick-icon {
	left: 6rem;
	top: 5rem;
}
/* Up to three lines right of the icon: a long name breaks inside its words. */
.tc-pick-name {
	position: absolute;
	left: 36rem;
	right: 4rem;
	top: 1rem;
	bottom: 1rem;
	display: flex;
	align-items: center;
	font-size: 11rem;
	line-height: 13rem;
	word-break: break-word;
	overflow: hidden;
}
/* On one of the skill buttons already: a gold dot in the corner. */
.tc-pick-mark {
	display: none;
	position: absolute;
	right: 3rem;
	bottom: 3rem;
	width: 7rem;
	height: 7rem;
	border-radius: 4rem;
	background-color: token(accent-gold-hover);
}
.tc-pick.on {
	border-color: rgba(196, 154, 60, 150);
}
.tc-pick.on .tc-pick-mark {
	display: block;
}
/* On the button being set. */
.tc-pick.here {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 110);
}
.tc-pick.focused, .tc-pick-button.focused, .tc-pick-page.focused {
	border-color: rgba(255, 255, 255, 235);
	background-color: rgba(255, 255, 255, 40);
}
#tc_pick_none {
	width: 100%;
	padding-top: 40rem;
	color: token(text-secondary);
	text-align: center;
}
#tc_pick_tip {
	flex-shrink: 0;
	padding-top: 4rem;
	color: token(text-secondary);
	font-size: 11rem;
	line-height: 14rem;
}
#tc_pick_legend {
	display: none;
	flex-shrink: 0;
	height: 22rem;
	padding-top: 2rem;
	flex-direction: row;
	align-items: center;
	font-size: 12rem;
}
body.pad #tc_pick_legend {
	display: flex;
}
#tc_pick_legend .pad-glyph {
	position: relative;
}

/* The Social panel (the players around and what to do with them): under the top row, centred like
   the menu, over the dimmed screen. The player chosen is gold, the pad's highlight white; the actions
   dim while no player is chosen. */
#tc_social_backdrop {
	position: absolute;
	z-index: 1;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 110);
}
body.socialising #tc_quick {
	z-index: 0;
}
#tc_social_panel {
	position: absolute;
	z-index: 3;
	left: 0;
	right: 0;
	top: 8rem;
	width: 652rem;
	max-width: 96%;
	max-height: 96%;
	margin: 0 auto;
	padding: 8rem;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	border: 1rem token(border-frame);
	border-radius: 6rem;
	background-color: rgba(6, 7, 6, 245);
	color: token(text-primary);
	font-family: "token(font-body)";
	font-size: 13rem;
	font-effect: shadow(0rem 1rem #000000);
	overflow: hidden;
}
#tc_soc_head, #tc_soc_windows {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6rem;
}
#tc_soc_head {
	height: 34rem;
}
#tc_soc_title {
	flex: 1 1 0;
	font-size: 15rem;
	color: token(accent-gold-hover);
	white-space: nowrap;
	overflow: hidden;
}
#tc_soc_players, #tc_soc_actions {
	flex-shrink: 0;
	display: flex;
	flex-wrap: wrap;
	gap: 6rem;
	margin-top: 4rem;
}
.tc-soc-player {
	position: relative;
	width: 150rem;
	height: 40rem;
	padding: 2rem 6rem;
	border-width: 1rem;
	border-radius: 6rem;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: left;
}
.tc-soc-name {
	font-size: 13rem;
	line-height: 16rem;
	white-space: nowrap;
	overflow: hidden;
}
.tc-soc-guild {
	color: token(text-secondary);
	font-size: 11rem;
	line-height: 14rem;
	white-space: nowrap;
	overflow: hidden;
}
.tc-soc-player.chosen {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 110);
}
#tc_soc_hint {
	flex-shrink: 0;
	margin-top: 6rem;
	font-size: 12rem;
	line-height: 15rem;
	white-space: nowrap;
	overflow: hidden;
}
.tc-soc-act {
	position: relative;
	width: 100rem;
	height: 38rem;
	padding: 0 4rem;
	border-radius: 4rem;
	display: block;
	text-align: center;
	line-height: 38rem;
	white-space: nowrap;
	overflow: hidden;
}
#tc_soc_actions.off .tc-soc-act {
	opacity: 0.4;
}
#tc_soc_windows {
	margin-top: 8rem;
	padding-top: 6rem;
	border-top: 1rem rgba(214, 210, 198, 50);
}
#tc_soc_windows_label {
	color: token(text-secondary);
	font-size: 12rem;
	margin-right: 4rem;
}
.tc-soc-player.focused, .tc-soc-act.focused, #tc_soc_close.focused {
	border-color: rgba(255, 255, 255, 235);
	background-color: rgba(255, 255, 255, 40);
}
#tc_soc_legend {
	display: none;
	flex-shrink: 0;
	height: 22rem;
	padding-top: 2rem;
	flex-direction: row;
	align-items: center;
	font-size: 12rem;
}
body.pad #tc_soc_legend {
	display: flex;
}
#tc_soc_legend .pad-glyph {
	position: relative;
}

.tc-potion {
	width: 48rem;
	height: 48rem;
	bottom: 196rem;
	line-height: 44rem;
	font-size: 16rem;
	border-radius: 24rem;
}
#tc_potion_q { left: 24rem; }
#tc_potion_w { left: 84rem; }
/* None left: dimmed, so an empty hotkey is not pressed in a fight. */
.tc-potion.empty { opacity: 0.4; }

#tc_attack {
	right: 24rem;
	bottom: 24rem;
	width: 84rem;
	height: 84rem;
	line-height: 80rem;
	font-size: 15rem;
	border-color: rgba(195, 74, 45, 200);
	border-radius: 42rem;
	background-color: rgba(125, 25, 15, 150);
}
/* PK on (the menu's switch): attacks hit players too, so the button glows red and reads "PK". */
#tc_attack.pk {
	border-color: rgba(230, 60, 40, 255);
	background-color: rgba(175, 20, 12, 200);
	box-shadow: 0 0 10rem 2rem rgba(230, 60, 40, 160);
}

/* The five skills on an arc 145rem from the attack button's centre, from a little above its left round
   to a little left of above: the first stays clear of the HUD's bar (640rem centred, 51rem high). */
.tc-skill {
	width: 50rem;
	height: 50rem;
	border-radius: 10rem;
}
#tc_skill_0 { right: 185rem; bottom: 56rem; }
#tc_skill_1 { right: 168rem; bottom: 110rem; }
#tc_skill_2 { right: 132rem; bottom: 154rem; }
#tc_skill_3 { right: 82rem; bottom: 180rem; }
#tc_skill_4 { right: 26rem; bottom: 185rem; }
.tc-skill.selected {
	border-color: token(accent-gold-hover);
}
/* No skill known yet (a new character): no buttons to fill, nor Skills to fill them with. */
body.no-skills .tc-skill, body.no-skills #tc_skill_edit {
	display: none;
}
/* Dim, yet in sight, with a plus: a tap on one opens the skill picker to fill it. */
.tc-skill.empty {
	opacity: 0.85;
}
/* Short of mana or AG: a blue veil over a faded icon (it would only say so in the chat). */
.tc-skill.nomana {
	background-color: rgba(40, 70, 160, 150);
}
.tc-skill.nomana .tc-skill-icon {
	opacity: 0.45;
}
/* A picked skill waits for a button: every one lights up to take it. */
.tc-skill.bind {
	opacity: 1;
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 70);
}
.tc-skill-plus {
	display: none;
	position: absolute;
	left: 12rem;
	top: 12rem;
	width: 22rem;
	height: 22rem;
}
.tc-skill.empty .tc-skill-plus {
	display: block;
}
.tc-plus-h, .tc-plus-v {
	position: absolute;
	border-radius: 2rem;
	background-color: rgba(214, 190, 120, 230);
}
.tc-plus-h {
	left: 0;
	top: 9rem;
	width: 22rem;
	height: 4rem;
}
.tc-plus-v {
	left: 9rem;
	top: 0;
	width: 4rem;
	height: 22rem;
}
#tc_bind_hint {
	position: absolute;
	right: 24rem;
	bottom: 246rem;
	max-width: 300rem;
	padding: 4rem 8rem;
	border-radius: 4rem;
	background-color: rgba(6, 7, 6, 215);
	color: token(text-primary);
	font-family: "token(font-body)";
	font-size: 12rem;
	font-effect: shadow(0rem 1rem #000000);
	text-align: right;
	pointer-events: none;
}
/* The 20x28 icon at 1.3 times its size. */
.tc-skill-icon {
	position: absolute;
	left: 10rem;
	top: 5rem;
	width: 26rem;
	height: 36rem;
}
/* Shrinks from the top down as the cooldown runs out (height bound to its fraction). */
.tc-cooldown {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	background-color: rgba(0, 0, 0, 150);
}

.tc-small {
	width: 44rem;
	height: 44rem;
	line-height: 40rem;
	font-size: 11rem;
	border-radius: 22rem;
}
#tc_pickup { right: 8rem; bottom: 124rem; }
/* Opens the skill picker: left of the arc's second button, above the first. */
#tc_skill_edit {
	right: 230rem;
	bottom: 118rem;
	width: 60rem;
	height: 30rem;
	line-height: 26rem;
	font-size: 11rem;
	border-radius: 15rem;
	border-color: rgba(196, 154, 60, 150);
	white-space: nowrap;
}
#tc_auto { right: 124rem; bottom: 8rem; }
/* Target: left of Auto, under the arc's first skill; the next monster by distance becomes the one
   fought. Faded while there is none other near. */
#tc_target {
	right: 178rem;
	bottom: 8rem;
	white-space: nowrap;
}
#tc_target.none {
	opacity: 0.4;
}
#tc_auto.on, #tc_names.on {
	border-color: token(accent-gold-hover);
	background-color: rgba(196, 154, 60, 120);
}
/* Loot: left of Target, the drops' names on the ground while lit. */
#tc_names {
	right: 230rem;
	bottom: 8rem;
	white-space: nowrap;
}

/* The phone view's hero frame (theme flag "mobile", UI::Mobile::InterfaceMode) in the PC bar's
   place: under the location bar, compact bars on a dark plate (the level in a circle on the left, HP
   and MP with their numbers, SD and AG thin without), in finger units; the chat log's lines below
   it; the EXP line along the bottom. */
#tc_hero, #tc_exp {
	display: none;
	pointer-events: none;
}
@media (theme: mobile) {
	#tc_hero, #tc_exp {
		display: block;
	}
}
#tc_hero {
	position: absolute;
	left: 4dp;
	top: 26dp;
	width: 170rem;
	box-sizing: border-box;
	padding: 3rem 3rem 3rem 41rem;
	border-radius: 6rem;
	background-color: rgba(0, 0, 0, 140);
	font-family: "token(font-body)";
	color: token(text-primary);
	font-effect: shadow(0rem 1rem #000000);
}
#tc_hero * {
	pointer-events: none;
}
/* The level's number, a master level's "+N" under it: two lines of 12 fit the circle up to four digits. */
#tc_hero_level {
	position: absolute;
	left: 3rem;
	top: 50%;
	margin-top: -17rem;
	width: 34rem;
	height: 34rem;
	box-sizing: border-box;
	border: 1rem rgba(214, 190, 120, 150);
	border-radius: 17rem;
	background-color: rgba(6, 7, 6, 200);
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	font-size: 12rem;
	line-height: 13rem;
	white-space: nowrap;
}
.tc-hero-master {
	color: token(accent-gold-hover);
}
.tc-gauge {
	position: relative;
	height: 16rem;
	margin-top: 2rem;
	box-sizing: border-box;
	border: 1rem rgba(214, 210, 198, 50);
	border-radius: 3rem;
	background-color: rgba(6, 7, 6, 150);
	overflow: hidden;
}
#tc_hero_hp {
	margin-top: 0;
}
.tc-gauge-fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}
.tc-gauge-text {
	position: relative;
	height: 100%;
	line-height: 14rem;
	font-size: 12rem;
	text-align: center;
}
#tc_hero_small {
	display: flex;
	gap: 3rem;
	margin-top: 2rem;
}
.tc-gauge-small {
	flex: 1 1 0;
	height: 5rem;
	margin-top: 0;
	border-width: 0;
	border-radius: 2rem;
	background-color: rgba(214, 210, 198, 35);
}
/* Soft colours, a little lighter at the top. */
#tc_hero_hp .tc-gauge-fill { background-color: #b8322c; decorator: linear-gradient(to bottom, #c8443c, #a62a24); }
#tc_hero_mp .tc-gauge-fill { background-color: #2f5fb8; decorator: linear-gradient(to bottom, #3d6ec6, #2852a2); }
#tc_hero_sd .tc-gauge-fill { background-color: #c9a43a; decorator: linear-gradient(to bottom, #d6b24a, #b8922e); }
#tc_hero_ag .tc-gauge-fill { background-color: #3f9a52; decorator: linear-gradient(to bottom, #4daa60, #348646); }
#tc_exp {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 3rem;
	background-color: rgba(6, 7, 6, 150);
}
#tc_exp_fill {
	height: 100%;
	background-color: rgba(196, 154, 60, 220);
}

/* How many potions the button has left, under it. */
.tc-potion-count {
	position: absolute;
	left: 0;
	right: 0;
	bottom: -16rem;
	line-height: 14rem;
	font-size: 12rem;
}

/* The phone HUD (theme flag "mobile-hud"). The controls also show on a PC with a touch screen or a pad,
   which keeps the rules above as they are. */
@media (theme: mobile-hud) {
	/* The skill list goes just left of the skill buttons (PhoneHudLayout.cpp): the hint stays over the
	   buttons, no wider than the room right of the list, clear of the pets' frame at the top. */
	#tc_bind_hint {
		max-width: 194rem;
	}

	/* The top row: each button as wide as its label, from 44 up to 72 units, the row's room shared
	   out up to 72 units a button (a wide phone looks as before). Where the row is too short for the
	   labels at 12 units, they get smaller: the four long ones (Russian "Инвентарь", "Персонаж",
	   "Общение", "Телепорт": 18.1 times the font size together in Liberation Sans, 4 % more here for other
	   fonts) get what the fold button (36 units and its gap), the four short ones (44 units each), the
	   gaps and the borders leave. */
	.tc-quick {
		width: auto;
		flex: 1 1 auto;
		max-width: 72rem;
		font-size: clamp(9rem, (100vw - 214dp - 332rem) / 18.8, 12rem);
	}
	/* With a pad, Back, Menu and Social carry its glyph (22 units) beside their short labels. */
	body.pad .tc-quick {
		font-size: clamp(9rem, (100vw - 214dp - 278rem) / 27.3, 12rem);
	}

	/* The buttons on the right 15 % smaller than on a PC touch screen (ghinzuro 2026-11-11): Attack 72
	   units, the skills 44 on an arc 124 units from Attack's centre (angles as before), the round buttons
	   38. Pick up a pill as tall as Auto ("Поднять" needs 48 units at 12), Target ("ターゲット" needs 60)
	   and Loot left of it along the bottom, Skills above the arc's first two. */
	#tc_attack {
		width: 72rem;
		height: 72rem;
		line-height: 68rem;
		border-radius: 36rem;
	}
	.tc-skill {
		width: 44rem;
		height: 44rem;
		border-radius: 9rem;
	}
	#tc_skill_0 { right: 161rem; bottom: 51rem; }
	#tc_skill_1 { right: 147rem; bottom: 97rem; }
	#tc_skill_2 { right: 116rem; bottom: 135rem; }
	#tc_skill_3 { right: 73rem; bottom: 157rem; }
	#tc_skill_4 { right: 25rem; bottom: 161rem; }
	.tc-skill .tc-skill-icon {
		left: 8.5rem;
		top: 4rem;
		width: 23rem;
		height: 32rem;
	}
	.tc-skill .tc-skill-plus {
		left: 10rem;
		top: 10rem;
		width: 20rem;
		height: 20rem;
	}
	.tc-skill .tc-plus-h {
		top: 8rem;
		width: 20rem;
	}
	.tc-skill .tc-plus-v {
		left: 8rem;
		height: 20rem;
	}
	.tc-small {
		width: 38rem;
		height: 38rem;
		line-height: 34rem;
		border-radius: 19rem;
	}
	#tc_pickup { right: 10rem; bottom: 109rem; width: 54rem; }
	#tc_auto { right: 109rem; bottom: 10rem; }
	#tc_target { right: 155rem; bottom: 10rem; width: 60rem; }
	#tc_names { right: 223rem; bottom: 10rem; width: 54rem; }
	#tc_skill_edit {
		right: 199rem;
		bottom: 103rem;
		width: 54rem;
		height: 28rem;
		line-height: 24rem;
		border-radius: 14rem;
	}
	#tc_bind_hint {
		bottom: 212rem;
	}
	#tc_picker {
		right: 214rem;
	}

	/* No text under 12 units on a phone, and the skill picker's buttons a finger tall. */
	.tc-small, #tc_skill_edit {
		font-size: 12rem;
	}
	#tc_pick_head {
		height: 44rem;
	}
	#tc_pick_hint_row {
		min-height: 44rem;
	}
	.tc-pick-button {
		height: 44rem;
		line-height: 40rem;
	}
	.tc-pick-page {
		width: 44rem;
		height: 44rem;
		line-height: 40rem;
	}
	.tc-pick-name {
		font-size: 12rem;
		line-height: 14rem;
	}
	#tc_pick_tip {
		font-size: 12rem;
		line-height: 15rem;
	}
	/* The Social panel's buttons a finger tall. */
	#tc_soc_head {
		height: 44rem;
	}
	.tc-soc-player {
		height: 44rem;
	}
	.tc-soc-act {
		height: 44rem;
		font-size: 12rem;
	}

	/* A Button size under 100 % (UI::Mobile::ButtonSize) shrinks the buttons, not their labels: 12 units
	   of text at 100 % stay as large on the screen (12 x 100 / percent units here), and the labelled
	   buttons widen to hold them, Loot moving left with Target. Auto stays round: its label grows only as
	   far as the button holds it. */
	body.size-90 .tc-small, body.size-90 #tc_skill_edit { font-size: 13.3rem; }
	body.size-90 #tc_pickup, body.size-90 #tc_names { width: 60rem; }
	body.size-90 #tc_target { width: 73rem; }
	body.size-90 #tc_names { right: 236rem; }
	body.size-90 #tc_skill_edit { width: 60rem; height: 30rem; line-height: 26rem; }

	body.size-80 .tc-small, body.size-80 #tc_skill_edit { font-size: 15rem; }
	body.size-80 #tc_pickup, body.size-80 #tc_names { width: 66rem; }
	body.size-80 #tc_target { width: 81rem; }
	body.size-80 #tc_names { right: 244rem; }
	body.size-80 #tc_skill_edit { width: 66rem; height: 32rem; line-height: 28rem; }

	body.size-70 .tc-small, body.size-70 #tc_skill_edit { font-size: 17.1rem; }
	body.size-70 #tc_pickup, body.size-70 #tc_names { width: 75rem; }
	body.size-70 #tc_target { width: 92rem; }
	body.size-70 #tc_names { right: 255rem; }
	body.size-70 #tc_skill_edit { width: 75rem; height: 36rem; line-height: 32rem; }
	body.size-70 #tc_attack { font-size: 17.1rem; }

	body.size-60 .tc-small, body.size-60 #tc_skill_edit { font-size: 20rem; }
	body.size-60 #tc_pickup, body.size-60 #tc_names { width: 86rem; }
	body.size-60 #tc_target { width: 106rem; }
	body.size-60 #tc_names { right: 269rem; }
	body.size-60 #tc_skill_edit { width: 86rem; height: 40rem; line-height: 36rem; }
	body.size-60 #tc_attack { font-size: 20rem; }

	body.size-70 #tc_auto, body.size-60 #tc_auto { font-size: 15rem; }

	/* The top row's labels and the hero frame keep their size on the screen as well: the top row's
	   widths and font, and the whole hero frame, 100 / percent times their units at 100 %. The row still
	   ends as far left of the page's menu button as at 100 %. */
	body.size-90 #tc_quick { right: 80rem; }
	body.size-80 #tc_quick { right: 90rem; }
	body.size-70 #tc_quick { right: 102.9rem; }
	body.size-60 #tc_quick { right: 120rem; }
	body.size-90 .tc-quick { max-width: 80rem; min-width: 48.9rem; font-size: clamp(10rem, (100vw - 214dp - 368.9rem) / 18.8, 13.3rem); }
	body.pad.size-90 .tc-quick { font-size: clamp(10rem, (100vw - 214dp - 308.9rem) / 27.3, 13.3rem); }
	body.size-90 #tc_hero { width: 188.9rem; padding: 3.3rem 3.3rem 3.3rem 45.6rem; border-radius: 6.7rem; }
	body.size-90 #tc_hero_level { left: 3.3rem; margin-top: -18.9rem; width: 37.8rem; height: 37.8rem; border-radius: 18.9rem; font-size: 13.3rem; line-height: 14.4rem; }
	body.size-90 #tc_hero .tc-gauge { height: 17.8rem; border-radius: 3.3rem; }
	body.size-90 #tc_hero .tc-gauge-text { line-height: 15.6rem; font-size: 13.3rem; }
	body.size-90 #tc_hero .tc-gauge-small { height: 5.6rem; border-radius: 2.2rem; }
	body.size-90 #tc_hero_small { gap: 3.3rem; margin-top: 2.2rem; }
	body.size-80 .tc-quick { max-width: 90rem; min-width: 55rem; font-size: clamp(11.2rem, (100vw - 214dp - 415rem) / 18.8, 15rem); }
	body.pad.size-80 .tc-quick { font-size: clamp(11.2rem, (100vw - 214dp - 347.5rem) / 27.3, 15rem); }
	body.size-80 #tc_hero { width: 212.5rem; padding: 3.8rem 3.8rem 3.8rem 51.2rem; border-radius: 7.5rem; }
	body.size-80 #tc_hero_level { left: 3.8rem; margin-top: -21.2rem; width: 42.5rem; height: 42.5rem; border-radius: 21.2rem; font-size: 15rem; line-height: 16.2rem; }
	body.size-80 #tc_hero .tc-gauge { height: 20rem; border-radius: 3.8rem; }
	body.size-80 #tc_hero .tc-gauge-text { line-height: 17.5rem; font-size: 15rem; }
	body.size-80 #tc_hero .tc-gauge-small { height: 6.2rem; border-radius: 2.5rem; }
	body.size-80 #tc_hero_small { gap: 3.8rem; margin-top: 2.5rem; }
	body.size-70 .tc-quick { max-width: 102.9rem; min-width: 62.9rem; font-size: clamp(12.9rem, (100vw - 214dp - 474.3rem) / 18.8, 17.1rem); }
	body.pad.size-70 .tc-quick { font-size: clamp(12.9rem, (100vw - 214dp - 397.1rem) / 27.3, 17.1rem); }
	body.size-70 #tc_hero { width: 242.9rem; padding: 4.3rem 4.3rem 4.3rem 58.6rem; border-radius: 8.6rem; }
	body.size-70 #tc_hero_level { left: 4.3rem; margin-top: -24.3rem; width: 48.6rem; height: 48.6rem; border-radius: 24.3rem; font-size: 17.1rem; line-height: 18.6rem; }
	body.size-70 #tc_hero .tc-gauge { height: 22.9rem; border-radius: 4.3rem; }
	body.size-70 #tc_hero .tc-gauge-text { line-height: 20rem; font-size: 17.1rem; }
	body.size-70 #tc_hero .tc-gauge-small { height: 7.1rem; border-radius: 2.9rem; }
	body.size-70 #tc_hero_small { gap: 4.3rem; margin-top: 2.9rem; }
	body.size-60 .tc-quick { max-width: 120rem; min-width: 73.3rem; font-size: clamp(15rem, (100vw - 214dp - 553.3rem) / 18.8, 20rem); }
	body.pad.size-60 .tc-quick { font-size: clamp(15rem, (100vw - 214dp - 463.3rem) / 27.3, 20rem); }
	body.size-60 #tc_hero { width: 283.3rem; padding: 5rem 5rem 5rem 68.3rem; border-radius: 10rem; }
	body.size-60 #tc_hero_level { left: 5rem; margin-top: -28.3rem; width: 56.7rem; height: 56.7rem; border-radius: 28.3rem; font-size: 20rem; line-height: 21.7rem; }
	body.size-60 #tc_hero .tc-gauge { height: 26.7rem; border-radius: 5rem; }
	body.size-60 #tc_hero .tc-gauge-text { line-height: 23.3rem; font-size: 20rem; }
	body.size-60 #tc_hero .tc-gauge-small { height: 8.3rem; border-radius: 3.3rem; }
	body.size-60 #tc_hero_small { gap: 5rem; margin-top: 3.3rem; }
}

/* A pad: each control shows the pad button that presses it (gamepad_glyphs.rcss draws them) on its
   top corner, away from its neighbours on the arc; inside the left end of a top-row button, whose
   label then starts right of it. Without touch the left stick walks: no joystick on the screen. */
body.no-touch #tc_stick {
	display: none;
}
body.pad #tc_back, body.pad #tc_menu, body.pad #tc_social {
	padding-left: 22rem;
}
.tc-quick .pad-glyph { left: 1rem; top: 6rem; }
#tc_attack .pad-glyph { right: 2rem; top: 2rem; }
#tc_attack .pad-ps { transform: scale(1.3); }
#tc_attack .pad-face {
	width: 26rem;
	height: 26rem;
	border-radius: 13rem;
	font-size: 15rem;
	line-height: 22rem;
}
.tc-skill .pad-glyph { left: -8rem; top: -8rem; }
.tc-potion .pad-glyph { right: -8rem; top: -8rem; }
#tc_pickup .pad-glyph { left: -12rem; top: -10rem; }
#tc_auto .pad-glyph { left: -8rem; top: -8rem; }
#tc_skill_edit .pad-glyph { left: -10rem; top: -10rem; }

/* The potions E and R: shown by no layout now (a pad's d-pad left and right open the map and the
   inventory, ghinzuro 2026-11-03). */
#tc_potion_e, #tc_potion_r {
	display: none;
}
/* The skill buttons 4 and 5 are RT held with X and Y: the trigger's glyph on the left corner, the face
   button's on the right. */
.tc-skill .pad-alt-key { left: auto; right: -8rem; }

/* A pad with no finger on the screen (UI/HUD/GamepadControls.h): Diablo's row along the bottom,
   centred, just over the HUD's bar (640rem centred, 51rem high): the potions LB and LT on its left,
   then attack (A), the three skills X, Y and B, and MU Helper (d-pad up) on its right (ghinzuro,
   2026-11-03: three skills, RT held for the next ones). While RT is held (pad-alt), the skill buttons 4,
   5 and 6 stand in the places of X, Y and B. No top row (Menu opens the windows, View the Social panel), no
   pickup button (d-pad down), no Skills button (LS). */
body.pad.no-touch #tc_quick, body.pad.no-touch #tc_pickup, body.pad.no-touch #tc_skill_edit, body.pad.no-touch #tc_target,
body.pad.no-touch #tc_names {
	display: none;
}
/* The row keeps its own sizes whatever the phone's smaller buttons: the skills' corners, icons and
   pluses, Auto round. */
body.pad.no-touch .tc-skill {
	border-radius: 10rem;
}
body.pad.no-touch .tc-skill .tc-skill-icon {
	width: 26rem;
	height: 36rem;
}
body.pad.no-touch .tc-skill .tc-skill-plus {
	left: 12rem;
	top: 12rem;
	width: 22rem;
	height: 22rem;
}
body.pad.no-touch .tc-skill .tc-plus-h {
	top: 9rem;
	width: 22rem;
}
body.pad.no-touch .tc-skill .tc-plus-v {
	left: 9rem;
	height: 22rem;
}
body.pad.no-touch #tc_auto {
	border-radius: 22rem;
}
/* The sixth skill button is the pad's alone (RT + B): touch never shows it. */
#tc_skill_5 {
	display: none;
}
body.pad.no-touch #tc_skill_3, body.pad.no-touch #tc_skill_4 {
	display: none;
}
body.pad.no-touch.pad-alt #tc_skill_3, body.pad.no-touch.pad-alt #tc_skill_4, body.pad.no-touch.pad-alt #tc_skill_5 {
	display: block;
}
/* With no skills learnt RT shows no empty skill buttons either; on the upper hotkey set there is no sixth. */
body.no-skills.pad.no-touch.pad-alt #tc_skill_3, body.no-skills.pad.no-touch.pad-alt #tc_skill_4, body.no-skills.pad.no-touch.pad-alt #tc_skill_5,
body.pad.no-touch.pad-alt #tc_skill_5.unused, body.pad.no-touch.picking #tc_skill_5.unused {
	display: none;
}
body.pad.no-touch.pad-alt #tc_skill_0, body.pad.no-touch.pad-alt #tc_skill_1, body.pad.no-touch.pad-alt #tc_skill_2 {
	display: none;
}
/* RT is already held: its glyph would only crowd the row, so the face key alone stands in its usual corner. */
body.pad.no-touch .tc-skill .pad-trigger { display: none; }
body.pad.no-touch .tc-skill .pad-alt-key { left: -8rem; right: auto; }
body.pad.no-touch #tc_attack, body.pad.no-touch #tc_skill_0, body.pad.no-touch #tc_skill_1, body.pad.no-touch #tc_skill_2, body.pad.no-touch #tc_skill_3, body.pad.no-touch #tc_skill_4, body.pad.no-touch #tc_skill_5 {
	left: 50%;
	right: auto;
	bottom: 60rem;
	width: 54rem;
	height: 54rem;
}
body.pad.no-touch #tc_potion_q, body.pad.no-touch #tc_potion_w, body.pad.no-touch #tc_potion_e, body.pad.no-touch #tc_potion_r, body.pad.no-touch #tc_auto {
	left: 50%;
	right: auto;
	bottom: 65rem;
	width: 44rem;
	height: 44rem;
	line-height: 40rem;
}
body.pad.no-touch #tc_potion_q { margin-left: -200rem; }
body.pad.no-touch #tc_potion_w { margin-left: -148rem; }
/* RT held: E and R stand in Q's and W's places, on LB and LT. */
body.pad.no-touch.pad-alt #tc_potion_q, body.pad.no-touch.pad-alt #tc_potion_w { display: none; }
body.pad.no-touch.pad-alt #tc_potion_e { display: block; margin-left: -200rem; }
body.pad.no-touch.pad-alt #tc_potion_r { display: block; margin-left: -148rem; }
body.pad.no-touch #tc_attack {
	margin-left: -92rem;
	line-height: 50rem;
	font-size: 12rem;
	border-radius: 27rem;
}
body.pad.no-touch #tc_skill_0, body.pad.no-touch #tc_skill_3 { margin-left: -28rem; }
body.pad.no-touch #tc_skill_1, body.pad.no-touch #tc_skill_4 { margin-left: 36rem; }
body.pad.no-touch #tc_skill_2, body.pad.no-touch #tc_skill_5 { margin-left: 100rem; }
body.pad.no-touch .tc-skill .tc-skill-icon { left: 12rem; top: 7rem; }
body.pad.no-touch #tc_auto { margin-left: 168rem; }
/* The skill picker (L3) sets all five buttons: they stand in one row then, 4 and 5 where MU Helper
   was, with RT on their corner (the picker lets RT go, so pad-alt is off while it is open). */
body.pad.no-touch.picking #tc_skill_3, body.pad.no-touch.picking #tc_skill_4, body.pad.no-touch.picking #tc_skill_5, body.pad.no-touch.picking #tc_skill_0, body.pad.no-touch.picking #tc_skill_1, body.pad.no-touch.picking #tc_skill_2 {
	display: block;
}
body.pad.no-touch.picking #tc_skill_3 { margin-left: 164rem; }
body.pad.no-touch.picking #tc_skill_4 { margin-left: 228rem; }
body.pad.no-touch.picking #tc_skill_5 { margin-left: 292rem; }
body.pad.no-touch.picking #tc_auto { display: none; }
body.pad.no-touch.picking .tc-skill .pad-trigger { display: block; }
body.pad.no-touch.picking .tc-skill .pad-alt-key { display: none; }
body.pad.no-touch #tc_attack .pad-glyph { right: auto; left: -8rem; top: -8rem; }
body.pad.no-touch .tc-potion .pad-glyph, body.pad.no-touch #tc_auto .pad-glyph { left: -8rem; right: auto; top: -8rem; }
body.pad.no-touch #tc_bind_hint {
	left: 50%;
	right: auto;
	margin-left: -92rem;
	bottom: 126rem;
}

/* The phone view has no HUD bar: the row sits near the bottom edge, over the EXP line. */
@media (theme: mobile-hud) {
	body.pad.no-touch #tc_attack, body.pad.no-touch #tc_skill_0, body.pad.no-touch #tc_skill_1, body.pad.no-touch #tc_skill_2, body.pad.no-touch #tc_skill_3, body.pad.no-touch #tc_skill_4, body.pad.no-touch #tc_skill_5 {
		bottom: 14rem;
	}
	body.pad.no-touch #tc_potion_q, body.pad.no-touch #tc_potion_w, body.pad.no-touch #tc_potion_e, body.pad.no-touch #tc_potion_r, body.pad.no-touch #tc_auto {
		bottom: 19rem;
	}
	body.pad.no-touch #tc_bind_hint {
		bottom: 80rem;
	}
	/* The labels' size as the row had it, whatever the Button size. */
	body.pad.no-touch #tc_auto {
		font-size: 12rem;
	}
}

/* The pad row sits just over the HUD bar: the count goes inside its button, on the lower edge. */
body.pad.no-touch .tc-potion-count {
	bottom: 2rem;
	line-height: 11rem;
	font-size: 10rem;
}

/* Below 100 % the top row keeps its height, its fold button and the gap to the menu panel as large on the
   screen as at 100 % (a 22-pixel row is no target for a finger): 100 / percent times the units above. */
body.size-90 #tc_quick { top: 4.4rem; gap: 4.4rem; }
body.size-90 .tc-quick { height: 40rem; line-height: 35.6rem; border-radius: 6.7rem; }
body.size-90 #tc_quick_toggle { width: 40rem; height: 40rem; border-radius: 6.7rem; }
body.size-90 .tc-toggle-line { left: 8.9rem; width: 17.8rem; height: 2.2rem; }
body.size-90 .tc-toggle-line-1 { top: 10rem; }
body.size-90 .tc-toggle-line-2 { top: 16.7rem; }
body.size-90 .tc-toggle-line-3 { top: 23.3rem; }
body.size-90 #tc_menu_panel { top: 51.1rem; }
body.size-80 #tc_quick { top: 5rem; gap: 5rem; }
body.size-80 .tc-quick { height: 45rem; line-height: 40rem; border-radius: 7.5rem; }
body.size-80 #tc_quick_toggle { width: 45rem; height: 45rem; border-radius: 7.5rem; }
body.size-80 .tc-toggle-line { left: 10rem; width: 20rem; height: 2.5rem; }
body.size-80 .tc-toggle-line-1 { top: 11.2rem; }
body.size-80 .tc-toggle-line-2 { top: 18.8rem; }
body.size-80 .tc-toggle-line-3 { top: 26.2rem; }
body.size-80 #tc_menu_panel { top: 57.5rem; }
body.size-70 #tc_quick { top: 5.7rem; gap: 5.7rem; }
body.size-70 .tc-quick { height: 51.4rem; line-height: 45.7rem; border-radius: 8.6rem; }
body.size-70 #tc_quick_toggle { width: 51.4rem; height: 51.4rem; border-radius: 8.6rem; }
body.size-70 .tc-toggle-line { left: 11.4rem; width: 22.9rem; height: 2.9rem; }
body.size-70 .tc-toggle-line-1 { top: 12.9rem; }
body.size-70 .tc-toggle-line-2 { top: 21.4rem; }
body.size-70 .tc-toggle-line-3 { top: 30rem; }
body.size-70 #tc_menu_panel { top: 65.7rem; }
body.size-60 #tc_quick { top: 6.7rem; gap: 6.7rem; }
body.size-60 .tc-quick { height: 60rem; line-height: 53.3rem; border-radius: 10rem; }
body.size-60 #tc_quick_toggle { width: 60rem; height: 60rem; border-radius: 10rem; }
body.size-60 .tc-toggle-line { left: 13.3rem; width: 26.7rem; height: 3.3rem; }
body.size-60 .tc-toggle-line-1 { top: 15rem; }
body.size-60 .tc-toggle-line-2 { top: 25rem; }
body.size-60 .tc-toggle-line-3 { top: 35rem; }
body.size-60 #tc_menu_panel { top: 76.7rem; }
/* Above 100 % the hero frame stops short of the top row, which starts at 214dp whatever the size. */
#tc_hero { max-width: 204dp; }
