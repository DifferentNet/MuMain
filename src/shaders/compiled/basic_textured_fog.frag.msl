static inline __attribute__((always_inline))
float TerrainDetailFade(thread const float& eyeDepth)
{
    return 1.0 - smoothstep(2400.0, 3800.0, eyeDepth);
}

static inline __attribute__((always_inline))
float TerrainSelfDetail(thread const float2& uv, thread const float2& uvDx, thread const float2& uvDy, thread const float& scale, texture2d<float> tex, sampler s)
{
    float dense = dot(tex.sample(s, (uv * scale), gradient2d(uvDx * scale, uvDy * scale)).xyz, float3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625));
    float mean = dot(tex.sample(s, uv, level(16.0)).xyz, float3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625));
    return fast::clamp(dense / fast::max(mean, 0.0199999995529651641845703125), 0.60000002384185791015625, 1.39999997615814208984375);
}

static inline __attribute__((always_inline))
float TerrainNoiseHash(thread const float2& cell)
{
    uint2 q = uint2(int2(cell)) * uint2(1597334673u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334673u;
    return float(n >> uint(8)) * 5.9604644775390625e-08;
}

static inline __attribute__((always_inline))
float TerrainValueNoise(thread const float2& p)
{
    float2 cell = floor(p);
    float2 f = p - cell;
    float2 w = (f * f) * (float2(3.0) - (f * 2.0));
    float2 param = cell;
    float a = TerrainNoiseHash(param);
    float2 param_1 = cell + float2(1.0, 0.0);
    float b = TerrainNoiseHash(param_1);
    float2 param_2 = cell + float2(0.0, 1.0);
    float c = TerrainNoiseHash(param_2);
    float2 param_3 = cell + float2(1.0);
    float d = TerrainNoiseHash(param_3);
    return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}

static inline __attribute__((always_inline))
float TerrainNoiseOctave(thread const float2& p, thread const float& cellsPerPixel)
{
    float alias = smoothstep(0.5, 1.0, cellsPerPixel);
    float2 param = p;
    return mix(TerrainValueNoise(param), 0.5, alias);
}

static inline __attribute__((always_inline))
float TerrainNoiseDetail(thread const float2& uv, thread const float2& uvWidth, thread const float& scale)
{
    float2 p = uv * scale;
    float2 footprint = uvWidth * scale;
    float cellsPerPixel = fast::max(footprint.x, footprint.y);
    float2 param = p;
    float param_1 = cellsPerPixel;
    float2 param_2 = p * 2.309999942779541015625;
    float param_3 = cellsPerPixel * 2.309999942779541015625;
    float2 param_4 = p * 5.1700000762939453125;
    float param_5 = cellsPerPixel * 5.1700000762939453125;
    float n = ((0.5 * TerrainNoiseOctave(param, param_1)) + (0.300000011920928955078125 * TerrainNoiseOctave(param_2, param_3))) + (0.20000000298023223876953125 * TerrainNoiseOctave(param_4, param_5));
    return 1.0 + ((0.25 * (n - 0.5)) * 2.0);
}

static inline __attribute__((always_inline))
float TerrainDetailFactor(thread const float2& uv, thread const float& eyeDepth, texture2d<float> tex, sampler s, constant FogUniforms& _271)
{
    float2 uvDx = dfdx(uv);
    float2 uvDy = dfdy(uv);
    float2 uvWidth = abs(uvDx) + abs(uvDy);
    if (_271.detailStrength <= 0.0)
    {
        return 1.0;
    }
    float param = eyeDepth;
    float amount = _271.detailStrength * TerrainDetailFade(param);
    if (_271.detailScale > 0.0)
    {
        float2 param_1 = uv;
        float2 param_2 = uvDx;
        float2 param_3 = uvDy;
        float param_4 = _271.detailScale;
        return mix(1.0, TerrainSelfDetail(param_1, param_2, param_3, param_4, tex, s), amount);
    }
    float2 param_5 = uv;
    float2 param_6 = uvWidth;
    float param_7 = -_271.detailScale;
    return 1.0 + (amount * (TerrainNoiseDetail(param_5, param_6, param_7) - 1.0));
}

static inline __attribute__((always_inline))
float EnhancedFogAmount(thread const float& eyeDepth, constant SceneLighting& _326)
{
    float scaledDistance = fast::max(eyeDepth - _326.sceneFogParameters.x, 0.0) * _326.sceneFogParameters.z;
    return fast::clamp(1.0 - exp((-scaledDistance) * scaledDistance), 0.0, 1.0);
}

static inline __attribute__((always_inline))
float4 _main(thread const FSInput& _input, texture2d<float> tex, sampler s, constant FogUniforms& _271, constant SceneLighting& _326)
{
    float4 color = tex.sample(s, _input.uv) * _input.color;
    float2 param = _input.uv;
    float param_1 = _input.eyeDepth;
    float4 _365 = color;
    float3 _367 = _365.xyz * TerrainDetailFactor(param, param_1, tex, s, _271);
    color.x = _367.x;
    color.y = _367.y;
    color.z = _367.z;
    if (_271.alphaToCoverage != 0u)
    {
        float edge = fast::clamp(((color.w - _271.alphaThreshold) / fast::max(fwidth(color.w), 9.9999997473787516355514526367188e-05)) + 0.5, 0.0, 1.0);
        color.w *= edge;
        if (color.w <= 0.0)
        {
            discard_fragment();
        }
    }
    else
    {
        if ((_271.alphaDiscardEnabled != 0u) && (color.w <= _271.alphaThreshold))
        {
            discard_fragment();
        }
    }
    if ((_271.fogEnabled != 0u) && (_326.sceneFogColor.w > 0.0))
    {
        float4 _431 = color;
        float param_2 = _input.eyeDepth;
        float3 _442 = mix(_431.xyz, _326.sceneFogColor.xyz, float3(EnhancedFogAmount(param_2, _326)));
        color.x = _442.x;
        color.y = _442.y;
        color.z = _442.z;
    }
    return color;
}

fragment main0_out main0(main0_in in [[stage_in]], constant FogUniforms& _271 [[buffer(0)]], constant SceneLighting& _326 [[buffer(1)]], texture2d<float> tex [[texture(0)]], sampler s [[sampler(0)]], float4 gl_FragCoord [[position]])
{
    main0_out out = {};
    FSInput _input;
    _input.pos = gl_FragCoord;
    _input.uv = in.input_uv;
    _input.color = in.input_color;
    _input.fogFactor = in.input_fogFactor;
    _input.eyeDepth = in.input_eyeDepth;
    FSInput param = _input;
