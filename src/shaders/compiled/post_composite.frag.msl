static inline __attribute__((always_inline))
float3 Grade(thread const float3& color, texture2d<float> grading, sampler gradingSampler)
{
    float blue = color.z * 31.0;
    float lowerSlice = floor(blue);
    float upperSlice = fast::min(lowerSlice + 1.0, 31.0);
    float sliceBlend = blue - lowerSlice;
    float x = ((color.x * 31.0) + 0.5) / 1024.0;
    float y = ((color.y * 31.0) + 0.5) / 32.0;
    float3 lower = grading.sample(gradingSampler, float2(x + (lowerSlice * 0.03125), y)).xyz;
    float3 upper = grading.sample(gradingSampler, float2(x + (upperSlice * 0.03125), y)).xyz;
    return mix(lower, upper, float3(sliceBlend));
}

