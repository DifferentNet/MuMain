static inline __attribute__((always_inline))
bool RollsOffHighlight(thread const float& knee)
{
    return (knee > 0.0) && (knee < 1.0);
}

static inline __attribute__((always_inline))
float RollOffChannel(thread const float& value, thread const float& knee)
{
    float range = 1.0 - knee;
    return (value > knee) ? (knee + (range * (1.0 - exp((-fast::max(value - knee, 0.0)) / range)))) : value;
}

static inline __attribute__((always_inline))
float3 RollOffHighlight(thread const float3& color, thread const float& knee)
{
    float param = color.x;
    float param_1 = knee;
    float param_2 = color.y;
    float param_3 = knee;
    float param_4 = color.z;
    float param_5 = knee;
    return fast::clamp(float3(RollOffChannel(param, param_1), RollOffChannel(param_2, param_3), RollOffChannel(param_4, param_5)), float3(0.0), float3(1.0));
}

static inline __attribute__((always_inline))
VSOutput _main(thread const VSInput& _input, constant Skinning& _122, const device boneRows& boneRows_1)
