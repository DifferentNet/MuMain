}

static inline __attribute__((always_inline))
float2 getTextureCoordinates(thread const float2& restCoordinates, thread const float3& normal, thread const float3& position, constant Skinning& _122)
{
    uint mode = _122.textureCoordinateMode.x;
    float chromeWave = _122.chromeParameters.x;
    float chromeWave2 = _122.chromeParameters.y;
    float2 chromeLight = _122.chromeParameters.zw;
    float2 offset = _122.textureCoordinateParameters.xy;
    if (mode == 1u)
    {
        return float2((normal.z * 0.5) + chromeWave, (normal.y * 0.5) + (chromeWave * 2.0));
    }
    if (mode == 2u)
    {
        return float2(((normal.z + normal.x) * 0.800000011920928955078125) + (chromeWave2 * 2.0), (normal.y + normal.x) + (chromeWave2 * 3.0));
    }
    if (mode == 3u)
    {
        float u = dot(normal, float3(0.0, -0.100000001490116119384765625, -0.800000011920928955078125));
        return float2(u, 1.0 - u);
