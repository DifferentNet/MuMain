        float4 _612 = _output.color;
        float3 _618 = fast::clamp(_612.xyz * luminosity, float3(0.0), float3(1.0));
        _output.color.x = _618.x;
        _output.color.y = _618.y;
        _output.color.z = _618.z;
        float param_7 = _122.lightDirection.w;
        if (RollsOffHighlight(param_7))
        {
            float3 param_8 = _input.color.xyz * luminosity;
            float param_9 = _122.lightDirection.w;
            float3 _640 = RollOffHighlight(param_8, param_9);
            _output.color.x = _640.x;
            _output.color.y = _640.y;
            _output.color.z = _640.z;
