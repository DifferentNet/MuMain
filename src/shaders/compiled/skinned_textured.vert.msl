static inline __attribute__((always_inline))
float3 transformPosition(thread const float3& position, thread const int& boneIndex, constant Skinning& _122, const device boneRows& boneRows_1)
{
    if ((boneIndex < 0) || (boneIndex >= int(_122.palette.y)))
    {
        return position;
    }
    uint row = _122.palette.x + (uint(boneIndex) * 3u);
    float4 row0 = boneRows_1._data[row];
    float4 row1 = boneRows_1._data[row + 1u];
    float4 row2 = boneRows_1._data[row + 2u];
    float3 transformed;
    if (_122.boneScaleAndRestPoseScale.x == 1.0)
    {
        float restScale = (_122.boneScaleAndRestPoseScale.y != 0.0) ? _122.boneScaleAndRestPoseScale.y : 1.0;
        float4 restPosition = float4(position * restScale, 1.0);
        transformed = float3(dot(row0, restPosition), dot(row1, restPosition), dot(row2, restPosition));
    }
    else
    {
        transformed = float3(dot(row0.xyz, position), dot(row1.xyz, position), dot(row2.xyz, position));
        transformed = (transformed * _122.boneScaleAndRestPoseScale.x) + float3(row0.w, row1.w, row2.w);
    }
    if (_122.palette.z != 0u)
    {
        transformed = _122.bodyOriginAndScale.xyz + (transformed * _122.bodyOriginAndScale.w);
    }
    return transformed;
}

static inline __attribute__((always_inline))
float3 transformNormal(thread const float3& normal, thread const int& boneIndex, constant Skinning& _122, const device boneRows& boneRows_1)
