    _output.eyeDepth = abs(_output.pos.w);
    _output.normal = skinnedNormal;
    _output.viewVector = _122.eyePositionAndSpecular.xyz - skinnedPosition;
    _output.lightDirectionAndSpecular = float4(_122.lightDirection.xyz, _122.eyePositionAndSpecular.w);
