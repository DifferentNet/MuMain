        float scale = (mode == 4u) ? 0.5 : 2.5;
        float uScale = (mode == 4u) ? 0.5 : 3.0;
        float lightScale = (mode == 4u) ? 3.0 : 5.0;
        float waveScale = (mode == 4u) ? 3.0 : 1.0;
        return float2((lightDot + (normal.y * uScale)) + (chromeLight.y * lightScale), ((1.0 - lightDot) - (normal.z * scale)) - (chromeWave * waveScale)) + offset;
    }
    if (mode == 6u)
    {
        float coordinate = ((normal.z + normal.x) * 0.800000011920928955078125) + (chromeWave2 * 2.0);
        return float2(coordinate);
    }
    if (mode == 7u)
    {
        float coordinate_1 = ((normal.z + normal.x) * 0.800000011920928955078125) + _122.textureCoordinateParameters.z;
        return float2(coordinate_1);
