+#ifdef SDL_PLATFORM_EMSCRIPTEN
+// MU Moldova web build. A canvas texture is only valid until the browser gets control back, and an
+// application frame may hand control to the browser before it submits (a blocking file read that
+// suspends, for one). So frames are drawn into a backbuffer of the canvas's size and format, and
+// Submit fetches the canvas texture and copies the backbuffer into it, with nothing in between.
+// Returns the backbuffer with a reference for the caller.
+static WGPUTexture WEBGPU_INTERNAL_GetBackbuffer(WebGPURenderer *renderer, WebGPUWindowData *windowData)
+{
+    const WGPUTextureFormat format = SDLToWebGPU_TextureFormat[SwapchainCompositionToSDLFormat(windowData->swapchainComposition, windowData->shouldUseFallbackFormat)];
+    if (windowData->backbuffer == NULL || windowData->backbufferWidth != windowData->surfaceWidth ||
+        windowData->backbufferHeight != windowData->surfaceHeight || windowData->backbufferFormat != format) {
+        if (windowData->backbuffer != NULL) {
+            wgpuTextureRelease(windowData->backbuffer);
+        }
+
+        WGPUTextureDescriptor desc = { 0 };
+        desc.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;
+        desc.dimension = WGPUTextureDimension_2D;
+        desc.size = (WGPUExtent3D){ windowData->surfaceWidth, windowData->surfaceHeight, 1 };
+        desc.format = format;
+        desc.mipLevelCount = 1;
+        desc.sampleCount = 1;
+        windowData->backbuffer = wgpuDeviceCreateTexture(renderer->device, &desc);
+        windowData->backbufferFormat = format;
+        windowData->backbufferWidth = windowData->surfaceWidth;
+        windowData->backbufferHeight = windowData->surfaceHeight;
+    }
+
+    if (windowData->backbuffer != NULL) {
+        wgpuTextureAddRef(windowData->backbuffer);
+    }
+    return windowData->backbuffer;
+}
+
+// Called by Submit: copies a frame's backbuffer into the canvas texture it fetches now. Returns
+// that texture for the caller to release after submitting, or NULL when the canvas has none.
+static WGPUTexture WEBGPU_INTERNAL_CopyBackbufferToCanvas(WebGPUCommandBuffer *cmdBuf, WGPUSurface surface, WebGPUTextureContainer *container)
+{
+    WGPUSurfaceTexture surfaceTexture = { 0 };
+    wgpuSurfaceGetCurrentTexture(surface, &surfaceTexture);
+    if (surfaceTexture.texture == NULL ||
+        (surfaceTexture.status != WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal &&
+         surfaceTexture.status != WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal)) {
+        return NULL;
+    }
+
+    WGPUTexelCopyTextureInfo source = { 0 };
+    source.texture = container->activeTexture->texture;
+    source.aspect = WGPUTextureAspect_All;
+    WGPUTexelCopyTextureInfo destination = { 0 };
+    destination.texture = surfaceTexture.texture;
+    destination.aspect = WGPUTextureAspect_All;
+    const Uint32 width = SDL_min(container->header.info.width, wgpuTextureGetWidth(surfaceTexture.texture));
+    const Uint32 height = SDL_min(container->header.info.height, wgpuTextureGetHeight(surfaceTexture.texture));
+    wgpuCommandEncoderCopyTextureToTexture(cmdBuf->encoder, &source, &destination, &(WGPUExtent3D){ width, height, 1 });
+    return surfaceTexture.texture;
+}
+#endif
