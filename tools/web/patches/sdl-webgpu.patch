+#ifdef SDL_PLATFORM_EMSCRIPTEN
+/**
+ * Give the browser one turn of its event loop, which is where WebGPU completes buffer maps and
+ * submitted work. SDL_DelayNS would go through setTimeout, which browsers stretch to at least 4 ms
+ * after a few nested calls (and to 1 s in background tabs), so a wait for each texture upload added
+ * up to many seconds. A MessageChannel message comes back as the next task, without that clamping.
+ * A wait that lasts longer than 100 ms (a GPU that has fallen behind) goes back to timers, so the page
+ * still gets idle time. Needs JSPI or Asyncify, like SDL_DelayNS's emscripten_sleep.
+ */
+EM_ASYNC_JS(void, WEBGPU_INTERNAL_YieldToBrowser, (void), {
+    if (!Module["sdlWebGPUYield"]) {
+        const channel = new MessageChannel();
+        const waiting = [];
+        channel.port1.onmessage = () => {
+            const resume = waiting.shift();
+            if (resume) {
+                resume();
+            }
+        };
+        let waitStart = 0;
+        let lastResume = -1e9;
+        Module["sdlWebGPUYield"] = async () => {
+            const now = performance.now();
+            if (now - lastResume > 1) {
+                waitStart = now; // a new wait: the previous one ended a while ago
+            }
+            if (now - waitStart < 100) {
+                await new Promise((resolve) => {
+                    waiting.push(resolve);
+                    channel.port2.postMessage(0);
+                });
+            } else {
+                await new Promise((resolve) => setTimeout(resolve, 1));
+            }
+            lastResume = performance.now();
+        };
+    }
+    await Module["sdlWebGPUYield"]();
+});
+#define WEBGPU_INTERNAL_Spin() WEBGPU_INTERNAL_YieldToBrowser()
+#else
 /**
  * Spin for 5000 nanoseconds.
  * This allows Emscripten to catch up with browser events.
  */
 #define WEBGPU_INTERNAL_Spin() SDL_DelayNS(5000)
+#endif
 
